page 1 (
    name: Gallery
    alias: HOME
    title: Website Studio - Gallery
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        functionAndGlobalVariableDeclaration:
            ```javascript-browser
            // Ready-made looks of the Website Studio templates; thumbnails are app files gallery/<id>.jpg (made from the demo website).
            var WS_PRESETS = [{"id":"studio","name":"Studio","tags":"light clean","page":"ws-Accent--tangerine ws-Font--grotesk","r":{},"hash":"#ws=ws-Fx--sticky%20ws-Fx--reveal%20ws-Fx--count%20ws-Fx--top%20ws-Accent--tangerine%20ws-Font--grotesk"},
                {"id":"editorial","name":"Editorial","tags":"light editorial","page":"ws-Design--editorial ws-Accent--wine ws-Font--serif ws-Header--centered","r":{"hero":["ws-Hero--centered"],"services":["ws-Features--rows"],"clients-say":["ws-Quotes--spotlight"]},"hash":"#ws=ws-Fx--sticky%20ws-Fx--reveal%20ws-Fx--count%20ws-Fx--top%20ws-Design--editorial%20ws-Accent--wine%20ws-Font--serif%20ws-Header--centered&r=hero%3Aws-Hero--centered%2Cservices%3Aws-Features--rows%2Cclients-say%3Aws-Quotes--spotlight"},
