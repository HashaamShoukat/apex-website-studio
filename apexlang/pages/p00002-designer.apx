page 2 (
    name: Designer
    alias: DESIGNER
    title: Website Studio - Designer
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        fileUrls: #APP_FILES#website-studio/designer-sites.js
        executeWhenPageLoads:
            ```javascript-browser
            // Designer: every choice is a template option (a CSS class) of Modern One Page or of a Website report or list template.
            // The preview iframe shows a real website page; the classes travel in its URL hash (#ws=<page classes>&r=@<template>:<classes>,...).
            (function ($) {
                var DEF = "ws-Fx--sticky ws-Fx--reveal ws-Fx--count ws-Fx--top".split(" ");
                var SELECTS = [{"item":"P2_DESIGN","group":"Design"},{"item":"P2_ACCENT","group":"Accent Color"},{"item":"P2_SCHEME","group":"Color Scheme"},{"item":"P2_FONT","group":"Typeface"},{"item":"P2_HEADER","group":"Header"},{"item":"P2_CORNERS","group":"Corners"},{"item":"P2_SPACE","group":"Section Spacing"},{"item":"P2_FOOTER","group":"Footer"},{"item":"P2_PH","group":"Placeholder Images"}];
                var SWITCHES = [{"item":"P2_STICKY","css":"ws-Fx--sticky","label":"Sticky Header"},{"item":"P2_REVEAL","css":"ws-Fx--reveal","label":"Reveal on Scroll"},{"item":"P2_COUNT","css":"ws-Fx--count","label":"Count Up Numbers"},{"item":"P2_TOP","css":"ws-Fx--top","label":"Back to Top Button"},{"item":"P2_PROGRESS","css":"ws-Fx--progress","label":"Scroll Progress Bar"},{"item":"P2_THEME","css":"ws-Fx--theme","label":"Light/Dark Toggle"},{"item":"P2_CHAT","css":"ws-Fx--chat","label":"WhatsApp Button"}];
                // [item, label, template, [[option, value]...]]
                var SECTIONS = [["P2_HERO_LAYOUT","Hero - Layout","ws-hero",[["Slider","ws-Hero--slider"],["Split","ws-Hero--split"],["Centered","ws-Hero--centered"],["Full Bleed","ws-Hero--fullbleed"]]],["P2_HERO_HEIGHT","Hero - Height","ws-hero",[["Large","!wsr-hero-height"],["Full Screen","ws-Hero--full"],["Medium","ws-Hero--medium"],["Compact (page title)","ws-Hero--compact"]]],["P2_HERO_OVERLAY","Hero - Image Overlay","ws-hero",[["Normal","!wsr-hero-overlay"],["Light","ws-Hero--light"],["Strong","ws-Hero--strong"]]],["P2_HERO_MOVE","Hero - Transition","ws-hero",[["Fade","!wsr-hero-move"],["Slide","ws-Hero--slide"]]],["P2_HERO_ZOOM","Hero - Slow Zoom","ws-hero",[["On","ws-Hero--zoom"],["Off","-ws-Hero--zoom"]]],["P2_HERO_AUTOPLAY","Hero - Autoplay","ws-hero",[["6 Seconds","!wsr-autoplay"],["4 Seconds","ws-Auto--4"],["9 Seconds","ws-Auto--9"],["Off","ws-Auto--off"]]],["P2_MENU_ALIGN","Menu - Alignment","website-menu",[["Right","!wsm-align"],["Center","ws-Menu--center"],["Left","ws-Menu--left"]]],["P2_MENU_MAX","Menu - Visible Entries","website-menu",[["All","!wsm-max"],["3, then More","ws-Menu--max3"],["4, then More","ws-Menu--max4"],["5, then More","ws-Menu--max5"],["6, then More","ws-Menu--max6"],["7, then More","ws-Menu--max7"]]],["P2_MENU_MOBILE","Menu - On Phones","website-menu",[["Drop-down Panel","!wsm-mobile"],["Full-screen Overlay","ws-Menu--overlay"],["Side Drawer","ws-Menu--drawer"]]],["P2_MENU_CTA","Menu - Last Entry as Button","website-menu",[["On","ws-Menu--cta"],["Off","-ws-Menu--cta"]]],["P2_FEATURES_LAYOUT","Services - Layout","ws-features",[["Cards","!wsr-features-layout"],["Rows","ws-Features--rows"],["Bento","ws-Features--bento"],["Icons Only","ws-Features--icons"]]],["P2_TESTIMONIALS_LAYOUT","Testimonials - Layout","ws-testimonials",[["Carousel","ws-Quotes--carousel"],["Wall","ws-Quotes--wall"],["Spotlight","ws-Quotes--spotlight"]]],["P2_TEAM_LAYOUT","Team - Layout","ws-team",[["Portrait Cards","!wsr-team-layout"],["Round Photos","ws-Team--round"],["Compact List","ws-Team--list"]]],["P2_GALLERY_LAYOUT","Portfolio - Layout","ws-gallery",[["Grid","!wsr-works-layout"],["Editorial","ws-Works--editorial"],["Large","ws-Works--large"]]],["P2_LOGOS_LAYOUT","Logos - Layout","ws-logos",[["Scrolling Marquee","ws-Logos--marquee"],["Grid","ws-Logos--grid"],["Row","ws-Logos--row"]]],["P2_LOGOS_SPEED","Logos - Marquee Speed","ws-logos",[["Normal","!wsr-logos-speed"],["Slow","ws-Speed--slow"],["Fast","ws-Speed--fast"]]],["P2_STEPS_LAYOUT","Process - Layout","ws-steps",[["Connected","ws-Steps--line"],["Cards","ws-Steps--cards"]]],["P2_TIMELINE_LAYOUT","Timeline - Layout","ws-timeline",[["Alternating","ws-Timeline--alternate"],["List","ws-Timeline--list"]]],["P2_NEWS_LAYOUT","News - Layout","ws-news",[["Cards","!wsr-news-layout"],["First Post Large","ws-News--featured"],["List","ws-News--list"]]],["P2_PRODUCTS_LAYOUT","Products - Layout","ws-products",[["Cards","!wsr-products-layout"],["Menu List","ws-Products--menu"],["Compact","ws-Products--compact"]]],["P2_PHOTOS_LAYOUT","Photo Gallery - Layout","ws-photos",[["Grid","!wsr-photos-layout"],["Masonry","ws-Photos--masonry"],["Scrolling Strip","ws-Photos--strip"]]],["P2_EVENTS_LAYOUT","Events - Layout","ws-events",[["Agenda","!wsr-events-layout"],["Cards","ws-Events--cards"]]],["P2_HOURS_LAYOUT","Opening Hours - Layout","ws-hours",[["Table","!wsr-hours-layout"],["Cards","ws-Hours--cards"]]]];
                var PRESET = {"ws-hero":["ws-Hero--zoom"],"ws-stats":[],"ws-features":[],"ws-team":[],"ws-testimonials":[],"ws-logos":[],"ws-pricing":["ws-Plans--lift"],"ws-timeline":[],"ws-steps":[],"ws-faq":[],"ws-jobs":["ws-Filter"],"ws-gallery":["ws-Filter"],"ws-links":[],"ws-contact":[],"ws-news":[],"ws-products":["ws-Filter"],"ws-photos":[],"ws-zigzag":[],"ws-events":[],"ws-hours":[],"ws-compare":[],"ws-video":[],"ws-map":[]}, TPL_NAME = {"ws-hero":"Website - Hero","ws-stats":"Website - Numbers","ws-features":"Website - Services","ws-team":"Website - Team","ws-testimonials":"Website - Testimonials","ws-logos":"Website - Logos","ws-pricing":"Website - Pricing","ws-timeline":"Website - Timeline","ws-steps":"Website - Process","ws-faq":"Website - FAQ","ws-jobs":"Website - Careers","ws-gallery":"Website - Portfolio","ws-links":"Website - Links","ws-contact":"Website - Contact Details","ws-news":"Website - News","ws-products":"Website - Products","ws-photos":"Website - Photo Gallery","ws-zigzag":"Website - Image and Text","ws-events":"Website - Events","ws-hours":"Website - Opening Hours","ws-compare":"Website - Comparison","ws-video":"Website - Video","ws-map":"Website - Map","website-menu":"Website - Menu"};
                var SITES = window.WSD_SITES;   // static file website-studio/designer-sites.js
                var frame = document.getElementById("wsd-frame"), app = frame.getAttribute("data-app"), ses = frame.getAttribute("data-session"), lastSrc = null;
                function esc(s) { return apex.util.escapeHTML(String(s)); }
                function siteUrl() { return app + ($v("P2_SITE") || "WEBSITE") + ses; }

                // page options of a look: every select and switch follows the list of classes
                function setPage(cls) {
                    SELECTS.forEach(function (s) {
                        var hit = $("#" + s.item + " option").filter(function () { return this.value && cls.indexOf(this.value) >= 0; }).first();
                        apex.item(s.item).setValue(hit.length ? hit.val() : "", null, true);
                    });
                    SWITCHES.forEach(function (s) { apex.item(s.item).setValue(DEF.indexOf(s.css) >= 0 || cls.indexOf(s.css) >= 0 ? "Y" : "N", null, true); });
                }
                function setSections(rs) {
                    SECTIONS.forEach(function (s) {
                        var mine = rs["@" + s[2]] || [], hit = s[3].filter(function (o) { return mine.indexOf(o[1]) >= 0; })[0];
                        apex.item(s[0]).setValue(hit ? hit[1] : "", null, true);
                    });
                }
                // from the Gallery: #site=<page alias>&look=<page classes>&r=@<template>:<classes>,...
                (function fromHash() {
                    var h = location.hash, g = function (k) { var m = new RegExp("[#&]" + k + "=([^&]*)").exec(h); return m ? decodeURIComponent(m[1]) : null; };
                    if (g("site") && SITES[g("site")]) { apex.item("P2_SITE").setValue(g("site"), null, true); }
                    var look = g("look"), rs = {};
                    (g("r") || "").split(",").forEach(function (p) { var i = p.indexOf(":"); if (i > 0) { rs[p.slice(0, i)] = p.slice(i + 1).split(/[\s+]+/); } });
                    setPage((look !== null ? look : SITES[$v("P2_SITE") || "WEBSITE"].look).split(/[\s+]+/));
                    setSections(rs);
                })();
                $("#P2_SITE").on("change", function () { setPage(SITES[$v("P2_SITE")].look.split(/\s+/)); setSections({}); sqlPanel(); render(); });

                function chosen() {
                    var page = [], rows = [], extra = [], allDefaults = true, tpl = {}, changed = [];
                    SELECTS.forEach(function (s) {
                        var v = $v(s.item), text = $("#" + s.item + " option:selected").text();
                        if (v) { page.push(v); extra.push(v); }
                        rows.push({ group: s.group, option: text, isDefault: !v });
                    });
                    SWITCHES.forEach(function (s) {
                        var on = $v(s.item) === "Y", isDef = DEF.indexOf(s.css) >= 0;
                        if (on) { page.push(s.css); }
                        if (isDef && !on) { allDefaults = false; }
                        if (on && !isDef) { extra.push(s.css); }
                        rows.push({ group: s.label, option: on ? "On" : "Off", isDefault: on === isDef });
                    });
                    SECTIONS.forEach(function (s) {
                        var v = $v(s[0]);
                        if (!v) { return; }
                        (tpl[s[2]] = tpl[s[2]] || []).push(v);
                        changed.push({ tpl: s[2], label: s[1], option: $("#" + s[0] + " option:selected").text(), cls: v });
                    });
                    return { page: page, rows: rows, snippet: allDefaults ? ["#DEFAULT#"].concat(extra) : page, tpl: tpl, changed: changed,
                             regions: Object.keys(tpl).map(function (k) { return "@" + k + ":" + tpl[k].join("+"); }).join(",") };
                }
                function arr(list, n) {
                    var pad = new Array(n + 1).join(" ");
                    return list.length === 1 ? " " + list[0] + "\n" : " [\n" + list.map(function (x) { return pad + "    " + x + "\n"; }).join("") + pad + "]\n";
                }
                function relevance() {
                    var dark = /midnight|techgrid/.test($v("P2_DESIGN"));
                    $("#P2_SCHEME_CONTAINER").toggleClass("wsd-Off", dark).attr("data-why", dark ? "Midnight and Tech Grid are always dark" : null);
                }
                function render() {
                    var c = chosen(), hash = "#ws=" + encodeURIComponent(c.page.join(" ")) + (c.regions ? "&r=" + encodeURIComponent(c.regions) : ""), src = siteUrl();
                    relevance();
                    // section options and another site need a fresh page; page options follow the hash without a reload
                    if (src + c.regions !== lastSrc || !frame.getAttribute("src")) { frame.setAttribute("src", src + hash); }
                    else { try { frame.contentWindow.location.hash = hash; } catch (e) { frame.setAttribute("src", src + hash); } }
                    lastSrc = src + c.regions;
                    $("#wsd-summary").html('<p class="wsd-H">Modern One Page</p><dl class="wsd-List">' + c.rows.map(function (r) {
                        return "<dt>" + esc(r.group) + "</dt><dd" + (r.isDefault ? ' class="is-default"' : "") + ">" + esc(r.option) + "</dd>";
                    }).join("") + "</dl>" + (c.changed.length ? '<p class="wsd-H">Sections</p><dl class="wsd-List">' + c.changed.map(function (r) {
                        return "<dt>" + esc(r.label) + "</dt><dd>" + esc(r.option) + "</dd>";
                    }).join("") + "</dl>" : ""));
                    var code = "appearance {\n    pageTemplate: @modern-one-page\n    templateOptions:" + arr(c.snippet, 4) + "}";
                    Object.keys(c.tpl).forEach(function (t) {
                        var on = (PRESET[t] || []).concat(c.tpl[t].filter(function (x) { return /^ws-/.test(x); })), off = c.tpl[t].filter(function (x) { return x.charAt(0) === "-"; }).map(function (x) { return x.slice(1); });
                        on = on.filter(function (x, i) { return off.indexOf(x) < 0 && on.indexOf(x) === i; });
                        code += "\n\n// every region with " + TPL_NAME[t] + "\ncomponentAppearance {\n" + (t === "website-menu" ? "    listTemplate: @website-menu\n" : "    templateType: theme\n    template: @" + t + "\n") +
                            "    templateOptions:" + arr(["#DEFAULT#"].concat(on), 4) + "}";
                    });
                    $("#wsd-code").text(code);
                }
                // the SQL of the sections with pictures on the chosen site
                function sqlPanel() {
                    var list = SITES[$v("P2_SITE") || "WEBSITE"].sql, sel = $("#wsd-sqlpick");
                    sel.html(list.map(function (x, i) { return '<option value="' + i + '">' + esc(x.name) + "</option>"; }).join(""));
                    showSql();
                }
                function showSql() { var x = SITES[$v("P2_SITE") || "WEBSITE"].sql[+$("#wsd-sqlpick").val() || 0]; $("#wsd-sql").text(x ? x.sql : ""); }
                $(document).on("change", "#wsd-sqlpick", showSql);

                $(SELECTS.concat(SWITCHES).map(function (s) { return "#" + s.item; }).concat(SECTIONS.map(function (s) { return "#" + s[0]; })).join(",")).on("change", render);
                // Desktop: the page is laid out at 1280px and scaled down to fit the preview
                function fit() {
                    var stage = document.getElementById("wsd-stage"), desk = $v("P2_DEVICE") === "DESKTOP", s = Math.min(1, stage.clientWidth / 1280);
                    stage.setAttribute("data-device", $v("P2_DEVICE"));
                    frame.style.width = desk ? "1280px" : "";
                    frame.style.height = desk ? (stage.clientHeight / s) + "px" : "";
                    frame.style.transform = desk && s < 1 ? "scale(" + s + ")" : "";
                }
                $("#P2_DEVICE").on("change", fit);
                $(window).on("resize apexwindowresized", fit);
                fit();
                function copy(text) { navigator.clipboard.writeText(text).then(function () { apex.message.showPageSuccess("Copied."); }); }
                $(document).on("click", ".js-wsd-copy", function () { copy($("#wsd-code").text()); });
                $(document).on("click", ".js-wsd-copysql", function () { copy($("#wsd-sql").text()); });
                $(document).on("click", ".js-wsd-open", function () { window.open(frame.getAttribute("src"), "_blank"); });
                sqlPanel();
                render();
            })(apex.jQuery);
            ```
    }
    css {
        inline:
            ```css
            .wsd-Stage { position: relative; display: flex; justify-content: center; align-items: center; height: min(80vh, 780px); min-height: 520px; overflow: hidden; border-radius: 12px;
                         border: 1px solid var(--ut-component-border-color, #ddd); background: repeating-conic-gradient(rgba(0,0,0,.035) 0 25%, transparent 0 50%) 0 0 / 24px 24px; }
            .wsd-Stage iframe { display: block; width: 100%; height: 100%; border: 0; background: #fff; transition: width .3s ease, border-radius .3s ease; }
            .wsd-Stage[data-device="DESKTOP"] { display: block; }
            .wsd-Stage[data-device="DESKTOP"] iframe { transform-origin: 0 0; transition: none; }
            .wsd-Stage[data-device="TABLET"], .wsd-Stage[data-device="PHONE"] { padding: 16px 0; }
            .wsd-Stage[data-device="TABLET"] iframe { width: 820px; max-width: calc(100% - 32px); border-radius: 20px; box-shadow: 0 0 0 12px #1f2329, 0 24px 48px -12px rgba(0,0,0,.45); }
            .wsd-Stage[data-device="PHONE"] iframe { width: 390px; max-width: calc(100% - 32px); border-radius: 28px; box-shadow: 0 0 0 10px #1f2329, 0 24px 48px -12px rgba(0,0,0,.45); }
            .wsd-List { display: grid; grid-template-columns: auto 1fr; gap: .375rem 1rem; margin: 0 0 1rem; font-size: .875rem; }
            .wsd-List dt { opacity: .75; }
            .wsd-List dd { margin: 0; font-weight: 600; }
            .wsd-List dd.is-default::after { content: " (default)"; font-weight: 400; opacity: .7; }
            .wsd-Code { margin: 0 0 1rem; padding: .875rem 1rem; overflow-x: auto; border-radius: 8px; background: #1f2329; color: #e6edf3; font-size: .8125rem; line-height: 1.5; white-space: pre-wrap; }
            .wsd-Where { margin: 0 0 .75rem; padding: .625rem .875rem; border-radius: 8px; background: rgba(234,88,12,.08); font-size: .8125rem; line-height: 1.5; }
            .wsd-H { display: block; margin: 1rem 0 .5rem; font-size: .875rem; font-weight: 700; }
            .wsd-Pick { width: 100%; max-width: 32rem; margin-bottom: .75rem; }
            .wsd-Off { opacity: .6; }
            .wsd-Off[data-why]::after { content: attr(data-why); display: block; padding: 0 .75rem .25rem; font-size: .75rem; font-style: italic; }
            @media (max-width: 640px) { .wsd-Stage { height: 72vh; min-height: 460px; } }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Designer
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region options (
        name: Template Options
        type: staticContent
        layout {
            sequence: 20
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region sections (
        name: Section Options
        type: staticContent
        layout {
            sequence: 5
            parentRegion: @options
            slot: subRegions
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h3
            ]
        }
    )

    region preview (
        name: Live Preview
        type: staticContent
        source {
            htmlCode: <div class="wsd-Stage" id="wsd-stage" data-device="DESKTOP"><iframe id="wsd-frame" title="Website preview" data-app="f?p=&APP_ID.:" data-session=":&APP_SESSION."></iframe></div>
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
    )

    region summary (
        name: Your Choice
        type: staticContent
        source {
            htmlCode:
                ```html
                <p class="wsd-Where">Page Designer: select your one page, <strong>Appearance &gt; Page Template</strong> = <strong>Modern One Page</strong>, then tick the <strong>Template Options</strong> listed below. Section Options act on every region with that template: select the region, <strong>Attributes &gt; Appearance &gt; Template Options</strong> (for the menu: the List region's Template Options). Or paste the APEXlang into the page file.</p>
                <div id="wsd-summary"></div>
                <p class="wsd-H">APEXlang (page file)</p>
                <pre class="wsd-Code" id="wsd-code"></pre>
                <button type="button" class="t-Button t-Button--small t-Button--iconLeft js-wsd-copy"><span class="t-Icon fa fa-copy" aria-hidden="true"></span><span class="t-Button-label">Copy APEXlang</span></button>
                ```
        }
        layout {
            sequence: 10
            parentRegion: @options
            slot: subRegions
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h3
            ]
        }
    )

    pageItem P2_SITE (
        type: selectList
        label {
            label: Website
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Design Studio;WEBSITE,Company;COMPANY,Restaurant;RESTAURANT,Clinic (Arabic RTL);CLINIC,Real Estate;REAL-ESTATE,Conference;CONFERENCE,Portfolio;PORTFOLIO,SaaS Product;SAAS,Company - multi-page;MERIDIAN,Restaurant - multi-page;LUME,Real Estate - multi-page;HARBOR,Clinic (Arabic RTL) - multi-page;SHIFA
            displayNullValue: false
        }
        layout {
            sequence: 1
            region: @options
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: WEBSITE
        }
        sessionState {
            storage: request
        }
    )

    pageItem P2_DESIGN (
        type: selectList
        label {
            label: Design
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Editorial;ws-Design--editorial,Bold;ws-Design--bold,Soft UI;ws-Design--soft,Glass;ws-Design--glass,Midnight;ws-Design--midnight,Minimal;ws-Design--minimal,Corporate;ws-Design--corporate,Startup / SaaS;ws-Design--saas,Elegant / Luxury;ws-Design--luxury,Playful;ws-Design--playful,Organic / Nature;ws-Design--organic,Tech Grid;ws-Design--techgrid,Swiss;ws-Design--swiss,Retro Print;ws-Design--retro
            nullDisplayValue: Clean
        }
        layout {
            sequence: 6
            region: @options
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        sessionState {
            storage: request
        }
    )

    pageItem P2_ACCENT (
        type: selectList
        label {
            label: Accent Color
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Ocean;ws-Accent--ocean,Indigo;ws-Accent--indigo,Violet;ws-Accent--violet,Emerald;ws-Accent--emerald,Rose;ws-Accent--rose,Amber;ws-Accent--amber,Slate;ws-Accent--slate,Wine;ws-Accent--wine,Tangerine;ws-Accent--tangerine,Cyan;ws-Accent--cyan
            nullDisplayValue: Theme Color
        }
        layout {
            sequence: 11
            region: @options
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        sessionState {
            storage: request
        }
    )

    pageItem P2_SCHEME (
        type: selectList
        label {
            label: Color Scheme
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Dark;ws-Scheme--dark,Follow Device Setting;ws-Scheme--auto
            nullDisplayValue: Light
        }
        layout {
            sequence: 16
            region: @options
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        sessionState {
            storage: request
        }
    )

    pageItem P2_FONT (
        type: selectList
        label {
            label: Typeface
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Grotesk;ws-Font--grotesk,Serif;ws-Font--serif,Luxe;ws-Font--luxe,Tech;ws-Font--tech,Poster;ws-Font--poster,Friendly;ws-Font--friendly,Arabic;ws-Font--arabic
            nullDisplayValue: System
        }
        layout {
            sequence: 21
            region: @options
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        sessionState {
            storage: request
        }
    )

    pageItem P2_HEADER (
        type: selectList
        label {
            label: Header
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Centered Logo;ws-Header--centered,Floating Pill;ws-Header--pill,Transparent over Hero;ws-Header--transparent
            nullDisplayValue: Classic
        }
        layout {
            sequence: 26
            region: @options
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
