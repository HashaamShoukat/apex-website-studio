A chocolate dessert' as image_alt,\n       6 as sort_order\n  from dual\norder by sort_order"}]},"CLINIC":{"look":"ws-Accent--emerald ws-Font--arabic ws-Corners--round ws-Fx--chat ws-Fx--theme","name":"Clinic (Arabic, RTL)","page":13,"sql":[{"id":"hero","name":"عيادات الشفاء (Website - Hero)","sql":"select 'رعاية طبية *قريبة* منك ومن عائلتك.' as title,\n       'عيادات الشفاء - الرياض' as subtitle,\n       'أطباء استشاريون، مختبر حديث، ومواعيد في نفس اليوم.' as text,\n       'احجز موعدا' as button_label,\n       '#contact' as button_link,\n       'خدماتنا' as button2_label,\n       '#services' as button2_link,\n       'website-studio/img/clinic-hero.jpg' as image_file,\n       'طبيب يتحدث مع مريض' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'مختبر *دقيق* ونتائج سريعة.' as title,\n       'المختبر' as subtitle,\n       'معظم النتائج جاهزة خلال ٢٤ ساعة وتصلك على جوالك.' as text,\n       'اعرف المزيد' as button_label,\n       '#about' as button_link,\n       null as button2_label,\n       null as button2_link,\n       'website-studio/img/clinic-lab.jpg' as image_file,\n       'مختبر بأجهزة حديثة' as image_alt,\n       2 as sort_order\n  from dual\norder by sort_order"},{"id":"about","name":"من نحن (Website - Image and Text)","sql":"select 'من نحن' as eyebrow,\n       'رعاية *إنسانية* قبل كل شيء.' as title,\n       'منذ عام ٢٠١٢ نخدم أحياء شمال الرياض بفريق يضع راحة المريض أولا، ويشرح كل خطوة بوضوح.' as text,\n       '#doctors' as link,\n       'تعرف على الأطباء' as link_label,\n       'website-studio/img/clinic-room.jpg' as image_file,\n       'غرفة كشف مضيئة' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'التقنية' as eyebrow,\n       'ملفك الطبي معك أينما كنت.' as title,\n       'احجز موعدك، واطلع على نتائجك ووصفاتك من جوالك في أي وقت.' as text,\n       null as link,\n       null as link_label,\n       'website-studio/img/clinic-lab.jpg' as image_file,\n       'مختبر بأجهزة حديثة' as image_alt,\n       2 as sort_order\n  from dual\norder by sort_order"},{"id":"doctors","name":"الأطباء (Website - Team)","sql":"select 'د. نورة القحطاني' as name,\n       'استشارية طب الأسرة' as role,\n       'website-studio/img/doctor-1.jpg' as image_file,\n       'د. نورة القحطاني' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'د. أحمد السبيعي' as name,\n       'استشاري طب الأطفال' as role,\n       'website-studio/img/doctor-2.jpg' as image_file,\n       'د. أحمد السبيعي' as image_alt,\n       2 as sort_order\n  from dual\nunion all\nselect 'د. ريم العتيبي' as name,\n       'أخصائية طب الأسنان' as role,\n       'website-studio/img/doctor-3.jpg' as image_file,\n       'د. ريم العتيبي' as image_alt,\n       3 as sort_order\n  from dual\norder by sort_order"}]},"REAL-ESTATE":{"look":"ws-Design--luxury ws-Accent--amber ws-Font--luxe ws-Header--transparent","name":"Real Estate","page":14,"sql":[{"id":"hero","name":"Harbor & Stone (Website - Hero)","sql":"select 'Find a home you will *love* coming back to.' as title,\n       'Homes for sale and rent' as subtitle,\n       'Hand-picked houses and apartments, and agents who know every street.' as text,\n       'Browse homes' as button_label,\n       '#homes' as button_link,\n       'Book a valuation' as button2_label,\n       '#contact' as button2_link,\n       'website-studio/img/home-hero-1.jpg' as image_file,\n       'A modern house with large windows' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'Selling? We will get you *more*.' as title,\n       'Valuations' as subtitle,\n       'Our homes sell for 4% above asking on average.' as text,\n       'Free valuation' as button_label,\n       '#contact' as button_link,\n       null as button2_label,\n       null as button2_link,\n       'website-studio/img/home-hero-2.jpg' as image_file,\n       'A white villa at dusk' as image_alt,\n       2 as sort_order\n  from dual\norder by sort_order"},{"id":"homes","name":"Homes (Website - Products)","sql":"select 'Garden house, Al Nakheel' as name,\n       '4 bedrooms - 3 bathrooms - 410 m2' as text,\n       'SAR 3,950,000' as price,\n       'For sale' as category,\n       'New' as badge,\n       'website-studio/img/home-1.jpg' as image_file,\n       'A family house with a garden' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'Bright apartment, Olaya' as name,\n       '2 bedrooms - 2 bathrooms - 140 m2' as text,\n       'SAR 9,500 / month' as price,\n       'For rent' as category,\n       null as badge,\n       'website-studio/img/home-2.jpg' as image_file,\n       'A bright living room' as image_alt,\n       2 as sort_order\n  from dual\nunion all\nselect 'Penthouse with a view' as name,\n       '3 bedrooms - roof terrace - 220 m2' as text,\n       'SAR 4,600,000' as price,\n       'For sale' as category,\n       null as badge,\n       'website-studio/img/home-3.jpg' as image_file,\n       'An apartment with a view' as image_alt,\n       3 as sort_order\n  from dual\nunion all\nselect 'Family villa, Hittin' as name,\n       '5 bedrooms - kitchen garden - 520 m2' as text,\n       'SAR 6,200,000' as price,\n       'New developments' as category,\n       'Off plan' as badge,\n       'website-studio/img/home-4.jpg' as image_file,\n       'A modern kitchen' as image_alt,\n       4 as sort_order\n  from dual\nunion all\nselect 'Villa with pool' as name,\n       '6 bedrooms - pool - 680 m2' as text,\n       'SAR 28,000 / month' as price,\n       'For rent' as category,\n       null as badge,\n       'website-studio/img/home-5.jpg' as image_file,\n       'A house with a pool' as image_alt,\n       5 as sort_order\n  from dual\nunion all\nselect 'Townhouse, Diplomatic Quarter' as name,\n       '3 bedrooms - courtyard - 260 m2' as text,\n       'SAR 2,850,000' as price,\n       'For sale' as category,\n       null as badge,\n       'website-studio/img/home-6.jpg' as image_file,\n       'A townhouse street' as image_alt,\n       6 as sort_order\n  from dual\norder by sort_order"},{"id":"services","name":"Services (Website - Image and Text)","sql":"select 'Buying' as eyebrow,\n       'We find it before it is *listed*.' as title,\n       'Tell us what you want and we call you first when a home matches, often before it reaches the portals.' as text,\n       '#contact' as link,\n       'Register your search' as link_label,\n       'website-studio/img/home-2.jpg' as image_file,\n       'A bright living room' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'Selling' as eyebrow,\n       'Photography, staging and a *fair* fee.' as title,\n       'Professional photos, a floor plan and a video tour for every home. One fixed fee, paid only when you sell.' as text,\n       '#contact' as link,\n       'Book a valuation' as link_label,\n       'website-studio/img/home-4.jpg' as image_file,\n       'A modern kitchen' as image_alt,\n       2 as sort_order\n  from dual\nunion all\nselect 'Renting' as eyebrow,\n       'Property management without the *worry*.' as title,\n       'Tenant checks, rent collection and repairs handled by a team you can call.' as text,\n       null as link,\n       null as link_label,\n       'website-studio/img/home-6.jpg' as image_file,\n       'A townhouse street' as image_alt,\n       3 as sort_order\n  from dual\norder by sort_order"},{"id":"agents","name":"Agents (Website - Team)","sql":"select 'Hessa Al-Rashid' as name,\n       'Founder and Director' as role,\n       'https://www.linkedin.com/' as link,\n       'website-studio/img/person-5.jpg' as image_file,\n       'Portrait of a woman in an office' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'Yousef Karim' as name,\n       'Sales' as role,\n       'https://www.linkedin.com/' as link,\n       'website-studio/img/person-4.jpg' as image_file,\n       'Portrait of a man with a beard' as image_alt,\n       2 as sort_order\n  from dual\nunion all\nselect 'Clara Martins' as name,\n       'Lettings' as role,\n       'https://www.linkedin.com/' as link,\n       'website-studio/img/person-1.jpg' as image_file,\n       'Portrait of a woman smiling' as image_alt,\n       3 as sort_order\n  from dual\nunion all\nselect 'Majed Saleh' as name,\n       'Property management' as role,\n       'https://www.linkedin.com/' as link,\n       'website-studio/img/person-6.jpg' as image_file,\n       'Portrait of a man in a suit' as image_alt,\n       4 as sort_order\n  from dual\norder by sort_order"},{"id":"reviews","name":"Reviews (Website - Testimonials)","sql":"select 'Sold in eleven days, above asking. Hessa handled everything while we were abroad.' as quote,\n       'The Al-Fahad family' as name,\n       'Sold a villa in Hittin' as role,\n       '5' as rating,\n       'website-studio/img/person-2.jpg' as image_file,\n       'Portrait of a man in a shirt' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'They found us an apartment that was never even advertised. Honest and quick.' as quote,\n       'Emma and Tariq' as name,\n       'Bought in Olaya' as role,\n       '5' as rating,\n       'website-studio/img/person-3.jpg' as image_file,\n       'Portrait of a woman with curly hair' as image_alt,\n       2 as sort_order\n  from dual\norder by sort_order"}]},"CONFERENCE":{"look":"ws-Design--techgrid ws-Accent--cyan ws-Font--tech ws-Header--pill","name":"Conference","page":15,"sql":[{"id":"hero","name":"Northwind Data Summit (Website - Hero)","sql":"select 'Where data people *meet*.' as title,\n       '9 - 10 March 2027 - Riyadh' as subtitle,\n       'Two days, 40 speakers and 1,200 engineers, analysts and leaders.' as text,\n       'Get tickets' as button_label,\n       '#tickets' as button_link,\n       'See the programme' as button2_label,\n       '#agenda' as button2_link,\n       'website-studio/img/event-hero-1.jpg' as image_file,\n       'A speaker on stage in front of an audience' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'Workshops you can *use* on Monday.' as title,\n       'Hands-on' as subtitle,\n       'Twelve half-day workshops, limited to 30 seats each.' as text,\n       'View workshops' as button_label,\n       '#agenda' as button_link,\n       null as button2_label,\n       null as button2_link,\n       'website-studio/img/event-hero-2.jpg' as image_file,\n       'A conference audience' as image_alt,\n       2 as sort_order\n  from dual\norder by sort_order"},{"id":"speakers","name":"Speakers (Website - Team)","sql":"select 'Rana Aziz' as name,\n       'Chief Data Officer, Atlas Bank' as role,\n       'website-studio/img/person-5.jpg' as image_file,\n       'Portrait of a woman in an office' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'Tom Becker' as name,\n       'Principal Engineer, Orbital' as role,\n       'website-studio/img/person-4.jpg' as image_file,\n       'Portrait of a man with a beard' as image_alt,\n       2 as sort_order\n  from dual\nunion all\nselect 'Lina Park' as name,\n       'AI Lead, Fieldnote' as role,\n       'website-studio/img/person-3.jpg' as image_file,\n       'Portrait of a woman with curly hair' as image_alt,\n       3 as sort_order\n  from dual\nunion all\nselect 'Faisal Al-Mutairi' as name,\n       'Director of AI, Digital Government' as role,\n       'website-studio/img/person-6.jpg' as image_file,\n       'Portrait of a man in a suit' as image_alt,\n       4 as sort_order\n  from dual\nunion all\nselect 'Aisha Rahman' as name,\n       'VP Analytics, Northgrid' as role,\n       'website-studio/img/person-1.jpg' as image_file,\n       'Portrait of a woman smiling' as image_alt,\n       5 as sort_order\n  from dual\nunion all\nselect 'Marco Rossi' as name,\n       'Data Quality Lead, Kestrel' as role,\n       'website-studio/img/person-2.jpg' as image_file,\n       'Portrait of a man in a shirt' as image_alt,\n       6 as sort_order\n  from dual\norder by sort_order"},{"id":"video","name":"Highlights from 2026 (Website - Video)","sql":"select 'https://www.youtube.com/watch?v=aqz-KE-bpKQ' as video_url,\n       'Northwind Data Summit 2026 in three minutes' as title,\n       'website-studio/img/event-hero-2.jpg' as image_file,\n       'A conference audience' as image_alt,\n       1 as sort_order\n  from dual\norder by sort_order"},{"id":"venue","name":"Venue (Website - Image and Text)","sql":"select 'Venue' as eyebrow,\n       'Riyadh Front *Exhibition* Centre' as title,\n       'Ten minutes from the airport, with hotels and a metro station next door. Prayer rooms, a family room and step-free access throughout.' as text,\n       '#map' as link,\n       'Map and directions' as link_label,\n       'website-studio/img/event-venue.jpg' as image_file,\n       'The conference hall' as image_alt,\n       1 as sort_order\n  from dual\norder by sort_order"}]},"PORTFOLIO":{"look":"ws-Design--swiss ws-Accent--rose ws-Font--grotesk","name":"Portfolio","page":16,"sql":[{"id":"hero","name":"Lina Haddad (Website - Hero)","sql":"select 'I design products people *enjoy* using.' as title,\n       'Product and brand designer - Jeddah' as subtitle,\n       'Ten years of apps, identities and websites for startups and banks.' as text,\n       'Selected work' as button_label,\n       '#work' as button_link,\n       'Hire me' as button2_label,\n       '#contact' as button2_link,\n       'website-studio/img/portfolio-hero.jpg' as image_file,\n       'A designer''s desk with sketches' as image_alt,\n       1 as sort_order\n  from dual\norder by sort_order"},{"id":"work","name":"Work (Website - Portfolio)","sql":"select 'Kestrel Coffee' as title,\n       'Branding' as category,\n       'Identity and packaging - 2025' as meta,\n       'website-studio/img/work-4.jpg' as image_file,\n       'Coffee packaging' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'Lumen Bank app' as title,\n       'Product' as category,\n       'Mobile banking - 2025' as meta,\n       'website-studio/img/work-3.jpg' as image_file,\n       'A mobile app on a phone' as image_alt,\n       2 as sort_order\n  from dual\nunion all\nselect 'Orbital website' as title,\n       'Web' as category,\n       'Marketing site - 2024' as meta,\n       'website-studio/img/work-2.jpg' as image_file,\n       'A website design on a laptop' as image_alt,\n       3 as sort_order\n  from dual\nunion all\nselect 'Northgrid dashboard' as title,\n       'Product' as category,\n       'Data product - 2024' as meta,\n       'website-studio/img/work-5.jpg' as image_file,\n       'A product dashboard on a large screen' as image_alt,\n       4 as sort_order\n  from dual\nunion all\nselect 'Vantage Hotels' as title,\n       'Branding' as category,\n       'Identity - 2023' as meta,\n       'website-studio/img/work-6.jpg' as image_file,\n       'A hotel lobby with the new signage' as image_alt,\n       5 as sort_order\n  from dual\nunion all\nselect 'Fieldnote' as title,\n       'Web' as category,\n       'Website and brand - 2023' as meta,\n       'website-studio/img/work-1.jpg' as image_file,\n       'Brand identity on business cards and paper' as image_alt,\n       6 as sort_order\n  from dual\norder by sort_order"},{"id":"clients-say","name":"Kind words (Website - Testimonials)","sql":"select 'Lina turned a messy brief into an app our customers love. Ratings went from 3.1 to 4.7.' as quote,\n       'Daniel Brook' as name,\n       'Head of Digital, Lumen Bank' as role,\n       '5' as rating,\n       'website-studio/img/person-2.jpg' as image_file,\n       'Portrait of a man in a shirt' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'Thoughtful, fast and a joy to work with.' as quote,\n       'Priya Nair' as name,\n       'Founder, Fieldnote' as role,\n       '5' as rating,\n       'website-studio/img/person-3.jpg' as image_file,\n       'Portrait of a woman with curly hair' as image_alt,\n       2 as sort_order\n  from dual\norder by sort_order"}]},"SAAS":{"look":"ws-Design--saas ws-Accent--violet ws-Font--friendly ws-Header--pill ws-Fx--theme","name":"SaaS Product","page":17,"sql":[{"id":"hero","name":"Ledgerline (Website - Hero)","sql":"select 'Invoices out. Money *in*. Books done.' as title,\n       'For small businesses' as subtitle,\n       'Ledgerline sends your invoices, chases late payers and keeps your books ready for VAT.' as text,\n       'Start free for 30 days' as button_label,\n       '#contact' as button_link,\n       'See pricing' as button2_label,\n       '#pricing' as button2_link,\n       'website-studio/img/saas-hero.jpg' as image_file,\n       'A finance dashboard on a laptop' as image_alt,\n       1 as sort_order\n  from dual\norder by sort_order"},{"id":"how","name":"How it works (Website - Image and Text)","sql":"select 'Get paid' as eyebrow,\n       'Send an invoice from your *phone*.' as title,\n       'Customers pay by card, Apple Pay or bank transfer. You see it the moment they do.' as text,\n       'website-studio/img/saas-1.jpg' as image_file,\n       'A person reviewing invoices on a tablet' as image_alt,\n       null as link,\n       null as link_label,\n       1 as sort_order\n  from dual\nunion all\nselect 'Stay ready' as eyebrow,\n       'Books that are always *up to date*.' as title,\n       'Every payment and expense lands in the right place, so VAT returns take minutes.' as text,\n       'website-studio/img/saas-2.jpg' as image_file,\n       'A small business owner at a laptop' as image_alt,\n       '#features' as link,\n       'All features' as link_label,\n       2 as sort_order\n  from dual\norder by sort_order"},{"id":"customers","name":"Customers (Website - Testimonials)","sql":"select 'I used to spend Sunday nights on invoices. Now it takes ten minutes on Monday.' as quote,\n       'Noura Al-Saud' as name,\n       'Owner, Bloom Florist' as role,\n       '5' as rating,\n       'website-studio/img/person-1.jpg' as image_file,\n       'Portrait of a woman smiling' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'Our customers pay a week earlier since we switched. That changed our cash flow.' as quote,\n       'Chris Evans' as name,\n       'Director, Kestrel Coffee' as role,\n       '5' as rating,\n       'website-studio/img/person-4.jpg' as image_file,\n       'Portrait of a man with a beard' as image_alt,\n       2 as sort_order\n  from dual\nunion all\nselect 'My accountant loves it, which says a lot.' as quote,\n       'Hamad Q.' as name,\n       'Freelance architect' as role,\n       '5' as rating,\n       'website-studio/img/person-6.jpg' as image_file,\n       'Portrait of a man in a suit' as image_alt,\n       3 as sort_order\n  from dual\norder by sort_order"}]}};
                var frame = document.getElementById("wsd-frame"), app = frame.getAttribute("data-app"), ses = frame.getAttribute("data-session"), lastSrc = null;
                function esc(s) { return apex.util.escapeHTML(String(s)); }
                function siteUrl() { return app + ($v("P2_SITE") || "WEBSITE") + ses; }

                // page options of a look: every select and switch follows the list of classes
                function setPage(cls) {
                    SELECTS.forEach(function (s) {
                        var hit = $("#" + s.item + " option").filter(function () { return this.value && cls.indexOf(this.value) >= 0; }).first();
                        apex.item(s.item).setValue(hit.length ? hit.val() : "", null, true);
                    });
                    SWITCHES.forEach(function (s) { apex.item(s.item).setValue(DEF.indexOf(s.css) >= 0 || cls.indexOf(s.css) >= 0 ? "Y" : "N", null, true); });
                }
                function setSections(rs) {
                    SECTIONS.forEach(function (s) {
                        var mine = rs["@" + s[2]] || [], hit = s[3].filter(function (o) { return mine.indexOf(o[1]) >= 0; })[0];
                        apex.item(s[0]).setValue(hit ? hit[1] : "", null, true);
                    });
                }
                // from the Gallery: #site=<page alias>&look=<page classes>&r=@<template>:<classes>,...
                (function fromHash() {
                    var h = location.hash, g = function (k) { var m = new RegExp("[#&]" + k + "=([^&]*)").exec(h); return m ? decodeURIComponent(m[1]) : null; };
                    if (g("site") && SITES[g("site")]) { apex.item("P2_SITE").setValue(g("site"), null, true); }
                    var look = g("look"), rs = {};
                    (g("r") || "").split(",").forEach(function (p) { var i = p.indexOf(":"); if (i > 0) { rs[p.slice(0, i)] = p.slice(i + 1).split(/[\s+]+/); } });
                    setPage((look !== null ? look : SITES[$v("P2_SITE") || "WEBSITE"].look).split(/[\s+]+/));
                    setSections(rs);
                })();
                $("#P2_SITE").on("change", function () { setPage(SITES[$v("P2_SITE")].look.split(/\s+/)); setSections({}); sqlPanel(); render(); });

                function chosen() {
                    var page = [], rows = [], extra = [], allDefaults = true, tpl = {}, changed = [];
                    SELECTS.forEach(function (s) {
                        var v = $v(s.item), text = $("#" + s.item + " option:selected").text();
                        if (v) { page.push(v); extra.push(v); }
                        rows.push({ group: s.group, option: text, isDefault: !v });
                    });
                    SWITCHES.forEach(function (s) {
                        var on = $v(s.item) === "Y", isDef = DEF.indexOf(s.css) >= 0;
                        if (on) { page.push(s.css); }
                        if (isDef && !on) { allDefaults = false; }
                        if (on && !isDef) { extra.push(s.css); }
                        rows.push({ group: s.label, option: on ? "On" : "Off", isDefault: on === isDef });
                    });
                    SECTIONS.forEach(function (s) {
                        var v = $v(s[0]);
                        if (!v) { return; }
                        (tpl[s[2]] = tpl[s[2]] || []).push(v);
                        changed.push({ tpl: s[2], label: s[1], option: $("#" + s[0] + " option:selected").text(), cls: v });
                    });
                    return { page: page, rows: rows, snippet: allDefaults ? ["#DEFAULT#"].concat(extra) : page, tpl: tpl, changed: changed,
                             regions: Object.keys(tpl).map(function (k) { return "@" + k + ":" + tpl[k].join("+"); }).join(",") };
                }
                function arr(list, n) {
                    var pad = new Array(n + 1).join(" ");
                    return list.length === 1 ? " " + list[0] + "\n" : " [\n" + list.map(function (x) { return pad + "    " + x + "\n"; }).join("") + pad + "]\n";
                }
                function relevance() {
                    var dark = /midnight|techgrid/.test($v("P2_DESIGN"));
                    $("#P2_SCHEME_CONTAINER").toggleClass("wsd-Off", dark).attr("data-why", dark ? "Midnight and Tech Grid are always dark" : null);
                }
                function render() {
                    var c = chosen(), hash = "#ws=" + encodeURIComponent(c.page.join(" ")) + (c.regions ? "&r=" + encodeURIComponent(c.regions) : ""), src = siteUrl();
                    relevance();
                    // section options and another site need a fresh page; page options follow the hash without a reload
                    if (src + c.regions !== lastSrc || !frame.getAttribute("src")) { frame.setAttribute("src", src + hash); }
                    else { try { frame.contentWindow.location.hash = hash; } catch (e) { frame.setAttribute("src", src + hash); } }
                    lastSrc = src + c.regions;
                    $("#wsd-summary").html('<p class="wsd-H">Modern One Page</p><dl class="wsd-List">' + c.rows.map(function (r) {
                        return "<dt>" + esc(r.group) + "</dt><dd" + (r.isDefault ? ' class="is-default"' : "") + ">" + esc(r.option) + "</dd>";
                    }).join("") + "</dl>" + (c.changed.length ? '<p class="wsd-H">Sections</p><dl class="wsd-List">' + c.changed.map(function (r) {
                        return "<dt>" + esc(r.label) + "</dt><dd>" + esc(r.option) + "</dd>";
                    }).join("") + "</dl>" : ""));
                    var code = "appearance {\n    pageTemplate: @modern-one-page\n    templateOptions:" + arr(c.snippet, 4) + "}";
                    Object.keys(c.tpl).forEach(function (t) {
                        var on = (PRESET[t] || []).concat(c.tpl[t].filter(function (x) { return /^ws-/.test(x); })), off = c.tpl[t].filter(function (x) { return x.charAt(0) === "-"; }).map(function (x) { return x.slice(1); });
                        on = on.filter(function (x, i) { return off.indexOf(x) < 0 && on.indexOf(x) === i; });
                        code += "\n\n// every region with " + TPL_NAME[t] + "\ncomponentAppearance {\n" + (t === "website-menu" ? "    listTemplate: @website-menu\n" : "    templateType: theme\n    template: @" + t + "\n") +
                            "    templateOptions:" + arr(["#DEFAULT#"].concat(on), 4) + "}";
                    });
                    $("#wsd-code").text(code);
                }
                // the SQL of the sections with pictures on the chosen site
                function sqlPanel() {
                    var list = SITES[$v("P2_SITE") || "WEBSITE"].sql, sel = $("#wsd-sqlpick");
                    sel.html(list.map(function (x, i) { return '<option value="' + i + '">' + esc(x.name) + "</option>"; }).join(""));
                    showSql();
                }
                function showSql() { var x = SITES[$v("P2_SITE") || "WEBSITE"].sql[+$("#wsd-sqlpick").val() || 0]; $("#wsd-sql").text(x ? x.sql : ""); }
                $(document).on("change", "#wsd-sqlpick", showSql);

                $(SELECTS.concat(SWITCHES).map(function (s) { return "#" + s.item; }).concat(SECTIONS.map(function (s) { return "#" + s[0]; })).join(",")).on("change", render);
                // Desktop: the page is laid out at 1280px and scaled down to fit the preview
                function fit() {
                    var stage = document.getElementById("wsd-stage"), desk = $v("P2_DEVICE") === "DESKTOP", s = Math.min(1, stage.clientWidth / 1280);
                    stage.setAttribute("data-device", $v("P2_DEVICE"));
                    frame.style.width = desk ? "1280px" : "";
                    frame.style.height = desk ? (stage.clientHeight / s) + "px" : "";
                    frame.style.transform = desk && s < 1 ? "scale(" + s + ")" : "";
                }
                $("#P2_DEVICE").on("change", fit);
                $(window).on("resize apexwindowresized", fit);
                fit();
                function copy(text) { navigator.clipboard.writeText(text).then(function () { apex.message.showPageSuccess("Copied."); }); }
                $(document).on("click", ".js-wsd-copy", function () { copy($("#wsd-code").text()); });
                $(document).on("click", ".js-wsd-copysql", function () { copy($("#wsd-sql").text()); });
                $(document).on("click", ".js-wsd-open", function () { window.open(frame.getAttribute("src"), "_blank"); });
                sqlPanel();
                render();
            })(apex.jQuery);
            ```
    }
    css {
        inline:
            ```css
            .wsd-Stage { position: relative; display: flex; justify-content: center; align-items: center; height: min(80vh, 780px); min-height: 520px; overflow: hidden; border-radius: 12px;
                         border: 1px solid var(--ut-component-border-color, #ddd); background: repeating-conic-gradient(rgba(0,0,0,.035) 0 25%, transparent 0 50%) 0 0 / 24px 24px; }
            .wsd-Stage iframe { display: block; width: 100%; height: 100%; border: 0; background: #fff; transition: width .3s ease, border-radius .3s ease; }
            .wsd-Stage[data-device="DESKTOP"] { display: block; }
            .wsd-Stage[data-device="DESKTOP"] iframe { transform-origin: 0 0; transition: none; }
            .wsd-Stage[data-device="TABLET"], .wsd-Stage[data-device="PHONE"] { padding: 16px 0; }
            .wsd-Stage[data-device="TABLET"] iframe { width: 820px; max-width: calc(100% - 32px); border-radius: 20px; box-shadow: 0 0 0 12px #1f2329, 0 24px 48px -12px rgba(0,0,0,.45); }
            .wsd-Stage[data-device="PHONE"] iframe { width: 390px; max-width: calc(100% - 32px); border-radius: 28px; box-shadow: 0 0 0 10px #1f2329, 0 24px 48px -12px rgba(0,0,0,.45); }
            .wsd-List { display: grid; grid-template-columns: auto 1fr; gap: .375rem 1rem; margin: 0 0 1rem; font-size: .875rem; }
            .wsd-List dt { opacity: .75; }
            .wsd-List dd { margin: 0; font-weight: 600; }
            .wsd-List dd.is-default::after { content: " (default)"; font-weight: 400; opacity: .7; }
            .wsd-Code { margin: 0 0 1rem; padding: .875rem 1rem; overflow-x: auto; border-radius: 8px; background: #1f2329; color: #e6edf3; font-size: .8125rem; line-height: 1.5; white-space: pre-wrap; }
            .wsd-Where { margin: 0 0 .75rem; padding: .625rem .875rem; border-radius: 8px; background: rgba(234,88,12,.08); font-size: .8125rem; line-height: 1.5; }
            .wsd-H { display: block; margin: 1rem 0 .5rem; font-size: .875rem; font-weight: 700; }
            .wsd-Pick { width: 100%; max-width: 32rem; margin-bottom: .75rem; }
            .wsd-Off { opacity: .6; }
            .wsd-Off[data-why]::after { content: attr(data-why); display: block; padding: 0 .75rem .25rem; font-size: .75rem; font-style: italic; }
            @media (max-width: 640px) { .wsd-Stage { height: 72vh; min-height: 460px; } }
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Designer
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region options (
        name: Template Options
        type: staticContent
        layout {
            sequence: 20
            slot: body
            columnSpan: 4
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )

    region sections (
        name: Section Options
        type: staticContent
        layout {
            sequence: 5
            parentRegion: @options
            slot: subRegions
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h3
            ]
        }
    )

    region preview (
        name: Live Preview
        type: staticContent
        source {
            htmlCode: <div class="wsd-Stage" id="wsd-stage" data-device="DESKTOP"><iframe id="wsd-frame" title="Website preview" data-app="f?p=&APP_ID.:" data-session=":&APP_SESSION."></iframe></div>
        }
        layout {
            sequence: 30
            slot: body
            startNewRow: false
            columnSpan: 8
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
    )

    region summary (
        name: Your Choice
        type: staticContent
        source {
            htmlCode:
                ```html
                <p class="wsd-Where">Page Designer: select your one page, <strong>Appearance &gt; Page Template</strong> = <strong>Modern One Page</strong>, then tick the <strong>Template Options</strong> listed below. Section Options act on every region with that template: select the region, <strong>Attributes &gt; Appearance &gt; Template Options</strong> (for the menu: the List region's Template Options). Or paste the APEXlang into the page file.</p>
                <div id="wsd-summary"></div>
                <p class="wsd-H">APEXlang (page file)</p>
                <pre class="wsd-Code" id="wsd-code"></pre>
                <button type="button" class="t-Button t-Button--small t-Button--iconLeft js-wsd-copy"><span class="t-Icon fa fa-copy" aria-hidden="true"></span><span class="t-Button-label">Copy APEXlang</span></button>
                ```
        }
        layout {
            sequence: 10
            parentRegion: @options
            slot: subRegions
        }
        appearance {
            template: @/content-block
            templateOptions: [
                #DEFAULT#
                t-ContentBlock--h3
            ]
        }
    )

    pageItem P2_SITE (
        type: selectList
        label {
            label: Website
            alignment: left
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Design Studio;WEBSITE,Company;COMPANY,Restaurant;RESTAURANT,Clinic (Arabic RTL);CLINIC,Real Estate;REAL-ESTATE,Conference;CONFERENCE,Portfolio;PORTFOLIO,SaaS Product;SAAS
            displayNullValue: false
        }
        layout {
            sequence: 1
            region: @options
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        default {
            type: static
            staticValue: WEBSITE
        }
        sessionState {
            storage: request
        }
    )

