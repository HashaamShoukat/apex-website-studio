page 2 (
    name: Designer
    alias: DESIGNER
    title: Website Studio - Designer
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    javaScript {
        executeWhenPageLoads:
            ```javascript-browser
            // Designer: every choice is a template option (a CSS class) of Modern One Page or of a Website report or list template.
            // The preview iframe shows a real website page; the classes travel in its URL hash (#ws=<page classes>&r=@<template>:<classes>,...).
            (function ($) {
                var DEF = "ws-Fx--sticky ws-Fx--reveal ws-Fx--count ws-Fx--top".split(" ");
                var SELECTS = [{"item":"P2_DESIGN","group":"Design"},{"item":"P2_ACCENT","group":"Accent Color"},{"item":"P2_SCHEME","group":"Color Scheme"},{"item":"P2_FONT","group":"Typeface"},{"item":"P2_HEADER","group":"Header"},{"item":"P2_CORNERS","group":"Corners"},{"item":"P2_SPACE","group":"Section Spacing"},{"item":"P2_FOOTER","group":"Footer"},{"item":"P2_PH","group":"Placeholder Images"}];
                var SWITCHES = [{"item":"P2_STICKY","css":"ws-Fx--sticky","label":"Sticky Header"},{"item":"P2_REVEAL","css":"ws-Fx--reveal","label":"Reveal on Scroll"},{"item":"P2_COUNT","css":"ws-Fx--count","label":"Count Up Numbers"},{"item":"P2_TOP","css":"ws-Fx--top","label":"Back to Top Button"},{"item":"P2_PROGRESS","css":"ws-Fx--progress","label":"Scroll Progress Bar"},{"item":"P2_THEME","css":"ws-Fx--theme","label":"Light/Dark Toggle"},{"item":"P2_CHAT","css":"ws-Fx--chat","label":"WhatsApp Button"}];
                // [item, label, template, [[option, value]...]]
                var SECTIONS = [["P2_HERO_LAYOUT","Hero - Layout","ws-hero",[["Slider","ws-Hero--slider"],["Split","ws-Hero--split"],["Centered","ws-Hero--centered"],["Full Bleed","ws-Hero--fullbleed"]]],["P2_HERO_HEIGHT","Hero - Height","ws-hero",[["Large","!wsr-hero-height"],["Full Screen","ws-Hero--full"],["Medium","ws-Hero--medium"]]],["P2_HERO_OVERLAY","Hero - Image Overlay","ws-hero",[["Normal","!wsr-hero-overlay"],["Light","ws-Hero--light"],["Strong","ws-Hero--strong"]]],["P2_HERO_MOVE","Hero - Transition","ws-hero",[["Fade","!wsr-hero-move"],["Slide","ws-Hero--slide"]]],["P2_HERO_ZOOM","Hero - Slow Zoom","ws-hero",[["On","ws-Hero--zoom"],["Off","-ws-Hero--zoom"]]],["P2_HERO_AUTOPLAY","Hero - Autoplay","ws-hero",[["6 Seconds","!wsr-autoplay"],["4 Seconds","ws-Auto--4"],["9 Seconds","ws-Auto--9"],["Off","ws-Auto--off"]]],["P2_MENU_ALIGN","Menu - Alignment","website-menu",[["Right","!wsm-align"],["Center","ws-Menu--center"],["Left","ws-Menu--left"]]],["P2_MENU_MAX","Menu - Visible Entries","website-menu",[["All","!wsm-max"],["4, then More","ws-Menu--max4"],["5, then More","ws-Menu--max5"],["6, then More","ws-Menu--max6"],["7, then More","ws-Menu--max7"]]],["P2_MENU_MOBILE","Menu - On Phones","website-menu",[["Drop-down Panel","!wsm-mobile"],["Full-screen Overlay","ws-Menu--overlay"],["Side Drawer","ws-Menu--drawer"]]],["P2_MENU_CTA","Menu - Last Entry as Button","website-menu",[["On","ws-Menu--cta"],["Off","-ws-Menu--cta"]]],["P2_FEATURES_LAYOUT","Services - Layout","ws-features",[["Cards","!wsr-features-layout"],["Rows","ws-Features--rows"],["Bento","ws-Features--bento"],["Icons Only","ws-Features--icons"]]],["P2_TESTIMONIALS_LAYOUT","Testimonials - Layout","ws-testimonials",[["Carousel","ws-Quotes--carousel"],["Wall","ws-Quotes--wall"],["Spotlight","ws-Quotes--spotlight"]]],["P2_TEAM_LAYOUT","Team - Layout","ws-team",[["Portrait Cards","!wsr-team-layout"],["Round Photos","ws-Team--round"],["Compact List","ws-Team--list"]]],["P2_GALLERY_LAYOUT","Portfolio - Layout","ws-gallery",[["Grid","!wsr-works-layout"],["Editorial","ws-Works--editorial"],["Large","ws-Works--large"]]],["P2_LOGOS_LAYOUT","Logos - Layout","ws-logos",[["Scrolling Marquee","ws-Logos--marquee"],["Grid","ws-Logos--grid"],["Row","ws-Logos--row"]]],["P2_LOGOS_SPEED","Logos - Marquee Speed","ws-logos",[["Normal","!wsr-logos-speed"],["Slow","ws-Speed--slow"],["Fast","ws-Speed--fast"]]],["P2_STEPS_LAYOUT","Process - Layout","ws-steps",[["Connected","ws-Steps--line"],["Cards","ws-Steps--cards"]]],["P2_TIMELINE_LAYOUT","Timeline - Layout","ws-timeline",[["Alternating","ws-Timeline--alternate"],["List","ws-Timeline--list"]]],["P2_NEWS_LAYOUT","News - Layout","ws-news",[["Cards","!wsr-news-layout"],["First Post Large","ws-News--featured"],["List","ws-News--list"]]],["P2_PRODUCTS_LAYOUT","Products - Layout","ws-products",[["Cards","!wsr-products-layout"],["Menu List","ws-Products--menu"],["Compact","ws-Products--compact"]]],["P2_PHOTOS_LAYOUT","Photo Gallery - Layout","ws-photos",[["Grid","!wsr-photos-layout"],["Masonry","ws-Photos--masonry"],["Scrolling Strip","ws-Photos--strip"]]],["P2_EVENTS_LAYOUT","Events - Layout","ws-events",[["Agenda","!wsr-events-layout"],["Cards","ws-Events--cards"]]],["P2_HOURS_LAYOUT","Opening Hours - Layout","ws-hours",[["Table","!wsr-hours-layout"],["Cards","ws-Hours--cards"]]]];
                var PRESET = {"ws-hero":["ws-Hero--zoom"],"ws-stats":[],"ws-features":[],"ws-team":[],"ws-testimonials":[],"ws-logos":[],"ws-pricing":["ws-Plans--lift"],"ws-timeline":[],"ws-steps":[],"ws-faq":[],"ws-jobs":["ws-Filter"],"ws-gallery":["ws-Filter"],"ws-links":[],"ws-contact":[],"ws-news":[],"ws-products":["ws-Filter"],"ws-photos":[],"ws-zigzag":[],"ws-events":[],"ws-hours":[],"ws-compare":[],"ws-video":[],"ws-map":[]}, TPL_NAME = {"ws-hero":"Website - Hero","ws-stats":"Website - Numbers","ws-features":"Website - Services","ws-team":"Website - Team","ws-testimonials":"Website - Testimonials","ws-logos":"Website - Logos","ws-pricing":"Website - Pricing","ws-timeline":"Website - Timeline","ws-steps":"Website - Process","ws-faq":"Website - FAQ","ws-jobs":"Website - Careers","ws-gallery":"Website - Portfolio","ws-links":"Website - Links","ws-contact":"Website - Contact Details","ws-news":"Website - News","ws-products":"Website - Products","ws-photos":"Website - Photo Gallery","ws-zigzag":"Website - Image and Text","ws-events":"Website - Events","ws-hours":"Website - Opening Hours","ws-compare":"Website - Comparison","ws-video":"Website - Video","ws-map":"Website - Map","website-menu":"Website - Menu"};
                var SITES = {"WEBSITE":{"look":"ws-Accent--tangerine ws-Font--grotesk","name":"Design Studio","page":10,"sql":[{"id":"hero","name":"Halcyon (Website - Hero)","sql":"select 'We design brands people *remember*.' as title,\n       'Brand and digital studio - Lisbon' as subtitle,\n       'Strategy, identity and websites for companies with something to say.' as text,\n       'See our work' as button_label,\n       '#work' as button_link,\n       'Book a call' as button2_label,\n       '#contact' as button2_link,\n       'website-studio/img/studio-hero-1.jpg' as image_file,\n       'Designers around a table covered in sketches' as image_alt,\n       'center 40%' as image_position,\n       1 as sort_order\n  from dual\nunion all\nselect 'Websites that *work* as hard as you do.' as title,\n       'Websites' as subtitle,\n       'Fast, accessible sites your team can update without calling a developer.' as text,\n       'Our services' as button_label,\n       '#services' as button_link,\n       null as button2_label,\n       null as button2_link,\n       'website-studio/img/studio-hero-2.jpg' as image_file,\n       'A bright studio with long desks and plants' as image_alt,\n       null as image_position,\n       2 as sort_order\n  from dual\nunion all\nselect 'From first sketch to *global* launch.' as title,\n       'Since 2011' as subtitle,\n       'One senior team from kickoff to the day you go live, and after.' as text,\n       'Start a project' as button_label,\n       '#contact' as button_link,\n       null as button2_label,\n       null as button2_link,\n       'website-studio/img/studio-hero-3.jpg' as image_file,\n       'A team discussing ideas on a glass wall' as image_alt,\n       null as image_position,\n       3 as sort_order\n  from dual\norder by sort_order"},{"id":"work","name":"Work (Website - Portfolio)","sql":"select 'Tidewater Ferries' as title,\n       'Branding' as category,\n       'Identity - 2024' as meta,\n       'website-studio/img/work-1.jpg' as image_file,\n       'Brand identity on business cards and paper' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'Lumen Bank' as title,\n       'Web' as category,\n       'Website - 2024' as meta,\n       'website-studio/img/work-2.jpg' as image_file,\n       'A website design on a laptop' as image_alt,\n       2 as sort_order\n  from dual\nunion all\nselect 'Fieldnote' as title,\n       'Product' as category,\n       'App design - 2023' as meta,\n       'website-studio/img/work-3.jpg' as image_file,\n       'A mobile app on a phone' as image_alt,\n       3 as sort_order\n  from dual\nunion all\nselect 'Kestrel Coffee' as title,\n       'Branding' as category,\n       'Packaging - 2023' as meta,\n       'website-studio/img/work-4.jpg' as image_file,\n       'Coffee packaging' as image_alt,\n       4 as sort_order\n  from dual\nunion all\nselect 'Orbital Labs' as title,\n       'Web' as category,\n       'Website - 2023' as meta,\n       'website-studio/img/work-5.jpg' as image_file,\n       'A product dashboard on a large screen' as image_alt,\n       5 as sort_order\n  from dual\nunion all\nselect 'Vantage Hotels' as title,\n       'Branding' as category,\n       'Identity - 2022' as meta,\n       'website-studio/img/work-6.jpg' as image_file,\n       'A hotel lobby with the new signage' as image_alt,\n       6 as sort_order\n  from dual\norder by sort_order"},{"id":"clients-say","name":"Clients who stayed (Website - Testimonials)","sql":"select 'Halcyon understood our business faster than our own board did. The new brand paid for itself in the first quarter.' as quote,\n       'Sofia Marques' as name,\n       'CEO, Tidewater Ferries' as role,\n       '5' as rating,\n       'website-studio/img/person-3.jpg' as image_file,\n       'Portrait of a woman with curly hair' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'They are the rare studio that is as good at listening as they are at design. Our site conversion doubled after launch.' as quote,\n       'Daniel Brook' as name,\n       'Head of Marketing, Lumen Bank' as role,\n       '5' as rating,\n       'website-studio/img/person-6.jpg' as image_file,\n       'Portrait of a man in a suit' as image_alt,\n       2 as sort_order\n  from dual\nunion all\nselect 'Calm, honest and very talented. Three projects in and we would not go anywhere else.' as quote,\n       'Priya Nair' as name,\n       'Founder, Fieldnote' as role,\n       '5' as rating,\n       'website-studio/img/person-5.jpg' as image_file,\n       'Portrait of a woman in an office' as image_alt,\n       3 as sort_order\n  from dual\norder by sort_order"},{"id":"team","name":"Team (Website - Team)","sql":"select 'Ines Duarte' as name,\n       'Founder and Creative Director' as role,\n       'https://www.linkedin.com/' as link,\n       'website-studio/img/person-1.jpg' as image_file,\n       'Portrait of a woman smiling' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'Tomas Ferreira' as name,\n       'Design Director' as role,\n       'https://www.linkedin.com/' as link,\n       'website-studio/img/person-2.jpg' as image_file,\n       'Portrait of a man in a shirt' as image_alt,\n       2 as sort_order\n  from dual\nunion all\nselect 'Amara Okafor' as name,\n       'Head of Strategy' as role,\n       'https://www.linkedin.com/' as link,\n       'website-studio/img/person-5.jpg' as image_file,\n       'Portrait of a woman in an office' as image_alt,\n       3 as sort_order\n  from dual\nunion all\nselect 'Leo Brandt' as name,\n       'Engineering Lead' as role,\n       'https://www.linkedin.com/' as link,\n       'website-studio/img/person-4.jpg' as image_file,\n       'Portrait of a man with a beard' as image_alt,\n       4 as sort_order\n  from dual\norder by sort_order"}]},"COMPANY":{"look":"ws-Design--corporate ws-Accent--indigo ws-Font--tech ws-Header--centered","name":"Company","page":11,"sql":[{"id":"hero","name":"Meridian (Website - Hero)","sql":"select 'Infrastructure that *lasts* a generation.' as title,\n       'Engineering and advisory since 1998' as subtitle,\n       'We plan, build and run the roads, grids and water networks that cities depend on.' as text,\n       'Our services' as button_label,\n       '#services' as button_link,\n       'Talk to an expert' as button2_label,\n       '#contact' as button2_link,\n       'website-studio/img/company-hero.jpg' as image_file,\n       'A modern office building' as image_alt,\n       1 as sort_order\n  from dual\norder by sort_order"},{"id":"about","name":"About (Website - Image and Text)","sql":"select 'About us' as eyebrow,\n       'Four hundred engineers, *one* standard.' as title,\n       'From offices in Riyadh, Dubai and Rotterdam we work with public and private clients on projects that must still work in fifty years.' as text,\n       '#team' as link,\n       'Meet the leadership' as link_label,\n       'website-studio/img/company-team.jpg' as image_file,\n       'Colleagues working on laptops' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'How we work' as eyebrow,\n       'Plan first, build once.' as title,\n       'Every project starts with a digital model of the asset, so cost, risk and carbon are clear before the first contract is signed.' as text,\n       '#services' as link,\n       'Our services' as link_label,\n       'website-studio/img/company-plan.jpg' as image_file,\n       'Planning notes and charts on a desk' as image_alt,\n       2 as sort_order\n  from dual\nunion all\nselect 'Sustainability' as eyebrow,\n       'Net zero on our own sites by *2030*.' as title,\n       'We publish our emissions every year and design every project to the lowest carbon option the client can afford.' as text,\n       null as link,\n       null as link_label,\n       'website-studio/img/company-meeting.jpg' as image_file,\n       'A meeting around a table' as image_alt,\n       3 as sort_order\n  from dual\norder by sort_order"},{"id":"news","name":"Insights (Website - News)","sql":"select 'What digital twins changed on the Atlas Rail extension' as title,\n       'Two years in, the model has saved four months of site work. Here is what we learned.' as text,\n       '12 Oct 2026' as post_date,\n       'Case study' as category,\n       '#' as link,\n       'website-studio/img/news-1.jpg' as image_file,\n       'Charts on a laptop' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'Meridian opens a Rotterdam office' as title,\n       'Forty engineers join to lead our water and port work in Northern Europe.' as text,\n       '28 Sep 2026' as post_date,\n       'News' as category,\n       '#' as link,\n       'website-studio/img/news-2.jpg' as image_file,\n       'A desk with a laptop and coffee' as image_alt,\n       2 as sort_order\n  from dual\nunion all\nselect 'Five questions to ask before a feasibility study' as title,\n       'A short guide for project owners from our advisory practice.' as text,\n       '3 Sep 2026' as post_date,\n       'Guide' as category,\n       '#' as link,\n       'website-studio/img/news-3.jpg' as image_file,\n       'A presentation in a meeting room' as image_alt,\n       3 as sort_order\n  from dual\norder by sort_order"},{"id":"team","name":"Team (Website - Team)","sql":"select 'Omar Al-Harbi' as name,\n       'Chief Executive' as role,\n       'https://www.linkedin.com/' as link,\n       'website-studio/img/person-2.jpg' as image_file,\n       'Portrait of a man in a shirt' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'Sara Lindqvist' as name,\n       'Head of Engineering' as role,\n       'https://www.linkedin.com/' as link,\n       'website-studio/img/person-5.jpg' as image_file,\n       'Portrait of a woman in an office' as image_alt,\n       2 as sort_order\n  from dual\nunion all\nselect 'Daniel Okoro' as name,\n       'Head of Advisory' as role,\n       'https://www.linkedin.com/' as link,\n       'website-studio/img/person-6.jpg' as image_file,\n       'Portrait of a man in a suit' as image_alt,\n       3 as sort_order\n  from dual\nunion all\nselect 'Maya Chen' as name,\n       'Head of Sustainability' as role,\n       'https://www.linkedin.com/' as link,\n       'website-studio/img/person-3.jpg' as image_file,\n       'Portrait of a woman with curly hair' as image_alt,\n       4 as sort_order\n  from dual\norder by sort_order"},{"id":"clients-say","name":"What clients say (Website - Testimonials)","sql":"select 'Meridian found savings in the design that paid for their whole contract. Calm, precise and always on time.' as quote,\n       'Khalid Mansour' as name,\n       'Programme Director, Atlas Rail' as role,\n       '5' as rating,\n       'website-studio/img/person-4.jpg' as image_file,\n       'Portrait of a man with a beard' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'The best engineering partner we have had in twenty years of building water networks.' as quote,\n       'Laila Haddad' as name,\n       'CEO, Gulf Water' as role,\n       '5' as rating,\n       'website-studio/img/person-1.jpg' as image_file,\n       'Portrait of a woman smiling' as image_alt,\n       2 as sort_order\n  from dual\norder by sort_order"}]},"RESTAURANT":{"look":"ws-Design--organic ws-Accent--wine ws-Font--serif ws-Header--transparent","name":"Restaurant","page":12,"sql":[{"id":"hero","name":"Osteria Lume (Website - Hero)","sql":"select 'Slow food, *good* wine, long evenings.' as title,\n       'Italian kitchen and wine bar' as subtitle,\n       'Seasonal plates from a small kitchen, open every evening from six.' as text,\n       'Book a table' as button_label,\n       '#contact' as button_link,\n       'See the menu' as button2_label,\n       '#menu' as button2_link,\n       'website-studio/img/food-hero-1.jpg' as image_file,\n       'A table with plates of food' as image_alt,\n       1 as sort_order\n  from dual\nunion all\nselect 'A dining room made for *sharing*.' as title,\n       'Since 2014' as subtitle,\n       'Forty seats, one long table and a bar for walk-ins.' as text,\n       'Plan your visit' as button_label,\n       '#visit' as button_link,\n       null as button2_label,\n       null as button2_link,\n       'website-studio/img/food-hero-2.jpg' as image_file,\n       'The dining room in the evening' as image_alt,\n       2 as sort_order\n  from dual\nunion all\nselect 'Everything made *here*, every day.' as title,\n       'From our kitchen' as subtitle,\n       'Pasta rolled each morning, bread from our wood oven.' as text,\n       'Our story' as button_label,\n       '#story' as button_link,\n       null as button2_label,\n       null as button2_link,\n       'website-studio/img/food-hero-3.jpg' as image_file,\n       'A chef plating a dish' as image_alt,\n       3 as sort_order\n  from dual\norder by sort_order"},{"id":"menu","name":"Menu (Website - Products)","sql":"select 'Burrata and roasted peppers' as name,\n       'Basil oil, sourdough from our oven' as text,\n       'SAR 58' as price,\n       'Starters' as category,\n       'website-studio/img/dish-2.jpg' as image_file,\n       'A fresh salad bowl' as image_alt,\n       null as badge,\n       1 as sort_order\n  from dual\nunion all\nselect 'Grilled sea bream' as name,\n       'Lemon, capers, charred greens' as text,\n       'SAR 124' as price,\n       'Mains' as category,\n       'website-studio/img/dish-1.jpg' as image_file,\n       'Grilled fish with lemon' as image_alt,\n       'Chef''s choice' as badge,\n       2 as sort_order\n  from dual\nunion all\nselect 'Margherita from the wood oven' as name,\n       'San Marzano tomato, fior di latte' as text,\n       'SAR 72' as price,\n       'Mains' as category,\n       'website-studio/img/dish-3.jpg' as image_file,\n       'Wood-fired pizza' as image_alt,\n       null as badge,\n       3 as sort_order\n  from dual\nunion all\nselect 'Tagliatelle al pomodoro' as name,\n       'Fresh egg pasta,