    region process (
        name: A clear process, no surprises
        title: A clear process, *no* surprises
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Discover' as title,
                       'Interviews, audits and a workshop to learn what makes you different.' as text,
                       '2 weeks' as duration,
                       1 as sort_order
                  from dual
                union all
                select 'Define' as title,
                       'A strategy and creative brief we both sign off before any design starts.' as text,
                       '1 week' as duration,
                       2 as sort_order
                  from dual
                union all
                select 'Design' as title,
                       'Concepts, rounds of refinement and testing with your customers.' as text,
                       '4 to 6 weeks' as duration,
                       3 as sort_order
                  from dual
                union all
                select 'Deliver' as title,
                       'Launch, guidelines, files and training so your team owns the result.' as text,
                       '2 weeks' as duration,
                       4 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Tone--soft
            ]
        }
        advanced {
            htmlDomId: process
        }
        headerAndFooter {
            headerText: <p class="ws-Eyebrow">How we work</p><p class="ws-Lead">Every project follows the same four stages, so you always know what happens next and what it costs.</p>
