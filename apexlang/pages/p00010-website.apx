    region history (
        name: Thirteen years, one desk at a time
        title: Thirteen years, *one* desk at a time
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select '2011' as year,
                       'Founded in Alfama' as title,
                       'Two designers, one borrowed printer and a first client who still works with us.' as text,
                       1 as sort_order
                  from dual
                union all
                select '2015' as year,
                       'First international client' as title,
                       'A rebrand for a Berlin fintech took us beyond Portugal.' as text,
                       2 as sort_order
                  from dual
                union all
                select '2019' as year,
                       'Studio of the Year' as title,
                       'A regional design award for our work with a ferry operator.' as text,
                       3 as sort_order
                  from dual
                union all
                select '2024' as year,
                       'Porto studio opens' as title,
                       'Ten new people and a riverside room with very good light.' as text,
                       4 as sort_order
