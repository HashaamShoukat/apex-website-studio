    region careers (
        name: Careers
        title: Do the best work of your *life*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Senior Brand Designer' as title,
                       'Design' as team,
                       'Lisbon' as location,
                       'Full-time' as type,
                       'Lead identity projects from concept to guidelines, and mentor two mid-level designers.' as description,
                       'mailto:jobs@example.com?subject=Senior%20Brand%20Designer' as apply_link,
                       1 as sort_order
                  from dual
                union all
                select 'Frontend Engineer' as title,
                       'Engineering' as team,
                       'Remote (EU)' as location,
                       'Full-time' as type,
                       'Build fast, accessible marketing sites with our designers.' as description,
                       'mailto:jobs@example.com?subject=Frontend%20Engineer' as apply_link,
                       2 as sort_order
                  from dual
                union all
                select 'Brand Strategist' as title,
                       'Strategy' as team,
                       'Porto' as location,
                       'Full-time' as type,
                       'Run research and workshops, and write the strategies our design work stands on.' as description,
                       'mailto:jobs@example.com?subject=Brand%20Strategist' as apply_link,
                       3 as sort_order
                  from dual
                union all
                select 'Design Intern' as title,
                       'Design' as team,
                       'Lisbon' as location,
                       '6-month internship' as type,
                       'Paid internship for a recent graduate. You work on real client projects from week one.' as description,
                       'mailto:jobs@example.com?subject=Design%20Intern' as apply_link,
                       4 as sort_order
                  from dual
                order by sort_order
                ```
        }
