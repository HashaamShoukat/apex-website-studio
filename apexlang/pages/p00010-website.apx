    region vision (
        name: Our vision
        title: Our vision
        type: staticContent
        source {
            htmlCode:
                ```
                <div class="ws-Stack">
                  <p class="ws-Eyebrow">Our vision</p>
                  <p class="ws-Statement">Every company deserves a brand it can be *proud* to put its name on.</p>
                </div>
                <div class="ws-Pillars">
                  <div><h3>Vision</h3><p>A world where small, honest companies look as good as the giants, and earn trust because of it.</p></div>
                  <div><h3>Mission</h3><p>Give each client a senior team, a clear process and work that still feels right in ten years.</p></div>
                  <div><h3>Values</h3><p>Say what we mean. Sweat the details. Leave every project, and every person, better than we found them.</p></div>
                </div>
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Tone--dark
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: vision
        }
    )

    region work (
        name: Work
        title: Recent *projects*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Tidewater Ferries' as title,
                       'Branding' as category,
                       'Identity - 2024' as meta,
                       'website-studio/img/work-1.jpg' as image_file,
                       'Colour swatches for a brand identity' as image_alt,
                       1 as sort_order
                  from dual
                union all
                select 'Lumen Bank' as title,
                       'Web' as category,
                       'Website - 2024' as meta,
                       'website-studio/img/work-2.jpg' as image_file,
                       'A website design on a large screen' as image_alt,
                       2 as sort_order
                  from dual
                union all
                select 'Fieldnote' as title,
                       'Product' as category,
                       'App design - 2023' as meta,
                       'website-studio/img/work-3.jpg' as image_file,
                       'A mobile app on a phone' as image_alt,
                       3 as sort_order
                  from dual
                union all
                select 'Kestrel Coffee' as title,
                       'Branding' as category,
                       'Packaging - 2023' as meta,
                       'website-studio/img/work-4.jpg' as image_file,
                       'Coffee packaging' as image_alt,
