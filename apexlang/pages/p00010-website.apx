page 10 (
    name: Demo Website
    alias: WEBSITE
    title: Halcyon - Brand and Digital Design Studio
    appearance {
        pageTemplate: @modern-one-page
        templateOptions: [
            #DEFAULT#
            ws-Accent--tangerine
            ws-Font--grotesk
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    htmlHeader {
        htmlHeader:
            ```html
            <meta name="description" content="Halcyon is a brand and digital design studio in Lisbon and Porto: strategy, identity, websites and product design.">
            <meta property="og:type" content="website">
            <meta property="og:title" content="Halcyon - Brand and Digital Design Studio">
            <meta property="og:description" content="Halcyon is a brand and digital design studio in Lisbon and Porto: strategy, identity, websites and product design.">
            <meta property="og:image" content="#APP_FILES#website-studio/img/studio-hero-1.jpg">
            <meta name="twitter:card" content="summary_large_image">
            <link rel="preload" as="image" href="#APP_FILES#website-studio/img/studio-hero-1.jpg" fetchpriority="high">
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hero (
        name: Halcyon
        title: Halcyon
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'We design brands people *remember*.' as title,
                       'Brand and digital studio - Lisbon' as subtitle,
                       'Strategy, identity and websites for companies with something to say.' as text,
                       'See our work' as button_label,
                       '#work' as button_link,
                       'Book a call' as button2_label,
                       '#contact' as button2_link,
                       'website-studio/img/studio-hero-1.jpg' as image_file,
                       'Designers working on laptops around a table' as image_alt,
                       'center 40%' as image_position,
                       1 as sort_order
                  from dual
                union all
                select 'Websites that *work* as hard as you do.' as title,
                       'Websites' as subtitle,
                       'Fast, accessible sites your team can update without calling a developer.' as text,
                       'Our services' as button_label,
                       '#services' as button_link,
                       null as button2_label,
                       null as button2_link,
                       'website-studio/img/studio-hero-2.jpg' as image_file,
                       'A long, bright studio floor' as image_alt,
                       null as image_position,
                       2 as sort_order
                  from dual
                union all
                select 'From first sketch to *global* launch.' as title,
                       'Since 2011' as subtitle,
                       'One senior team from kickoff to the day you go live, and after.' as text,
                       'Start a project' as button_label,
                       '#contact' as button_link,
                       null as button2_label,
                       null as button2_link,
                       'website-studio/img/studio-hero-3.jpg' as image_file,
                       'Sketching a user flow on a whiteboard' as image_alt,
                       null as image_position,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: hero
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--none
                ws-Width--full
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: hero
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-hero
            templateOptions: [
                #DEFAULT#
                ws-Hero--zoom
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column TITLE (
            layout {
                sequence: 10
            }
        )

        column SUBTITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column BUTTON_LABEL (
            layout {
                sequence: 40
            }
        )

        column BUTTON_LINK (
            layout {
                sequence: 50
            }
        )

        column BUTTON2_LABEL (
            layout {
                sequence: 60
            }
        )

        column BUTTON2_LINK (
            layout {
                sequence: 70
            }
        )

        column IMAGE_FILE (
            layout {
                sequence: 80
            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 90
            }
        )

        column IMAGE_POSITION (
            layout {
                sequence: 100
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 110
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region clients (
        name: Trusted by teams at
        title: Trusted by teams at
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Northpeak' as name,
                       1 as sort_order
                  from dual
                union all
                select 'Orbital' as name,
                       2 as sort_order
                  from dual
                union all
                select 'Lumen Bank' as name,
                       3 as sort_order
                  from dual
                union all
                select 'Kestrel' as name,
                       4 as sort_order
                  from dual
                union all
                select 'Fieldnote' as name,
                       5 as sort_order
                  from dual
                union all
                select 'Vantage' as name,
                       6 as sort_order
                  from dual
                union all
                select 'Tidewater' as name,
                       7 as sort_order
                  from dual
                union all
                select 'Monogram' as name,
                       8 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--tight
                ws-Head--center
            ]
            cssClasses: ws-Sec--small
        }
        advanced {
            htmlDomId: clients
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-logos
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column NAME (
            layout {
                sequence: 10
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 20
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region about (
        name: About
        title: About us
        type: staticContent
        source {
            htmlCode:
                ```
                <div class="ws-Split">
                  <div class="ws-Media" data-file="website-studio/img/studio-about.jpg" role="img" aria-label="The Halcyon studio in Lisbon"></div>
                  <div class="ws-Stack">
                    <p class="ws-Eyebrow">About us</p>
                    <h2 class="ws-Title">A small studio with a *long* memory.</h2>
                    <p class="ws-Lead">We started Halcyon in 2011 in a two-desk room above a bakery in Alfama. Today we are 24 people across Lisbon and Porto, and we still sketch every idea on paper first.</p>
                    <p class="ws-Muted">We work with a handful of clients at a time, so the people you meet in the pitch are the people who do the work.</p>
                    <ul class="ws-Checks">
                      <li>Senior team on every project</li>
                      <li>Strategy, identity, web and product under one roof</li>
                      <li>Carbon-neutral studio since 2020</li>
                    </ul>
                    <a class="ws-More" href="#team">Meet the team</a>
                  </div>
                </div>
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: about
            customAttributes: data-menu="About"
        }
    )

    region numbers (
        name: Halcyon in numbers
        title: Halcyon in numbers
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select '140' as value,
                       '+' as suffix,
                       'Brands launched' as label,
                       1 as sort_order
                  from dual
                union all
                select '13' as value,
                       null as suffix,
                       'Years in business' as label,
                       2 as sort_order
                  from dual
                union all
                select '24' as value,
                       null as suffix,
                       'People in the studio' as label,
                       3 as sort_order
                  from dual
                union all
                select '98' as value,
                       '%' as suffix,
                       'Clients who come back' as label,
                       4 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Tone--soft
                ws-Pad--tight
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: numbers
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-stats
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column VALUE (
            layout {
                sequence: 10
            }
        )

        column SUFFIX (
            layout {
                sequence: 20
            }
        )

        column LABEL (
            layout {
                sequence: 30
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 40
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region services (
        name: Services
        title: Six disciplines, *one* team.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'fa-compass' as icon,
                       'Brand strategy' as title,
                       'Positioning, naming and messaging grounded in interviews with your customers.' as text,
                       null as link,
                       null as link_label,
                       1 as sort_order
                  from dual
                union all
                select 'fa-magic' as icon,
                       'Visual identity' as title,
                       'Logos, type, colour and motion systems that hold up from favicon to billboard.' as text,
                       null as link,
                       null as link_label,
                       2 as sort_order
                  from dual
                union all
                select 'fa-code' as icon,
                       'Websites' as title,
                       'Fast, accessible marketing sites built on a CMS your team can actually use.' as text,
                       '#work' as link,
                       'See websites we built' as link_label,
                       3 as sort_order
                  from dual
                union all
                select 'fa-object-group' as icon,
                       'Product design' as title,
                       'Interfaces and design systems for web and mobile apps, tested with real users.' as text,
                       null as link,
                       null as link_label,
                       4 as sort_order
                  from dual
                union all
                select 'fa-line-chart' as icon,
                       'Content and growth' as title,
                       'Editorial calendars, campaign art and landing pages that convert.' as text,
                       null as link,
                       null as link_label,
                       5 as sort_order
                  from dual
                union all
                select 'fa-users' as icon,
                       'Workshops' as title,
                       'Half-day sessions that get founders and teams aligned before a rebrand.' as text,
                       null as link,
                       null as link_label,
                       6 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 60
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
            ]
        }
        advanced {
            htmlDomId: services
            customAttributes: data-menu="Services"
        }
        headerAndFooter {
            headerText: <p class="ws-Eyebrow">What we do</p><p class="ws-Lead">Most of our clients start with one project and stay for three. Here is where we can help.</p>
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-features
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

