    region faq (
        name: Questions we often hear
        title: Questions we *often* hear
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'How long does a typical project take?' as question,
                       'A brand sprint takes two weeks. A full identity and website usually takes ten to fourteen weeks from kickoff to launch.' as answer,
                       1 as sort_order
                  from dual
                union all
                select 'Do you work with clients outside Portugal?' as question,
                       'Yes. About half of our clients are elsewhere in Europe and North America. We run most sessions remotely and travel for key workshops.' as answer,
                       2 as sort_order
                  from dual
                union all
                select 'Can we update the website ourselves?' as question,
                       'Always. We build on a CMS your team can edit and include a recorded training session with every site.' as answer,
                       3 as sort_order
                  from dual
                union all
                select 'Do you offer payment in instalments?' as question,
                       'Yes. Projects are billed in three parts: at kickoff, at design approval and at launch.' as answer,
                       4 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 150
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Tone--soft
                ws-Head--center
            ]
        }
