    region contact-details (
        name: Contact Details
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'fa-envelope-o' as icon,
                       'Email' as label,
                       'hello@example.com' as value,
                       'mailto:hello@example.com' as link,
                       1 as sort_order
                  from dual
                union all
                select 'fa-phone' as icon,
                       'Phone' as label,
                       '+351 21 000 4821' as value,
                       'tel:+351210004821' as link,
                       2 as sort_order
                  from dual
                union all
                select 'fa-map-marker' as icon,
                       'Studio' as label,
                       'Rua da Saudade 18, Lisboa' as value,
                       'https://www.openstreetmap.org/search?query=Rua%20da%20Saudade%2018%20Lisboa' as link,
                       3 as sort_order
                  from dual
                union all
                select 'fa-clock-o' as icon,
                       'Hours' as label,
                       'Mon to Thu, 9:00 to 18:00' as value,
                       null as link,
                       4 as sort_order
                  from dual
                order by sort_order
