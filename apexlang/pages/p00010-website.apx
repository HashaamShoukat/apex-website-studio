    region pricing (
        name: Pricing
        title: Simple, *fixed* prices
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Brand Sprint' as name,
                       'EUR 6,900' as price,
                       'one-off' as period,
                       'For new companies that need to look credible, fast.' as description,
                       'Two-week sprint|Logo and word mark|Colour and type system|One-page guidelines' as features,
                       'Book a sprint' as button_label,
                       '#contact' as button_link,
                       'N' as is_featured,
                       null as badge,
                       1 as sort_order
                  from dual
                union all
                select 'Brand and Website' as name,
                       'EUR 18,500' as price,
                       'one-off' as period,
                       'Our most popular project: a full identity and a site to launch it.' as description,
                       'Strategy workshop|Complete visual identity|8-page website on your CMS|Full guidelines and assets|60 days of launch support' as features,
                       'Start a project' as button_label,
                       '#contact' as button_link,
                       'Y' as is_featured,
                       'Most popular' as badge,
                       2 as sort_order
                  from dual
                union all
                select 'Partnership' as name,
                       'EUR 4,200' as price,
                       'per month' as period,
                       'A senior team on call for ongoing design and campaigns.' as description,
                       'Up to 40 hours a month|Dedicated designer and strategist|Monthly planning session|Cancel with 30 days notice' as features,
                       'Talk to us' as button_label,
                       '#contact' as button_link,
                       'N' as is_featured,
                       null as badge,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 140
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Head--center
            ]
        }
        advanced {
            htmlDomId: pricing
            customAttributes: data-menu="Pricing"
        }
        headerAndFooter {
            headerText: <p class="ws-Eyebrow">Pricing</p><p class="ws-Lead">Every engagement has a fixed fee agreed up front. No hourly billing, no surprise invoices.</p>
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-pricing
            templateOptions: [
                #DEFAULT#
                ws-Plans--lift
            ]
        }
