            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 70
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 80
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region numbers (
        name: Meridian in numbers
        title: Meridian in numbers
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select '26' as value,
                       'Years in business' as label,
                       null as suffix,
                       1 as sort_order
                  from dual
                union all
                select '410' as value,
                       'Engineers and advisers' as label,
                       null as suffix,
                       2 as sort_order
                  from dual
                union all
                select '1200' as value,
                       'Projects delivered' as label,
                       '+' as suffix,
                       3 as sort_order
                  from dual
                union all
                select '14' as value,
                       'Countries' as label,
                       null as suffix,
                       4 as sort_order
                  from dual
                order by sort_order
                ```
