            customAttributes: data-menu="Services"
        }
        headerAndFooter {
            headerText: <p class="ws-Eyebrow">Services</p><p class="ws-Lead">Three practices that work as one team from the first study to the last inspection.</p>
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-features
            templateOptions: [
                #DEFAULT#
                ws-Features--rows
            ]
