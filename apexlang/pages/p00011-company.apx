    region news (
        name: Insights
        title: Latest *insights*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'What digital twins changed on the Atlas Rail extension' as title,
                       'Two years in, the model has saved four months of site work. Here is what we learned.' as text,
                       '12 Oct 2026' as post_date,
                       'Case study' as category,
                       '#' as link,
                       'website-studio/img/news-1.jpg' as image_file,
                       'Charts on a laptop' as image_alt,
                       1 as sort_order
                  from dual
                union all
                select 'Meridian opens a Rotterdam office' as title,
                       'Forty engineers join to lead our water and port work in Northern Europe.' as text,
                       '28 Sep 2026' as post_date,
                       'News' as category,
                       '#' as link,
                       'website-studio/img/news-2.jpg' as image_file,
                       'An open-plan office' as image_alt,
                       2 as sort_order
                  from dual
                union all
                select 'Five questions to ask before a feasibility study' as title,
                       'A short guide for project owners from our advisory practice.' as text,
                       '3 Sep 2026' as post_date,
                       'Guide' as category,
                       '#' as link,
                       'website-studio/img/news-3.jpg' as image_file,
                       'A presentation in a meeting room' as image_alt,
                       3 as sort_order
                  from dual
