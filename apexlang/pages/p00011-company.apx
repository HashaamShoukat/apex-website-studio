page 11 (
    name: Starter - Company
    alias: COMPANY
    title: Meridian Partners - Engineering and Advisory
    appearance {
        pageTemplate: @modern-one-page
        templateOptions: [
            #DEFAULT#
            ws-Design--corporate
            ws-Accent--indigo
            ws-Font--tech
            ws-Header--centered
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    htmlHeader {
        htmlHeader:
            ```html
            <meta name="description" content="Meridian Partners plans, builds and runs infrastructure for cities, utilities and industry across the Gulf and Europe.">
            <meta property="og:type" content="website">
            <meta property="og:title" content="Meridian Partners - Engineering and Advisory">
            <meta property="og:description" content="Meridian Partners plans, builds and runs infrastructure for cities, utilities and industry across the Gulf and Europe.">
            <meta property="og:image" content="#APP_FILES#website-studio/img/company-hero.jpg">
            <meta name="twitter:card" content="summary_large_image">
            <link rel="preload" as="image" href="#APP_FILES#website-studio/img/company-hero.jpg" fetchpriority="high">
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hero (
        name: Meridian
        title: Meridian
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Infrastructure that *lasts* a generation.' as title,
                       'Engineering and advisory since 1998' as subtitle,
                       'We plan, build and run the roads, grids and water networks that cities depend on.' as text,
                       'Our services' as button_label,
                       '#services' as button_link,
                       'Talk to an expert' as button2_label,
                       '#contact' as button2_link,
                       'website-studio/img/company-hero.jpg' as image_file,
                       'Modern office towers' as image_alt,
                       1 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: hero
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--none
                ws-Width--full
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: hero
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-hero
            templateOptions: [
                #DEFAULT#
                ws-Hero--zoom
                ws-Hero--split
                ws-Hero--medium
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column TITLE (
            layout {
                sequence: 10
            }
        )

        column SUBTITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column BUTTON_LABEL (
            layout {
                sequence: 40
            }
        )

        column BUTTON_LINK (
            layout {
                sequence: 50
            }
        )

        column BUTTON2_LABEL (
            layout {
                sequence: 60
            }
        )

        column BUTTON2_LINK (
            layout {
                sequence: 70
            }
        )

        column IMAGE_FILE (
            layout {
                sequence: 80
            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 90
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 100
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region clients (
        name: Trusted by
        title: Trusted by
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Gulf Water' as name,
                       1 as sort_order
                  from dual
                union all
                select 'Atlas Rail' as name,
                       2 as sort_order
                  from dual
                union all
                select 'Northgrid' as name,
                       3 as sort_order
                  from dual
                union all
                select 'City of Lumen' as name,
                       4 as sort_order
                  from dual
                union all
                select 'Harborline' as name,
                       5 as sort_order
                  from dual
                union all
                select 'Petra Energy' as name,
                       6 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--tight
                ws-Head--center
            ]
            cssClasses: ws-Sec--small
        }
        advanced {
            htmlDomId: clients
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-logos
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column NAME (
            layout {
                sequence: 10
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 20
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region about (
        name: About
        title: Who we are
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'About us' as eyebrow,
                       'Four hundred engineers, *one* standard.' as title,
                       'From offices in Riyadh, Dubai and Rotterdam we work with public and private clients on projects that must still work in fifty years.' as text,
                       '#team' as link,
                       'Meet the leadership' as link_label,
                       'website-studio/img/company-team.jpg' as image_file,
                       'Colleagues working on laptops' as image_alt,
                       1 as sort_order
                  from dual
                union all
                select 'How we work' as eyebrow,
                       'Plan first, build once.' as title,
                       'Every project starts with a digital model of the asset, so cost, risk and carbon are clear before the first contract is signed.' as text,
                       '#services' as link,
                       'Our services' as link_label,
                       'website-studio/img/company-plan.jpg' as image_file,
                       'Planning notes next to a laptop' as image_alt,
                       2 as sort_order
                  from dual
                union all
                select 'Sustainability' as eyebrow,
                       'Net zero on our own sites by *2030*.' as title,
                       'We publish our emissions every year and design every project to the lowest carbon option the client can afford.' as text,
                       null as link,
                       null as link_label,
                       'website-studio/img/company-meeting.jpg' as image_file,
                       'A talk in an open office' as image_alt,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: about
            customAttributes: data-menu="About"
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-zigzag
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column EYEBROW (
            layout {
                sequence: 10
            }
        )

        column TITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column LINK (
            layout {
                sequence: 40
            }
        )

        column LINK_LABEL (
            layout {
