    region contact-details (
        name: Contact Details
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'fa-phone' as icon,
                       'Reservations' as label,
                       '+966 11 000 7788' as value,
                       'tel:+966110007788' as link,
                       1 as sort_order
                  from dual
                union all
                select 'fa-envelope-o' as icon,
                       'Email' as label,
                       'ciao@example.com' as value,
                       'mailto:ciao@example.com' as link,
                       2 as sort_order
                  from dual
                union all
                select 'fa-map-marker' as icon,
                       'Address' as label,
                       '12 Olive Street, Old Town' as value,
                       null as link,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 10
            parentRegion: @contact
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: contact-details
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-contact
            templateOptions: [
                #DEFAULT#
            ]
        }
