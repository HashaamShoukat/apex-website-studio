    region evenings (
        name: Evenings
        title: Special *evenings*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select '14 Nov' as event_date,
                       '19:00' as event_time,
                       'Truffle supper' as title,
                       'Five courses with white truffle from Alba.' as text,
                       'Long table' as location,
                       '#contact' as link,
                       'Reserve' as link_label,
                       1 as sort_order
                  from dual
                union all
                select '28 Nov' as event_date,
                       '18:30' as event_time,
                       'Pasta class' as title,
                       'Learn to roll tagliatelle with our chef, then eat what you made.' as text,
                       'Kitchen' as location,
                       '#contact' as link,
                       'Reserve' as link_label,
                       2 as sort_order
                  from dual
                union all
                select '12 Dec' as event_date,
                       '20:00' as event_time,
                       'Winter jazz night' as title,
                       'A trio in the bar and a short sharing menu.' as text,
                       'Bar' as location,
                       '#contact' as link,
                       'Reserve' as link_label,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
