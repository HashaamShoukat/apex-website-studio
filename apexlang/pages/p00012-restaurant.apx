    region hours (
        name: Opening hours
        title: Opening *hours*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Monday' as day_name,
                       'Closed' as hours,
                       '1' as day_number,
                       null as note,
                       1 as sort_order
                  from dual
                union all
                select 'Tuesday' as day_name,
                       '18:00 - 23:00' as hours,
                       '2' as day_number,
                       null as note,
                       2 as sort_order
                  from dual
                union all
                select 'Wednesday' as day_name,
                       '18:00 - 23:00' as hours,
                       '3' as day_number,
                       null as note,
                       3 as sort_order
                  from dual
                union all
                select 'Thursday' as day_name,
                       '18:00 - 23:30' as hours,
                       '4' as day_number,
                       null as note,
                       4 as sort_order
                  from dual
                union all
                select 'Friday' as day_name,
                       '13:00 - 00:00' as hours,
                       '5' as day_number,
                       'Lunch from 13:00' as note,
                       5 as sort_order
                  from dual
                union all
                select 'Saturday' as day_name,
                       '13:00 - 00:00' as hours,
                       '6' as day_number,
                       null as note,
                       6 as sort_order
                  from dual
                union all
                select 'Sunday' as day_name,
                       '13:00 - 22:00' as hours,
                       '7' as day_number,
                       'Family lunch' as note,
                       7 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Head--center
                ws-Width--narrow
            ]
        }
        advanced {
            htmlDomId: hours
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-hours
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column DAY_NAME (
            layout {
                sequence: 10
            }
        )

        column HOURS (
            layout {
                sequence: 20
            }
        )

        column DAY_NUMBER (
            layout {
                sequence: 30
            }
        )

        column NOTE (
            layout {
                sequence: 40
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 50
            }
            sorting {
                defaultSequence: 1
            }
        )
