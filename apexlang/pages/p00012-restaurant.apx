    button send (
        buttonName: SEND
        label: Request a table
        layout {
            sequence: 60
            region: @contact
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
        }
    )

    process send-message (
        name: Send Message
        type: executeCode
        source {
            location: localDatabase
            language: plsql
            plsqlCode:
                ```
                -- P12_WEBSITE is a hidden honeypot field: people leave it empty, spam robots fill it in.
                if :P12_WEBSITE is null then
                    -- The starter only says thank you: NOTHING IS SENT OR STORED until you add your own code here.
                    -- When you do, remove the "(Demo: ...)" note from this process's Success Message.
                    -- To receive the message by email, use for example:
                    -- apex_mail.send(p_to   => 'hello@example.com',
                    --                p_from => 'noreply@example.com',
                    --                p_subj => 'Website message from ' || :P12_NAME,
                    --                p_body => :P12_MESSAGE || chr(10) || chr(10) || :P12_NAME || ', ' || :P12_EMAIL || ', ' || :P12_PHONE);
                    -- apex_mail.push_queue;
                    null;
                end if;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Thank you. We will confirm your table by phone within the hour. (Demo: nothing was sent or stored yet.)
        }
        serverSideCondition {
            whenButtonPressed: @send
        }
    )

    branch back-to-website (
        name: Back to the Website
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 12
            }
        }
    )

)
