                       'Regulars' as role,
                       '5' as rating,
                       2 as sort_order
                  from dual
                union all
                select 'Warm room, honest food, fair prices. Book ahead on Fridays.' as quote,
                       'James P.' as name,
                       'Tripadvisor' as role,
                       '4' as rating,
