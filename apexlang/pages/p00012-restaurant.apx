page 12 (
    name: Starter - Restaurant
    alias: RESTAURANT
    title: Osteria Lume - Italian Kitchen and Wine Bar
    appearance {
        pageTemplate: @modern-one-page
        templateOptions: [
            #DEFAULT#
            ws-Design--organic
            ws-Accent--wine
            ws-Font--serif
            ws-Header--transparent
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    htmlHeader {
        htmlHeader:
            ```html
            <meta name="description" content="Seasonal Italian cooking, wood-fired bread and natural wine in the heart of the old town. Book a table online.">
            <meta property="og:type" content="website">
            <meta property="og:title" content="Osteria Lume - Italian Kitchen and Wine Bar">
            <meta property="og:description" content="Seasonal Italian cooking, wood-fired bread and natural wine in the heart of the old town. Book a table online.">
            <meta property="og:image" content="#APP_FILES#website-studio/img/food-hero-1.jpg">
            <meta name="twitter:card" content="summary_large_image">
            <link rel="preload" as="image" href="#APP_FILES#website-studio/img/food-hero-1.jpg" fetchpriority="high">
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hero (
        name: Osteria Lume
        title: Osteria Lume
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Slow food, *good* wine, long evenings.' as title,
                       'Italian kitchen and wine bar' as subtitle,
                       'Seasonal plates from a small kitchen, open every evening from six.' as text,
                       'Book a table' as button_label,
                       '#contact' as button_link,
                       'See the menu' as button2_label,
                       '#menu' as button2_link,
                       'website-studio/img/food-hero-1.jpg' as image_file,
                       'A plated dish at a set table' as image_alt,
                       1 as sort_order
                  from dual
                union all
                select 'A dining room made for *sharing*.' as title,
                       'Since 2014' as subtitle,
                       'Forty seats, one long table and a bar for walk-ins.' as text,
                       'Plan your visit' as button_label,
                       '#visit' as button_link,
                       null as button2_label,
                       null as button2_link,
                       'website-studio/img/food-hero-2.jpg' as image_file,
                       'The dining room in the evening' as image_alt,
                       2 as sort_order
                  from dual
                union all
                select 'Everything made *here*, every day.' as title,
                       'From our kitchen' as subtitle,
                       'Pasta rolled each morning, bread from our wood oven.' as text,
                       'Our story' as button_label,
                       '#story' as button_link,
                       null as button2_label,
                       null as button2_link,
                       'website-studio/img/food-hero-3.jpg' as image_file,
                       'Two cooks laughing in the kitchen' as image_alt,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: hero
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--none
                ws-Width--full
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: hero
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-hero
            templateOptions: [
                #DEFAULT#
                ws-Hero--zoom
                ws-Hero--fullbleed
                ws-Hero--full
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column TITLE (
            layout {
                sequence: 10
            }
        )

        column SUBTITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column BUTTON_LABEL (
            layout {
                sequence: 40
            }
        )

        column BUTTON_LINK (
            layout {
                sequence: 50
            }
        )

        column BUTTON2_LABEL (
            layout {
                sequence: 60
            }
        )

        column BUTTON2_LINK (
            layout {
                sequence: 70
            }
        )

        column IMAGE_FILE (
            layout {
                sequence: 80
            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 90
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 100
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region today (
        name: Today at Lume
        title: Today at Lume
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Pasta rolled every morning' as text,
                       'fa-cutlery' as icon,
                       null as link,
                       1 as sort_order
                  from dual
                union all
                select 'Bread from our wood oven' as text,
                       null as icon,
                       null as link,
                       2 as sort_order
                  from dual
                union all
                select 'Open every evening from six' as text,
                       null as icon,
                       null as link,
                       3 as sort_order
                  from dual
                union all
                select 'Family lunch on Sundays' as text,
                       null as icon,
                       null as link,
                       4 as sort_order
                  from dual
                union all
                select 'Book the long table for twelve' as text,
                       null as icon,
                       '#contact' as link,
                       5 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--none
                ws-Width--full
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: today
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-ticker
            templateOptions: [
                #DEFAULT#
                ws-Speed--slow
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column TEXT (
            layout {
                sequence: 10
            }
        )

        column ICON (
            layout {
                sequence: 20
            }
        )

        column LINK (
            layout {
                sequence: 30
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 40
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region story (
        name: Our story
        title: Our story
        type: staticContent
        source {
            htmlCode:
                ```
                <div class="ws-Split">
                  <div class="ws-Media" data-file="website-studio/img/food-about.jpg" role="img" aria-label="Plates shared across the table"></div>
                  <div class="ws-Stack">
                    <p class="ws-Eyebrow">Our story</p>
                    <h2 class="ws-Title">A small kitchen with a *big* table.</h2>
                    <p class="ws-Lead">Chef Marco and Hala opened Lume in 2014 with one oven, six tables and recipes from Marco's grandmother in Bologna.</p>
                    <p class="ws-Muted">We buy from local farms and the morning fish market, so the menu is short and changes every week.</p>
                    <a class="ws-More" href="#menu">See tonight's menu</a>
                  </div>
                </div>
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: story
            customAttributes: data-menu="Our story"
        }
    )

    region menu (
        name: Menu
        title: The *menu*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Garden bowl' as name,
                       'Grilled halloumi, soft egg, sweetcorn, greens' as text,
                       'SAR 58' as price,
                       'Starters' as category,
                       'website-studio/img/dish-2.jpg' as image_file,
                       'A bowl of grilled halloumi, egg and greens' as image_alt,
                       null as badge,
                       1 as sort_order
                  from dual
                union all
                select 'Roasted salmon' as name,
                       'Summer vegetables, lemon and herb dressing' as text,
                       'SAR 124' as price,
                       'Mains' as category,
                       'website-studio/img/dish-1.jpg' as image_file,
                       'Roasted salmon with summer vegetables' as image_alt,
                       'Chef''s choice' as badge,
                       2 as sort_order
                  from dual
                union all
                select 'Margherita from the wood oven' as name,
                       'San Marzano tomato, fior di latte' as text,
                       'SAR 72' as price,
                       'Mains' as category,
                       'website-studio/img/dish-3.jpg' as image_file,
                       'Wood-fired pizza' as image_alt,
                       null as badge,
                       3 as sort_order
                  from dual
                union all
                select 'Spaghetti with prawns' as name,
                       'Cherry tomatoes, chilli, parsley' as text,
                       'SAR 84' as price,
                       'Mains' as category,
                       'website-studio/img/dish-5.jpg' as image_file,
                       'Spaghetti with prawns and cherry tomatoes' as image_alt,
                       null as badge,
                       4 as sort_order
                  from dual
                union all
                select 'Dark chocolate torta' as name,
                       'Olive oil, sea salt, cream' as text,
                       'SAR 42' as price,
                       'Desserts' as category,
                       'website-studio/img/dish-4.jpg' as image_file,
                       'A chocolate dessert' as image_alt,
                       null as badge,
                       5 as sort_order
                  from dual
                union all
                select 'Espresso or cappuccino' as name,
                       'Until noon at the bar' as text,
                       'SAR 26' as price,
                       'Desserts' as category,
                       'website-studio/img/dish-6.jpg' as image_file,
                       'Cups of coffee with latte art' as image_alt,
                       null as badge,
                       6 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Tone--soft
                ws-Head--center
            ]
        }
        advanced {
            htmlDomId: menu
            customAttributes: data-menu="Menu"
        }
        headerAndFooter {
            headerText: <p class="ws-Eyebrow">Tonight</p><p class="ws-Lead">The menu changes with the market. Ask us about allergies: most dishes can be adapted.</p>
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-products
            templateOptions: [
                #DEFAULT#
                ws-Filter
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column NAME (
            layout {
                sequence: 10
            }
        )

        column TEXT (
            layout {
                sequence: 20
            }
        )

        column PRICE (
            layout {
                sequence: 30
            }
        )

        column CATEGORY (
            layout {
                sequence: 40
            }
        )

        column IMAGE_FILE (
            layout {
                sequence: 50
            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 60
            }
        )

        column BADGE (
            layout {
                sequence: 70
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 80
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region gallery (
        name: Gallery
