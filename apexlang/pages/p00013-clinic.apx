    region contact-details (
        name: Contact Details
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'fa-phone' as icon,
                       'الهاتف' as label,
                       '٩٢٠٠٠٠٠٠٠' as value,
                       'tel:920000000' as link,
                       1 as sort_order
                  from dual
                union all
                select 'fa-whatsapp' as icon,
                       'واتساب' as label,
                       '+966 50 000 0000' as value,
                       'https://wa.me/966500000000' as link,
                       2 as sort_order
                  from dual
                union all
                select 'fa-map-marker' as icon,
                       'العنوان' as label,
                       'حي الياسمين، الرياض' as value,
                       null as link,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 10
            parentRegion: @contact
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: contact-details
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-contact
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column ICON (
            layout {
                sequence: 10
            }
        )

        column LABEL (
            layout {
                sequence: 20
            }
        )

        column VALUE (
            layout {
                sequence: 30
            }
        )

        column LINK (
            layout {
                sequence: 40
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 50
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

