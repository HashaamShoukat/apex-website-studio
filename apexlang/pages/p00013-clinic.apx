    region hours (
        name: أوقات العمل
        title: أوقات *العمل*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'الأحد' as day_name,
                       '٨:٠٠ ص - ١١:٠٠ م' as hours,
                       null as note,
                       '7' as day_number,
                       1 as sort_order
                  from dual
                union all
                select 'الاثنين' as day_name,
                       '٨:٠٠ ص - ١١:٠٠ م' as hours,
                       null as note,
                       '1' as day_number,
                       2 as sort_order
                  from dual
                union all
                select 'الثلاثاء' as day_name,
                       '٨:٠٠ ص - ١١:٠٠ م' as hours,
                       null as note,
                       '2' as day_number,
                       3 as sort_order
                  from dual
                union all
                select 'الأربعاء' as day_name,
                       '٨:٠٠ ص - ١١:٠٠ م' as hours,
                       null as note,
                       '3' as day_number,
                       4 as sort_order
                  from dual
                union all
                select 'الخميس' as day_name,
                       '٨:٠٠ ص - ١١:٠٠ م' as hours,
                       'حتى منتصف الليل للطوارئ' as note,
                       '4' as day_number,
                       5 as sort_order
                  from dual
                union all
                select 'الجمعة' as day_name,
                       'مغلق' as hours,
                       null as note,
                       '5' as day_number,
                       6 as sort_order
                  from dual
                union all
                select 'السبت' as day_name,
                       '٤:٠٠ م - ١١:٠٠ م' as hours,
                       null as note,
                       '6' as day_number,
                       7 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Tone--soft
                ws-Head--center
            ]
        }
        advanced {
            htmlDomId: hours
            customAttributes: data-menu="أوقات العمل"
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-hours
            templateOptions: [
                #DEFAULT#
                ws-Hours--cards
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column DAY_NAME (
            layout {
                sequence: 10
            }
        )

        column HOURS (
            layout {
                sequence: 20
            }
        )

        column NOTE (
            layout {
                sequence: 30
            }
        )

        column DAY_NUMBER (
            layout {
                sequence: 40
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 50
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region reviews (
        name: آراء المرضى
