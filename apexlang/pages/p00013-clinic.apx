                       'website-studio/img/clinic-room.jpg' as image_file,
                       'غرفة كشف مضيئة' as image_alt,
                       1 as sort_order
                  from dual
                union all
                select 'التقنية' as eyebrow,
                       'ملفك الطبي معك أينما كنت.' as title,
                       'احجز موعدك، واطلع على نتائجك ووصفاتك من جوالك في أي وقت.' as text,
                       null as link,
                       null as link_label,
                       'website-studio/img/clinic-lab.jpg' as image_file,
                       'مختبر بأجهزة حديثة' as image_alt,
                       2 as sort_order
                  from dual
