                select 'استقبال رائع ومواعيد دقيقة، والدكتورة نورة شرحت لي كل شيء بهدوء.' as quote,
                       'أم فيصل' as name,
                       'مريضة منذ ٢٠١٨' as role,
                       '5' as rating,
                       1 as sort_order
                  from dual
                union all
                select 'نتيجة التحليل وصلتني على الجوال في نفس اليوم. خدمة ممتازة.' as quote,
                       'عبدالله م.' as name,
                       'مراجع' as role,
