    button send (
        buttonName: SEND
        label: إرسال الطلب
        layout {
            sequence: 60
            region: @contact
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
        }
    )

    process send-message (
        name: Send Message
        type: executeCode
        source {
            location: localDatabase
            language: plsql
            plsqlCode:
                ```
                -- P13_WEBSITE is a hidden honeypot field: people leave it empty, spam robots fill it in.
                if :P13_WEBSITE is null then
                    -- The starter only says thank you. To receive the message by email, use for example:
                    -- apex_mail.send(p_to   => 'hello@example.com',
                    --                p_from => 'noreply@example.com',
                    --                p_subj => 'Website message from ' || :P13_NAME,
                    --                p_body => :P13_MESSAGE || chr(10) || chr(10) || :P13_NAME || ', ' || :P13_EMAIL || ', ' || :P13_PHONE);
                    -- apex_mail.push_queue;
                    null;
                end if;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: شكرا لك. سنتصل بك قريبا لتأكيد الموعد.
        }
        serverSideCondition {
            whenButtonPressed: @send
        }
    )

    branch back-to-website (
        name: Back to the Website
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 13
            }
        }
    )

)
