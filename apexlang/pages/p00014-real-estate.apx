    region visit (
        name: Visit
        title: Visit our *office*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'https://www.openstreetmap.org/export/embed.html?bbox=46.66%2C24.69%2C46.70%2C24.72&layer=mapnik' as map_url,
                       'Harbor & Stone' as title,
                       'Tahlia Street 40, Riyadh' as address,
                       'Saturday to Thursday, 9:00 to 21:00' as text,
                       'https://www.openstreetmap.org/' as link,
                       'Directions' as link_label,
                       1 as sort_order
                  from dual
