page 14 (
    name: Starter - Real Estate
    alias: REAL-ESTATE
    title: Harbor & Stone - Homes for Sale and Rent
    appearance {
        pageTemplate: @modern-one-page
        templateOptions: [
            #DEFAULT#
            ws-Design--luxury
            ws-Accent--amber
            ws-Font--luxe
            ws-Header--transparent
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    htmlHeader {
        htmlHeader:
            ```html
            <meta name="description" content="Harbor &amp; Stone is a family-run estate agency: homes for sale and rent, valuations and property management.">
            <meta property="og:type" content="website">
            <meta property="og:title" content="Harbor &amp; Stone - Homes for Sale and Rent">
            <meta property="og:description" content="Harbor &amp; Stone is a family-run estate agency: homes for sale and rent, valuations and property management.">
            <meta property="og:image" content="#APP_FILES#website-studio/img/home-hero-1.jpg">
            <meta name="twitter:card" content="summary_large_image">
            <link rel="preload" as="image" href="#APP_FILES#website-studio/img/home-hero-1.jpg" fetchpriority="high">
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hero (
        name: Harbor & Stone
        title: Harbor & Stone
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Find a home you will *love* coming back to.' as title,
                       'Homes for sale and rent' as subtitle,
                       'Hand-picked houses and apartments, and agents who know every street.' as text,
                       'Browse homes' as button_label,
                       '#homes' as button_link,
                       'Book a valuation' as button2_label,
                       '#contact' as button2_link,
                       'website-studio/img/home-hero-1.jpg' as image_file,
                       'A modern white house with a pool' as image_alt,
                       1 as sort_order
                  from dual
                union all
                select 'Selling? We will get you *more*.' as title,
                       'Valuations' as subtitle,
                       'Our homes sell for 4% above asking on average.' as text,
                       'Free valuation' as button_label,
                       '#contact' as button_link,
                       null as button2_label,
                       null as button2_link,
                       'website-studio/img/home-hero-2.jpg' as image_file,
                       'A modern house at dusk' as image_alt,
                       2 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: hero
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--none
                ws-Width--full
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: hero
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-hero
            templateOptions: [
                #DEFAULT#
                ws-Hero--zoom
                ws-Hero--fullbleed
                ws-Hero--slide
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column TITLE (
            layout {
                sequence: 10
            }
        )

        column SUBTITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column BUTTON_LABEL (
            layout {
                sequence: 40
            }
        )

        column BUTTON_LINK (
            layout {
                sequence: 50
            }
        )

        column BUTTON2_LABEL (
            layout {
                sequence: 60
            }
        )

        column BUTTON2_LINK (
            layout {
                sequence: 70
            }
        )

        column IMAGE_FILE (
            layout {
                sequence: 80
            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 90
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 100
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region homes (
        name: Homes
        title: Featured *homes*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Garden house, Al Nakheel' as name,
                       '4 bedrooms - 3 bathrooms - 410 m2' as text,
                       'SAR 3,950,000' as price,
                       'For sale' as category,
                       'New' as badge,
                       'website-studio/img/home-1.jpg' as image_file,
                       'A family house with a garden' as image_alt,
                       1 as sort_order
                  from dual
                union all
                select 'Bright apartment, Olaya' as name,
                       '2 bedrooms - 2 bathrooms - 140 m2' as text,
                       'SAR 9,500 / month' as price,
                       'For rent' as category,
                       null as badge,
                       'website-studio/img/home-2.jpg' as image_file,
                       'A bright living room' as image_alt,
                       2 as sort_order
                  from dual
                union all
                select 'Penthouse with a view' as name,
                       '3 bedrooms - roof terrace - 220 m2' as text,
                       'SAR 4,600,000' as price,
                       'For sale' as category,
                       null as badge,
                       'website-studio/img/home-3.jpg' as image_file,
                       'A living room with plants' as image_alt,
                       3 as sort_order
                  from dual
                union all
                select 'Family villa, Hittin' as name,
                       '5 bedrooms - kitchen garden - 520 m2' as text,
                       'SAR 6,200,000' as price,
                       'New developments' as category,
                       'Off plan' as badge,
                       'website-studio/img/home-4.jpg' as image_file,
                       'A couple cooking in a bright kitchen' as image_alt,
                       4 as sort_order
                  from dual
                union all
                select 'Villa with pool' as name,
                       '6 bedrooms - pool - 680 m2' as text,
                       'SAR 28,000 / month' as price,
                       'For rent' as category,
                       null as badge,
                       'website-studio/img/home-5.jpg' as image_file,
                       'A house with a pool' as image_alt,
                       5 as sort_order
                  from dual
                union all
                select 'Garden villa, Diplomatic Quarter' as name,
                       '3 bedrooms - plunge pool - 260 m2' as text,
                       'SAR 2,850,000' as price,
                       'For sale' as category,
                       null as badge,
                       'website-studio/img/home-6.jpg' as image_file,
                       'A white house with a pool' as image_alt,
                       6 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Head--split
            ]
        }
        advanced {
            htmlDomId: homes
            customAttributes: data-menu="Homes"
        }
        headerAndFooter {
            headerText: <p class="ws-Eyebrow">Listings</p><p class="ws-Lead">New this week. Viewings in person or by video call.</p>
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-products
            templateOptions: [
                #DEFAULT#
                ws-Filter
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column NAME (
            layout {
                sequence: 10
            }
        )

        column TEXT (
            layout {
                sequence: 20
            }
        )

        column PRICE (
            layout {
                sequence: 30
            }
        )

        column CATEGORY (
            layout {
                sequence: 40
            }
        )

        column BADGE (
            layout {
                sequence: 50
            }
        )

        column IMAGE_FILE (
            layout {
                sequence: 60
            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 70
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 80
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region numbers (
        name: Harbor & Stone in numbers
        title: Harbor & Stone in numbers
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select '860' as value,
                       'Homes sold' as label,
                       null as suffix,
                       null as prefix,
                       1 as sort_order
                  from dual
                union all
                select '4' as value,
                       'Above asking, on average' as label,
                       '%' as suffix,
                       '+' as prefix,
                       2 as sort_order
                  from dual
                union all
                select '21' as value,
                       'Days to sell' as label,
                       null as suffix,
                       null as prefix,
                       3 as sort_order
                  from dual
                union all
                select '35' as value,
                       'Years in the city' as label,
                       null as suffix,
                       null as prefix,
                       4 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Tone--dark
                ws-Pad--tight
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: numbers
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-stats
            templateOptions: [
                #DEFAULT#
                ws-Stats--center
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column VALUE (
            layout {
                sequence: 10
            }
        )

        column LABEL (
            layout {
                sequence: 20
            }
        )

        column SUFFIX (
            layout {
                sequence: 30
            }
        )

        column PREFIX (
            layout {
                sequence: 40
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 50
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region services (
        name: Services
        title: How we help
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Buying' as eyebrow,
                       'We find it before it is *listed*.' as title,
                       'Tell us what you want and we call you first when a home matches, often before it reaches the portals.' as text,
                       '#contact' as link,
                       'Register your search' as link_label,
                       'website-studio/img/home-2.jpg' as image_file,
                       'A bright living room' as image_alt,
                       1 as sort_order
                  from dual
                union all
                select 'Selling' as eyebrow,
                       'Photography, staging and a *fair* fee.' as title,
                       'Professional photos, a floor plan and a video tour for every home. One fixed fee, paid only when you sell.' as text,
                       '#contact' as link,
                       'Book a valuation' as link_label,
                       'website-studio/img/home-4.jpg' as image_file,
                       'A couple cooking in a bright kitchen' as image_alt,
                       2 as sort_order
                  from dual
                union all
                select 'Renting' as eyebrow,
                       'Property management without the *worry*.' as title,
                       'Tenant checks, rent collection and repairs handled by a team you can call.' as text,
                       null as link,
                       null as link_label,
                       'website-studio/img/home-6.jpg' as image_file,
                       'A white house with a pool' as image_alt,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: services
            customAttributes: data-menu="Services"
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-zigzag
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column EYEBROW (
            layout {
                sequence: 10
            }
        )

        column TITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column LINK (
            layout {
                sequence: 40
            }
        )

        column LINK_LABEL (
            layout {
                sequence: 50
            }
        )

        column IMAGE_FILE (
            layout {
                sequence: 60
            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 70
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 80
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region agents (
        name: Agents
        title: Your *agents*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Hessa Al-Rashid' as name,
                       'Founder and Director' as role,
                       'https://www.linkedin.com/' as link,
                       'website-studio/img/person-5.jpg' as image_file,
                       'Portrait of a woman' as image_alt,
                       1 as sort_order
