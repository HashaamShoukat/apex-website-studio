                union all
                select 'Yousef Karim' as name,
                       'Sales' as role,
                       'https://www.linkedin.com/' as link,
                       'website-studio/img/person-4.jpg' as image_file,
                       'Portrait of a man in a grey sweater' as image_alt,
                       2 as sort_order
                  from dual
                union all
                select 'Clara Martins' as name,
                       'Lettings' as role,
                       'https://www.linkedin.com/' as link,
                       'website-studio/img/person-1.jpg' as image_file,
                       'Portrait of a woman smiling' as image_alt,
                       3 as sort_order
                  from dual
                union all
                select 'Majed Saleh' as name,
                       'Property management' as role,
                       'https://www.linkedin.com/' as link,
                       'website-studio/img/person-6.jpg' as image_file,
                       'Portrait of a man in a suit' as image_alt,
                       4 as sort_order
                  from dual
