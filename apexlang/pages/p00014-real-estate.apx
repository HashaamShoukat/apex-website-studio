    region social (
        name: Social Media
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Instagram' as label,
                       'https://www.instagram.com/' as link,
                       'fa-instagram' as icon,
                       1 as sort_order
                  from dual
                union all
                select 'LinkedIn' as label,
                       'https://www.linkedin.com/' as link,
                       'fa-linkedin' as icon,
                       2 as sort_order
                  from dual
                union all
                select 'YouTube' as label,
                       'https://www.youtube.com/' as link,
                       'fa-youtube-play' as icon,
                       3 as sort_order
                  from dual
                order by sort_order
