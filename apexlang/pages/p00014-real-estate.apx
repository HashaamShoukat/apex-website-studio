    region contact (
        name: Contact
        title: Book a free *valuation*
        type: staticContent
        layout {
            sequence: 90
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
            ]
            cssClasses: ws-Contact
        }
        advanced {
            htmlDomId: contact
            customAttributes: data-menu="Contact"
        }
        headerAndFooter {
            headerText: <p class="ws-Lead">An agent visits within 48 hours and gives you a written valuation.</p>
        }
    )

    region contact-details (
        name: Contact Details
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'fa-phone' as icon,
                       'Phone' as label,
                       '+966 11 000 2299' as value,
                       'tel:+966110002299' as link,
                       1 as sort_order
                  from dual
                union all
                select 'fa-envelope-o' as icon,
                       'Email' as label,
                       'homes@example.com' as value,
                       'mailto:homes@example.com' as link,
                       2 as sort_order
                  from dual
                union all
                select 'fa-map-marker' as icon,
                       'Office' as label,
                       'Tahlia Street 40, Riyadh' as value,
                       null as link,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 10
            parentRegion: @contact
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: contact-details
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
