    region faq (
        name: Questions
        title: Questions
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Can I get a refund?' as question,
                       'Tickets can be transferred to a colleague at any time, and refunded until 1 February.' as answer,
                       1 as sort_order
                  from dual
                union all
                select 'Will talks be recorded?' as question,
                       'Yes. Every ticket includes the recordings, available a week after the summit.' as answer,
                       2 as sort_order
                  from dual
                union all
                select 'Is there a dress code?' as question,
                       'No. Come as you are.' as answer,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
