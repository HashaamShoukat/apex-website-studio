    pageItem P15_WEBSITE (
        type: textField
        label {
            label: Leave this field empty
            alignment: left
        }
        layout {
            sequence: 50
            region: @contact
            slot: regionBody
            columnSpan: 12
            columnCssClasses: ws-Honeypot
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        advanced {
            customAttributes: tabindex="-1" autocomplete="off"
        }
        sessionState {
            storage: request
        }
    )

    button send (
        buttonName: SEND
        label: Send message
        layout {
            sequence: 60
            region: @contact
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
        }
    )

    process send-message (
        name: Send Message
        type: executeCode
        source {
            location: localDatabase
            language: plsql
            plsqlCode:
                ```
                -- P15_WEBSITE is a hidden honeypot field: people leave it empty, spam robots fill it in.
                if :P15_WEBSITE is null then
                    -- The starter only says thank you: NOTHING IS SENT OR STORED until you add your own code here.
                    -- When you do, remove the "(Demo: ...)" note from this process's Success Message.
                    -- To receive the message by email, use for example:
                    -- apex_mail.send(p_to   => 'hello@example.com',
                    --                p_from => 'noreply@example.com',
                    --                p_subj => 'Website message from ' || :P15_NAME,
                    --                p_body => :P15_MESSAGE || chr(10) || chr(10) || :P15_NAME || ', ' || :P15_EMAIL || ', ' || :P15_PHONE);
                    -- apex_mail.push_queue;
                    null;
                end if;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Thanks for your message. We will reply within one working day. (Demo: nothing was sent or stored yet.)
        }
        serverSideCondition {
            whenButtonPressed: @send
        }
    )

    branch back-to-website (
        name: Back to the Website
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 15
            }
        }
    )

)
