page 15 (
    name: Starter - Event
    alias: CONFERENCE
    title: Northwind Data Summit 2027 - 9 and 10 March, Riyadh
    appearance {
        pageTemplate: @modern-one-page
        templateOptions: [
            #DEFAULT#
            ws-Design--techgrid
            ws-Accent--cyan
            ws-Font--tech
            ws-Header--pill
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    htmlHeader {
        htmlHeader:
            ```html
            <meta name="description" content="Two days of talks and workshops on data, AI and the cloud. 40 speakers, 1,200 attendees. Early tickets on sale now.">
            <meta property="og:type" content="website">
            <meta property="og:title" content="Northwind Data Summit 2027 - 9 and 10 March, Riyadh">
            <meta property="og:description" content="Two days of talks and workshops on data, AI and the cloud. 40 speakers, 1,200 attendees. Early tickets on sale now.">
            <meta property="og:image" content="#APP_FILES#website-studio/img/event-hero-1.jpg">
            <meta name="twitter:card" content="summary_large_image">
            <link rel="preload" as="image" href="#APP_FILES#website-studio/img/event-hero-1.jpg" fetchpriority="high">
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hero (
        name: Northwind Data Summit
        title: Northwind Data Summit
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Where data people *meet*.' as title,
                       '9 - 10 March 2027 - Riyadh' as subtitle,
                       'Two days, 40 speakers and 1,200 engineers, analysts and leaders.' as text,
                       'Get tickets' as button_label,
                       '#tickets' as button_link,
                       'See the programme' as button2_label,
                       '#agenda' as button2_link,
                       'website-studio/img/event-hero-1.jpg' as image_file,
                       'A speaker on stage in front of an audience' as image_alt,
                       1 as sort_order
                  from dual
                union all
                select 'Workshops you can *use* on Monday.' as title,
                       'Hands-on' as subtitle,
                       'Twelve half-day workshops, limited to 30 seats each.' as text,
                       'View workshops' as button_label,
                       '#agenda' as button_link,
                       null as button2_label,
                       null as button2_link,
                       'website-studio/img/event-hero-2.jpg' as image_file,
                       'A conference audience' as image_alt,
                       2 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: hero
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--none
                ws-Width--full
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: hero
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-hero
            templateOptions: [
                #DEFAULT#
                ws-Hero--zoom
                ws-Hero--centered
                ws-Hero--strong
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column TITLE (
            layout {
                sequence: 10
            }
        )

        column SUBTITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column BUTTON_LABEL (
            layout {
                sequence: 40
            }
        )

        column BUTTON_LINK (
            layout {
                sequence: 50
            }
        )

        column BUTTON2_LABEL (
            layout {
                sequence: 60
            }
        )

        column BUTTON2_LINK (
            layout {
                sequence: 70
            }
        )

        column IMAGE_FILE (
            layout {
                sequence: 80
            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 90
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 100
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region countdown (
        name: Countdown
        title: Countdown
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select '2027-03-09T08:30:00+03:00' as target_date,
                       'Doors open in' as title,
                       '9 March 2027, 8:30 in the morning, Riyadh time.' as text,
                       'The summit has started. Welcome!' as done_text,
                       'Get tickets' as button_label,
                       '#tickets' as button_link,
                       1 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--tight
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: countdown
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-countdown
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column TARGET_DATE (
            layout {
                sequence: 10
            }
        )

        column TITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column DONE_TEXT (
            layout {
                sequence: 40
            }
        )

        column BUTTON_LABEL (
            layout {
                sequence: 50
            }
        )

        column BUTTON_LINK (
            layout {
                sequence: 60
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 70
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region numbers (
        name: The summit in numbers
        title: The summit in numbers
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select '40' as value,
                       'Speakers' as label,
                       1 as sort_order
                  from dual
                union all
                select '1200' as value,
                       'Attendees' as label,
                       2 as sort_order
                  from dual
                union all
                select '12' as value,
                       'Workshops' as label,
                       3 as sort_order
                  from dual
                union all
                select '2' as value,
                       'Days' as label,
                       4 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--tight
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: numbers
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-stats
            templateOptions: [
                #DEFAULT#
                ws-Stats--cards
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column VALUE (
            layout {
                sequence: 10
            }
        )

        column LABEL (
            layout {
                sequence: 20
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region agenda (
        name: Programme
        title: The *programme*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select '9 Mar' as event_date,
                       '09:30' as event_time,
                       'Opening keynote: the next ten years of data' as title,
                       'Rana Aziz' as speaker,
                       'Main hall' as location,
                       'Day 1' as category,
                       1 as sort_order
                  from dual
                union all
                select '9 Mar' as event_date,
                       '11:00' as event_time,
                       'Lakehouse or warehouse? Lessons from three migrations' as title,
                       'Tom Becker' as speaker,
                       'Hall B' as location,
                       'Day 1' as category,
                       2 as sort_order
                  from dual
                union all
                select '9 Mar' as event_date,
                       '14:00' as event_time,
                       'Workshop: building a RAG app on your own data' as title,
                       'Lina Park' as speaker,
                       'Lab 1' as location,
                       'Workshops' as category,
                       3 as sort_order
                  from dual
                union all
                select '10 Mar' as event_date,
                       '09:30' as event_time,
                       'Keynote: responsible AI in government' as title,
                       'Dr. Faisal Al-Mutairi' as speaker,
                       'Main hall' as location,
                       'Day 2' as category,
                       4 as sort_order
                  from dual
                union all
                select '10 Mar' as event_date,
                       '11:30' as event_time,
                       'Real-time analytics at national scale' as title,
                       'Aisha Rahman' as speaker,
                       'Hall B' as location,
                       'Day 2' as category,
                       5 as sort_order
                  from dual
                union all
                select '10 Mar' as event_date,
                       '14:00' as event_time,
                       'Workshop: data quality you can measure' as title,
                       'Marco Rossi' as speaker,
                       'Lab 2' as location,
                       'Workshops' as category,
                       6 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Head--split
            ]
        }
        advanced {
            htmlDomId: agenda
            customAttributes: data-menu="Programme"
        }
        headerAndFooter {
            headerText: <p class="ws-Eyebrow">Agenda</p><p class="ws-Lead">Doors open at 8:30 both days. All talks are in English with Arabic subtitles.</p>
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-events
            templateOptions: [
                #DEFAULT#
                ws-Filter
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column EVENT_DATE (
            layout {
                sequence: 10
            }
        )

        column EVENT_TIME (
            layout {
                sequence: 20
            }
        )

        column TITLE (
            layout {
                sequence: 30
            }
        )

        column SPEAKER (
            layout {
                sequence: 40
            }
        )

        column LOCATION (
            layout {
                sequence: 50
            }
        )

        column CATEGORY (
            layout {
                sequence: 60
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 70
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region speakers (
        name: Speakers
        title: Speakers
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Rana Aziz' as name,
                       'Chief Data Officer, Atlas Bank' as role,
                       'website-studio/img/person-5.jpg' as image_file,
                       'Portrait of a woman' as image_alt,
                       1 as sort_order
                  from dual
                union all
                select 'Tom Becker' as name,
                       'Principal Engineer, Orbital' as role,
                       'website-studio/img/person-4.jpg' as image_file,
                       'Portrait of a man in a grey sweater' as image_alt,
                       2 as sort_order
                  from dual
                union all
                select 'Lina Park' as name,
                       'AI Lead, Fieldnote' as role,
                       'website-studio/img/person-3.jpg' as image_file,
                       'Portrait of a woman' as image_alt,
                       3 as sort_order
                  from dual
                union all
                select 'Faisal Al-Mutairi' as name,
                       'Director of AI, Digital Government' as role,
                       'website-studio/img/person-6.jpg' as image_file,
                       'Portrait of a man in a suit' as image_alt,
                       4 as sort_order
                  from dual
                union all
                select 'Aisha Rahman' as name,
                       'VP Analytics, Northgrid' as role,
                       'website-studio/img/person-1.jpg' as image_file,
                       'Portrait of a woman smiling' as image_alt,
                       5 as sort_order
                  from dual
                union all
                select 'Marco Rossi' as name,
                       'Data Quality Lead, Kestrel' as role,
                       'website-studio/img/person-2.jpg' as image_file,
                       'Portrait of a man smiling' as image_alt,
                       6 as sort_order
                  from dual
