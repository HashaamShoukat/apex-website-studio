    region tickets (
        name: Tickets
        title: Tickets
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Student' as name,
                       'SAR 250' as price,
                       '2 days' as period,
                       'With a valid student card.' as description,
                       'All talks|Lunch both days|Recordings' as features,
                       'Buy' as button_label,
                       '#contact' as button_link,
                       'N' as is_featured,
                       null as badge,
                       1 as sort_order
                  from dual
                union all
                select 'Conference' as name,
                       'SAR 1,450' as price,
                       '2 days' as period,
                       'Everything most people need.' as description,
                       'All talks|One workshop|Lunch and dinner|Recordings' as features,
                       'Buy' as button_label,
                       '#contact' as button_link,
                       'Y' as is_featured,
                       'Early price' as badge,
                       2 as sort_order
                  from dual
                union all
                select 'All access' as name,
                       'SAR 2,900' as price,
                       '2 days' as period,
                       'For teams who want it all.' as description,
                       'All talks|Every workshop|Speaker dinner|Front-row seats' as features,
                       'Buy' as button_label,
                       '#contact' as button_link,
                       'N' as is_featured,
                       null as badge,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 80
            slot: body
        }
