    region contact (
        name: Contact
        title: Questions about *tickets*?
        type: staticContent
        layout {
            sequence: 130
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Tone--soft
            ]
            cssClasses: ws-Contact
        }
        advanced {
            htmlDomId: contact
            customAttributes: data-menu="Contact"
        }
        headerAndFooter {
            headerText: <p class="ws-Lead">Group bookings, invoices and speaker enquiries.</p>
        }
    )

    region contact-details (
        name: Contact Details
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'fa-envelope-o' as icon,
                       'Email' as label,
                       'summit@example.com' as value,
                       'mailto:summit@example.com' as link,
                       1 as sort_order
                  from dual
                union all
                select 'fa-calendar' as icon,
                       'Dates' as label,
                       '9 - 10 March 2027' as value,
                       null as link,
                       2 as sort_order
                  from dual
                union all
                select 'fa-map-marker' as icon,
                       'Venue' as label,
                       'Riyadh Front Exhibition Centre' as value,
                       null as link,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 10
            parentRegion: @contact
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: contact-details
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-contact
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column ICON (
            layout {
                sequence: 10
            }
        )

        column LABEL (
            layout {
                sequence: 20
            }
        )

        column VALUE (
            layout {
                sequence: 30
            }
        )

        column LINK (
            layout {
                sequence: 40
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 50
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

