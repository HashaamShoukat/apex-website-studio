page 16 (
    name: Starter - Portfolio
    alias: PORTFOLIO
    title: Lina Haddad - Product Designer
    appearance {
        pageTemplate: @modern-one-page
        templateOptions: [
            #DEFAULT#
            ws-Design--swiss
            ws-Accent--rose
            ws-Font--grotesk
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    htmlHeader {
        htmlHeader:
            ```html
            <meta name="description" content="Lina Haddad is an independent product and brand designer in Jeddah. Selected work, services and contact.">
            <meta property="og:type" content="website">
            <meta property="og:title" content="Lina Haddad - Product Designer">
            <meta property="og:description" content="Lina Haddad is an independent product and brand designer in Jeddah. Selected work, services and contact.">
            <meta property="og:image" content="#APP_FILES#website-studio/img/portfolio-hero.jpg">
            <meta name="twitter:card" content="summary_large_image">
            <link rel="preload" as="image" href="#APP_FILES#website-studio/img/portfolio-hero.jpg" fetchpriority="high">
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hero (
        name: Lina Haddad
        title: Lina Haddad
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'I design products people *enjoy* using.' as title,
                       'Product and brand designer - Jeddah' as subtitle,
                       'Ten years of apps, identities and websites for startups and banks.' as text,
                       'Selected work' as button_label,
                       '#work' as button_link,
                       'Hire me' as button2_label,
                       '#contact' as button2_link,
                       'website-studio/img/portfolio-hero.jpg' as image_file,
                       'A designer''s desk with sketches' as image_alt,
                       1 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: hero
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--none
                ws-Width--full
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: hero
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-hero
            templateOptions: [
                #DEFAULT#
                ws-Hero--zoom
                ws-Hero--split
                ws-Hero--medium
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column TITLE (
            layout {
                sequence: 10
            }
        )

        column SUBTITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column BUTTON_LABEL (
            layout {
                sequence: 40
            }
        )

        column BUTTON_LINK (
            layout {
                sequence: 50
            }
        )

        column BUTTON2_LABEL (
            layout {
                sequence: 60
            }
        )

        column BUTTON2_LINK (
            layout {
                sequence: 70
            }
        )

        column IMAGE_FILE (
            layout {
                sequence: 80
            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 90
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 100
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region work (
        name: Work
        title: Selected *work*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Kestrel Coffee' as title,
                       'Branding' as category,
                       'Identity and packaging - 2025' as meta,
                       'website-studio/img/work-4.jpg' as image_file,
                       'Coffee packaging' as image_alt,
                       1 as sort_order
                  from dual
                union all
                select 'Lumen Bank app' as title,
                       'Product' as category,
                       'Mobile banking - 2025' as meta,
                       'website-studio/img/work-3.jpg' as image_file,
                       'A mobile app on a phone' as image_alt,
                       2 as sort_order
                  from dual
                union all
                select 'Orbital website' as title,
                       'Web' as category,
                       'Marketing site - 2024' as meta,
                       'website-studio/img/work-2.jpg' as image_file,
                       'A website design on a laptop' as image_alt,
                       3 as sort_order
                  from dual
                union all
                select 'Northgrid dashboard' as title,
                       'Product' as category,
                       'Data product - 2024' as meta,
                       'website-studio/img/work-5.jpg' as image_file,
                       'A product dashboard on a large screen' as image_alt,
                       4 as sort_order
                  from dual
                union all
                select 'Vantage Hotels' as title,
                       'Branding' as category,
                       'Identity - 2023' as meta,
                       'website-studio/img/work-6.jpg' as image_file,
                       'A hotel lobby with the new signage' as image_alt,
                       5 as sort_order
                  from dual
                union all
                select 'Fieldnote' as title,
                       'Web' as category,
                       'Website and brand - 2023' as meta,
                       'website-studio/img/work-1.jpg' as image_file,
                       'Brand identity on business cards and paper' as image_alt,
                       6 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Head--split
            ]
        }
        advanced {
            htmlDomId: work
            customAttributes: data-menu="Work"
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-gallery
            templateOptions: [
                #DEFAULT#
                ws-Filter
                ws-Works--editorial
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column TITLE (
            layout {
                sequence: 10
            }
        )

        column CATEGORY (
            layout {
                sequence: 20
            }
        )

        column META (
            layout {
                sequence: 30
            }
        )

        column IMAGE_FILE (
            layout {
                sequence: 40
            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 50
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 60
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region about (
        name: About
        title: About
        type: staticContent
        source {
            htmlCode:
                ```
                <div class="ws-Split">
                  <div class="ws-Media" data-file="website-studio/img/person-3.jpg" role="img" aria-label="Lina Haddad"></div>
                  <div class="ws-Stack">
                    <p class="ws-Eyebrow">About</p>
                    <h2 class="ws-Title">Hi, I am *Lina*.</h2>
                    <p class="ws-Lead">I help teams turn complicated ideas into simple products. I studied architecture, which is why I still start every project with a pencil.</p>
                    <ul class="ws-Checks"><li>Ten years in product and brand design</li><li>Arabic and English interfaces</li><li>Works directly with your developers</li></ul>
                  </div>
                </div>
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Tone--soft
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: about
            customAttributes: data-menu="About"
        }
    )

    region services (
        name: Services
        title: How I can *help*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'fa-mobile' as icon,
                       'Product design' as title,
                       'Research, flows and polished interfaces for web and mobile apps.' as text,
                       1 as sort_order
                  from dual
                union all
                select 'fa-magic' as icon,
                       'Brand identity' as title,
                       'Logos, colour and type systems with clear guidelines.' as text,
                       2 as sort_order
                  from dual
                union all
                select 'fa-desktop' as icon,
                       'Websites' as title,
                       'Design and build of fast marketing sites in Webflow or Oracle APEX.' as text,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
            ]
        }
        advanced {
            htmlDomId: services
            customAttributes: data-menu="Services"
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-features
            templateOptions: [
                #DEFAULT#
                ws-Features--rows
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column ICON (
            layout {
                sequence: 10
            }
        )

        column TITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 40
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region experience (
        name: Experience
        title: Experience
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select '2022 - now' as year,
                       'Independent designer' as title,
                       'Product and brand work for clients in the Gulf and Europe.' as text,
                       1 as sort_order
                  from dual
                union all
                select '2018 - 2022' as year,
                       'Lead Product Designer, Lumen Bank' as title,
                       'Led the redesign of the mobile app used by two million customers.' as text,
                       2 as sort_order
                  from dual
                union all
                select '2015 - 2018' as year,
                       'Designer, Halcyon Studio' as title,
                       'Brand identities and websites for startups.' as text,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 60
            slot: body
