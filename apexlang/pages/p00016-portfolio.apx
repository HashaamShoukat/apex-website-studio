    region contact (
        name: Contact
        title: Let's *talk*
        type: staticContent
        layout {
            sequence: 80
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Tone--soft
            ]
            cssClasses: ws-Contact
        }
        advanced {
            htmlDomId: contact
            customAttributes: data-menu="Contact"
        }
        headerAndFooter {
            headerText: <p class="ws-Lead">Available for new projects from January.</p>
        }
    )

    region contact-details (
        name: Contact Details
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'fa-envelope-o' as icon,
                       'Email' as label,
                       'lina@example.com' as value,
                       'mailto:lina@example.com' as link,
                       1 as sort_order
                  from dual
                union all
                select 'fa-map-marker' as icon,
                       'Based in' as label,
                       'Jeddah, working worldwide' as value,
                       null as link,
                       2 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 10
            parentRegion: @contact
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: contact-details
