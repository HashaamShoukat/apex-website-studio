            layout {
                sequence: 10
            }
        )

        column TITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 40
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region clients-say (
        name: Kind words
        title: Kind *words*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Lina turned a messy brief into an app our customers love. Ratings went from 3.1 to 4.7.' as quote,
                       'Daniel Brook' as name,
                       'Head of Digital, Lumen Bank' as role,
                       '5' as rating,
                       'website-studio/img/person-2.jpg' as image_file,
                       'Portrait of a man in a shirt' as image_alt,
                       1 as sort_order
                  from dual
                union all
                select 'Thoughtful, fast and a joy to work with.' as quote,
                       'Priya Nair' as name,
                       'Founder, Fieldnote' as role,
                       '5' as rating,
                       'website-studio/img/person-3.jpg' as image_file,
                       'Portrait of a woman with curly hair' as image_alt,
                       2 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 70
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Head--center
            ]
        }
