    pageItem P16_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 10
            region: @contact
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
    )

    pageItem P16_EMAIL (
        type: textField
        label {
            label: Email
            alignment: left
        }
        settings {
            subtype: email
        }
        layout {
            sequence: 20
            region: @contact
            slot: regionBody
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
    )

    pageItem P16_MESSAGE (
        type: textarea
        label {
            label: Tell me about your project
            alignment: left
        }
        layout {
            sequence: 30
            region: @contact
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
    )

    pageItem P16_WEBSITE (
        type: textField
        label {
            label: Leave this field empty
            alignment: left
        }
        layout {
            sequence: 40
            region: @contact
            slot: regionBody
            columnSpan: 12
            columnCssClasses: ws-Honeypot
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        advanced {
            customAttributes: tabindex="-1" autocomplete="off"
        }
        sessionState {
            storage: request
        }
    )

    button send (
        buttonName: SEND
        label: Send message
        layout {
            sequence: 50
            region: @contact
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
        }
    )

    process send-message (
        name: Send Message
        type: executeCode
        source {
            location: localDatabase
            language: plsql
            plsqlCode:
                ```
                -- P16_WEBSITE is a hidden honeypot field: people leave it empty, spam robots fill it in.
                if :P16_WEBSITE is null then
                    -- The starter only says thank you. To receive the message by email, use for example:
                    -- apex_mail.send(p_to   => 'hello@example.com',
                    --                p_from => 'noreply@example.com',
                    --                p_subj => 'Website message from ' || :P16_NAME,
                    --                p_body => :P16_MESSAGE || chr(10) || chr(10) || :P16_NAME || ', ' || :P16_EMAIL || ', ' || null);
                    -- apex_mail.push_queue;
                    null;
                end if;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Thanks for your message. We will reply within one working day.
        }
        serverSideCondition {
            whenButtonPressed: @send
        }
    )

    branch back-to-website (
        name: Back to the Website
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 16
            }
        }
    )

)
