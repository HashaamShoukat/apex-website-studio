    region social (
        name: Social Media
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Dribbble' as label,
                       'https://dribbble.com/' as link,
                       'fa-dribbble' as icon,
                       1 as sort_order
                  from dual
                union all
                select 'Behance' as label,
                       'https://www.behance.net/' as link,
                       'fa-behance' as icon,
                       2 as sort_order
                  from dual
                union all
                select 'LinkedIn' as label,
                       'https://www.linkedin.com/' as link,
                       'fa-linkedin' as icon,
                       3 as sort_order
                  from dual
                union all
                select 'Instagram' as label,
                       'https://www.instagram.com/' as link,
                       'fa-instagram' as icon,
                       4 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 10
            parentRegion: @footer-about
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
