            layout {
                sequence: 10
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 20
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region features (
        name: Features
        title: Everything you need, *nothing* you don't
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'fa-file-text-o' as icon,
                       'Invoices in a minute' as title,
                       'Branded, VAT-ready invoices with a pay-now link.' as text,
                       1 as sort_order
                  from dual
                union all
                select 'fa-bell-o' as icon,
                       'Polite reminders' as title,
                       'Late payers get friendly reminders, so you don''t have to.' as text,
                       2 as sort_order
                  from dual
                union all
                select 'fa-university' as icon,
                       'Bank sync' as title,
                       'Payments match their invoices automatically.' as text,
                       3 as sort_order
                  from dual
                union all
                select 'fa-pie-chart' as icon,
                       'Clear reports' as title,
                       'Cash flow, profit and VAT at a glance.' as text,
                       4 as sort_order
                  from dual
                union all
                select 'fa-users' as icon,
                       'Invite your accountant' as title,
                       'Free access for your accountant, with an audit trail.' as text,
                       5 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Head--center
            ]
        }
        advanced {
            htmlDomId: features
            customAttributes: data-menu="Features"
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-features
            templateOptions: [
                #DEFAULT#
                ws-Features--bento
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column ICON (
            layout {
                sequence: 10
            }
        )

        column TITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 40
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region tour (
        name: One place for the whole job
        title: One place for the *whole* job
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Invoices' as label,
                       'fa-file-text-o' as icon,
                       'Send an invoice in a *minute*.' as title,
                       'Pick a customer, add the lines, press send. The invoice carries your logo, your VAT number and a pay-now link.' as text,
                       '#pricing' as link,
                       'See pricing' as link_label,
                       'website-studio/img/saas-1.jpg' as image_file,
                       'Paperwork with a calculator and a phone' as image_alt,
                       1 as sort_order
                  from dual
                union all
                select 'Payments' as label,
                       'fa-credit-card' as icon,
                       'Get paid a week *sooner*.' as title,
                       'Customers pay by card, Apple Pay or bank transfer. Late payers get a polite reminder without you lifting a finger.' as text,
                       null as link,
                       null as link_label,
                       'website-studio/img/saas-2.jpg' as image_file,
                       'A shop owner taking a payment on a tablet' as image_alt,
                       2 as sort_order
                  from dual
                union all
                select 'Reports' as label,
                       'fa-pie-chart' as icon,
                       'Know your numbers *today*.' as title,
                       'Cash flow, profit and VAT on one screen, ready to share with your accountant.' as text,
                       '#features' as link,
                       'All features' as link_label,
                       'website-studio/img/saas-hero.jpg' as image_file,
                       'An analytics dashboard on a screen' as image_alt,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Head--center
            ]
        }
