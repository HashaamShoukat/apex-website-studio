    region pricing (
        name: Pricing
        title: Simple *pricing*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Starter' as name,
                       'SAR 29' as price,
                       'per month' as period,
                       'For freelancers.' as description,
                       '20 invoices a month|Card payments|1 user' as features,
                       'Start free' as button_label,
                       '#contact' as button_link,
                       'N' as is_featured,
                       null as badge,
                       1 as sort_order
                  from dual
                union all
                select 'Business' as name,
                       'SAR 79' as price,
                       'per month' as period,
                       'For growing teams.' as description,
                       'Unlimited invoices|Bank sync|Reminders|5 users' as features,
                       'Start free' as button_label,
                       '#contact' as button_link,
                       'Y' as is_featured,
                       'Most popular' as badge,
                       2 as sort_order
                  from dual
                union all
                select 'Plus' as name,
                       'SAR 149' as price,
                       'per month' as period,
                       'For more than one company.' as description,
                       'Everything in Business|Multi-company|Priority support|Unlimited users' as features,
                       'Talk to sales' as button_label,
                       '#contact' as button_link,
                       'N' as is_featured,
                       null as badge,
                       3 as sort_order
                  from dual
