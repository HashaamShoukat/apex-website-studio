    region faq (
        name: Questions
        title: Questions
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'How long does it take to set up?' as question,
                       'About ten minutes. Add your logo and VAT number, connect your bank, and send your first invoice.' as answer,
                       1 as sort_order
                  from dual
                union all
                select 'Can my accountant use it too?' as question,
                       'Yes. Accountants get free access with their own login and an audit trail of every change.' as answer,
                       2 as sort_order
                  from dual
                union all
                select 'Which payment methods do my customers get?' as question,
                       'Cards, Apple Pay, mada and bank transfer. Card fees are shown before you turn them on.' as answer,
                       3 as sort_order
                  from dual
                union all
                select 'Do I need a card to try it?' as question,
                       'No. The trial is free for 30 days and asks for no payment details.' as answer,
                       4 as sort_order
                  from dual
                union all
                select 'Is Ledgerline approved for e-invoicing?' as question,
                       'Yes. Invoices meet the ZATCA e-invoicing requirements, phase 2.' as answer,
                       5 as sort_order
                  from dual
                union all
                select 'Can I export my data?' as question,
                       'Any time, as Excel or CSV. Your data is yours.' as answer,
                       6 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 110
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Head--center
            ]
