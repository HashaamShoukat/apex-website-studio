            layout {
                sequence: 20
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region contact (
        name: Start free
        title: Start your free *trial*
        type: staticContent
        layout {
            sequence: 120
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Tone--gradient
                ws-Edge--curve
            ]
            cssClasses: ws-Contact
        }
        advanced {
            htmlDomId: contact
            customAttributes: data-menu="Start free"
        }
        headerAndFooter {
            headerText: <p class="ws-Lead">Leave your details and we will set up your account today.</p>
        }
    )

    region contact-details (
        name: Contact Details
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'fa-envelope-o' as icon,
                       'Sales' as label,
                       'sales@example.com' as value,
                       'mailto:sales@example.com' as link,
                       1 as sort_order
                  from dual
                union all
                select 'fa-life-ring' as icon,
                       'Support' as label,
                       'help@example.com' as value,
                       'mailto:help@example.com' as link,
                       2 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 10
            parentRegion: @contact
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: contact-details
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-contact
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

