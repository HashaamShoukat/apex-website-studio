                select 'Stay ready' as eyebrow,
                       'Books that are always *up to date*.' as title,
                       'Every payment and expense lands in the right place, so VAT returns take minutes.' as text,
                       'website-studio/img/saas-2.jpg' as image_file,
                       'A shop owner taking a payment on a tablet' as image_alt,
                       '#features' as link,
