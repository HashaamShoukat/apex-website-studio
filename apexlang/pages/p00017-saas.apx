page 17 (
    name: Starter - SaaS
    alias: SAAS
    title: Ledgerline - Invoicing and Bookkeeping for Small Businesses
    appearance {
        pageTemplate: @modern-one-page
        templateOptions: [
            #DEFAULT#
            ws-Design--saas
            ws-Accent--violet
            ws-Font--friendly
            ws-Header--pill
            ws-Fx--theme
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    htmlHeader {
        htmlHeader:
            ```html
            <meta name="description" content="Send invoices, get paid faster and keep your books ready for VAT. Free for 30 days, no card needed.">
            <meta property="og:type" content="website">
            <meta property="og:title" content="Ledgerline - Invoicing and Bookkeeping for Small Businesses">
            <meta property="og:description" content="Send invoices, get paid faster and keep your books ready for VAT. Free for 30 days, no card needed.">
            <meta property="og:image" content="#APP_FILES#website-studio/img/saas-hero.jpg">
            <meta name="twitter:card" content="summary_large_image">
            <link rel="preload" as="image" href="#APP_FILES#website-studio/img/saas-hero.jpg" fetchpriority="high">
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hero (
        name: Ledgerline
        title: Ledgerline
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Invoices out. Money *in*. Books done.' as title,
                       'For small businesses' as subtitle,
                       'Ledgerline sends your invoices, chases late payers and keeps your books ready for VAT.' as text,
                       'Start free for 30 days' as button_label,
                       '#contact' as button_link,
                       'See pricing' as button2_label,
                       '#pricing' as button2_link,
                       'website-studio/img/saas-hero.jpg' as image_file,
                       'An analytics dashboard on a screen' as image_alt,
                       1 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: hero
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--none
                ws-Width--full
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: hero
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-hero
            templateOptions: [
                #DEFAULT#
                ws-Hero--zoom
                ws-Hero--split
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column TITLE (
            layout {
                sequence: 10
            }
        )

        column SUBTITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column BUTTON_LABEL (
            layout {
                sequence: 40
            }
        )

        column BUTTON_LINK (
            layout {
                sequence: 50
            }
        )

        column BUTTON2_LABEL (
            layout {
                sequence: 60
            }
        )

        column BUTTON2_LINK (
            layout {
                sequence: 70
            }
        )

        column IMAGE_FILE (
            layout {
                sequence: 80
            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 90
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 100
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region logos (
        name: Used by 12,000 businesses
        title: Used by 12,000 businesses
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Kestrel' as name,
                       1 as sort_order
                  from dual
                union all
                select 'Fieldnote' as name,
                       2 as sort_order
                  from dual
                union all
                select 'Tidewater' as name,
                       3 as sort_order
                  from dual
                union all
                select 'Monogram' as name,
                       4 as sort_order
                  from dual
                union all
                select 'Northpeak' as name,
                       5 as sort_order
                  from dual
                union all
                select 'Vantage' as name,
                       6 as sort_order
                  from dual
                union all
                select 'Orbital' as name,
                       7 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--tight
                ws-Head--center
            ]
            cssClasses: ws-Sec--small
        }
        advanced {
            htmlDomId: logos
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-logos
            templateOptions: [
                #DEFAULT#
                ws-Speed--slow
            ]
        }
