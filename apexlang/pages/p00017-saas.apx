    region compare (
        name: Compare
        title: Why *Ledgerline*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select null as feature,
                       'Ledgerline' as col1,
                       'Spreadsheets' as col2,
                       'Big accounting suites' as col3,
                       'Y' as is_header,
                       1 as sort_order
                  from dual
                union all
                select 'VAT-ready invoices' as feature,
                       'Y' as col1,
                       'N' as col2,
                       'Y' as col3,
                       null as is_header,
                       2 as sort_order
                  from dual
                union all
                select 'Automatic reminders' as feature,
                       'Y' as col1,
                       'N' as col2,
                       'Y' as col3,
                       null as is_header,
                       3 as sort_order
                  from dual
                union all
                select 'Set up in 10 minutes' as feature,
                       'Y' as col1,
                       'Y' as col2,
                       'N' as col3,
                       null as is_header,
                       4 as sort_order
                  from dual
                union all
                select 'Arabic and English' as feature,
                       'Y' as col1,
                       'Y' as col2,
                       'N' as col3,
                       null as is_header,
                       5 as sort_order
                  from dual
                union all
                select 'Price per month' as feature,
                       'From SAR 29' as col1,
                       'Free' as col2,
                       'SAR 250+' as col3,
                       null as is_header,
                       6 as sort_order
                  from dual
                order by sort_order
                ```
        }
