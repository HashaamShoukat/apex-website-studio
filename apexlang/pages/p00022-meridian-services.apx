page 22 (
    name: Meridian - Services
    alias: MERIDIAN-SERVICES
    title: Services - Meridian Partners
    appearance {
        pageTemplate: @modern-one-page
        templateOptions: [
            #DEFAULT#
            ws-Design--corporate
            ws-Accent--indigo
            ws-Font--tech
            ws-Header--centered
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    htmlHeader {
        htmlHeader:
            ```html
            <meta name="description" content="Advisory, engineering, operations and sustainability: three practices that work as one team.">
            <meta property="og:type" content="website">
            <meta property="og:title" content="Services - Meridian Partners">
            <meta property="og:description" content="Advisory, engineering, operations and sustainability: three practices that work as one team.">
            <meta property="og:image" content="#APP_FILES#website-studio/img/company-hero.jpg">
            <meta name="twitter:card" content="summary_large_image">
            <link rel="preload" as="image" href="#APP_FILES#website-studio/img/company-plan.jpg" fetchpriority="high">
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hero (
        name: What we do.
        title: What we *do*.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'What we *do*.' as title,
                       'Services' as subtitle,
                       'From the first study to the last inspection.' as text,
                       'website-studio/img/company-plan.jpg' as image_file,
                       'Planning notes next to a laptop' as image_alt,
                       1 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: hero
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--none
                ws-Width--full
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: hero
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-hero
            templateOptions: [
                #DEFAULT#
                ws-Hero--zoom
                ws-Hero--fullbleed
                ws-Hero--compact
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column TITLE (
            layout {
                sequence: 10
            }
        )

        column SUBTITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column IMAGE_FILE (
            layout {
                sequence: 40
            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 50
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 60
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region services (
        name: Services
        title: What we *do*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'fa-line-chart' as icon,
                       'Advisory' as title,
                       'Feasibility studies, financing and procurement strategies for large public projects.' as text,
                       1 as sort_order
                  from dual
                union all
                select 'fa-cogs' as icon,
                       'Engineering' as title,
                       'Civil, structural and electrical design, with digital models shared with every contractor.' as text,
                       2 as sort_order
                  from dual
                union all
                select 'fa-wrench' as icon,
                       'Operations' as title,
                       'Asset management and maintenance plans that keep networks running and costs predictable.' as text,
                       3 as sort_order
                  from dual
                union all
                select 'fa-leaf' as icon,
                       'Sustainability' as title,
                       'Carbon accounting, climate risk and renewable integration for every stage of a project.' as text,
                       4 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: services
            customAttributes: data-menu="Services"
        }
        headerAndFooter {
            headerText: <p class="ws-Eyebrow">Services</p><p class="ws-Lead">Three practices that work as one team from the first study to the last inspection.</p>
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-features
            templateOptions: [
                #DEFAULT#
                ws-Features--rows
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column ICON (
            layout {
                sequence: 10
            }
        )

        column TITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 40
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region clients-say (
        name: What clients say
        title: What clients *say*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Meridian found savings in the design that paid for their whole contract. Calm, precise and always on time.' as quote,
                       'Khalid Mansour' as name,
                       'Programme Director, Atlas Rail' as role,
                       '5' as rating,
                       'website-studio/img/person-4.jpg' as image_file,
                       'Portrait of a man in a grey sweater' as image_alt,
                       1 as sort_order
                  from dual
                union all
                select 'The best engineering partner we have had in twenty years of building water networks.' as quote,
                       'Laila Haddad' as name,
                       'CEO, Gulf Water' as role,
                       '5' as rating,
                       'website-studio/img/person-1.jpg' as image_file,
                       'Portrait of a woman smiling' as image_alt,
                       2 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Tone--soft
                ws-Head--center
            ]
        }
        advanced {
            htmlDomId: clients-say
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-testimonials
            templateOptions: [
                #DEFAULT#
                ws-Quotes--spotlight
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column QUOTE (
            layout {
                sequence: 10
            }
        )

        column NAME (
            layout {
                sequence: 20
            }
        )

        column ROLE (
            layout {
                sequence: 30
            }
        )

        column RATING (
            layout {
                sequence: 40
            }
        )

        column IMAGE_FILE (
            layout {
                sequence: 50
            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 60
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 70
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region faq (
        name: Questions
        title: Questions
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Which regions do you work in?' as question,
                       'Saudi Arabia, the UAE, the wider Gulf and Northern Europe, with partners elsewhere.' as answer,
                       1 as sort_order
                  from dual
                union all
                select 'Do you work on private projects?' as question,
                       'Yes. About a third of our work is for private developers and industrial clients.' as answer,
                       2 as sort_order
                  from dual
                union all
                select 'How do you price a project?' as question,
                       'Fixed fees for studies and design, and agreed rates for long-term operations support.' as answer,
                       3 as sort_order
                  from dual
                union all
                select 'Can you join a project already under way?' as question,
                       'Often. We review the design and the programme first and tell you honestly where we can help.' as answer,
                       4 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 50
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Tone--soft
                ws-Head--center
            ]
        }
        advanced {
            htmlDomId: faq
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-faq
            templateOptions: [
                #DEFAULT#
                ws-Faqs--columns
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column QUESTION (
            layout {
                sequence: 10
            }
        )

        column ANSWER (
            layout {
                sequence: 20
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region site-menu (
        name: Menu
        type: list
        source {
            list: @meridian-menu
        }
        layout {
            sequence: 10
            slot: menu
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: site-menu
        }
        componentAppearance {
            listTemplate: @website-menu
            templateOptions: [
                #DEFAULT#
                ws-Menu--cta
            ]
        }
    )

    region logo (
        name: Logo
        type: staticContent
        source {
            htmlCode: <a class="ws-Brand" href="f?p=&APP_ID.:MERIDIAN:&APP_SESSION."><span class="ws-Logo-mark" aria-hidden="true">M</span>Meridian</a>
        }
        layout {
            sequence: 10
            slot: logo
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: logo
        }
    )

    region footer-about (
        name: Footer - About
        type: staticContent
        source {
            htmlCode:
                ```
                <a class="ws-Brand" href="f?p=&APP_ID.:MERIDIAN:&APP_SESSION."><span class="ws-Logo-mark" aria-hidden="true">M</span>Meridian</a>
                <p>Engineering and advisory for infrastructure that lasts.</p>
                ```
        }
        layout {
            sequence: 10
            slot: footer
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: footer-about
        }
    )

    region social (
        name: Social Media
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'LinkedIn' as label,
                       'https://www.linkedin.com/' as link,
                       'fa-linkedin' as icon,
                       1 as sort_order
                  from dual
                union all
                select 'X' as label,
                       'https://x.com/' as link,
                       'fa-x-twitter' as icon,
                       2 as sort_order
                  from dual
                union all
                select 'YouTube' as label,
                       'https://www.youtube.com/' as link,
                       'fa-youtube-play' as icon,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 10
            parentRegion: @footer-about
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: social
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-links
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column LABEL (
            layout {
                sequence: 10
            }
        )

        column LINK (
            layout {
                sequence: 20
            }
        )

        column ICON (
            layout {
                sequence: 30
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 40
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region f-company (
        name: Footer - Company
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'About' as label,
                       apex_page.get_url(p_page => 'MERIDIAN-ABOUT') as link,
                       1 as sort_order
                  from dual
                union all
                select 'Insights' as label,
                       apex_page.get_url(p_page => 'MERIDIAN-INSIGHTS') as link,
                       2 as sort_order
                  from dual
                union all
                select 'Careers' as label,
                       apex_page.get_url(p_page => 'MERIDIAN-CAREERS') as link,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: footer
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: f-company
        }
        headerAndFooter {
            headerText: <h3>Company</h3>
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-links
            templateOptions: [
                #DEFAULT#
                ws-Links--list
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column LABEL (
            layout {
                sequence: 10
            }
        )

        column LINK (
            layout {
                sequence: 20
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region f-services (
        name: Footer - Services
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Our services' as label,
                       apex_page.get_url(p_page => 'MERIDIAN-SERVICES') as link,
                       1 as sort_order
                  from dual
                union all
                select 'Questions' as label,
                       apex_page.get_url(p_page => 'MERIDIAN-SERVICES') || '#faq' as link,
                       2 as sort_order
                  from dual
                union all
                select 'Client portal' as label,
                       'https://example.com/portal' as link,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 30
            slot: footer
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: f-services
        }
        headerAndFooter {
            headerText: <h3>Services</h3>
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-links
            templateOptions: [
                #DEFAULT#
                ws-Links--list
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column LABEL (
            layout {
                sequence: 10
            }
        )

        column LINK (
            layout {
                sequence: 20
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region copyright (
        name: Copyright
        type: staticContent
        source {
            htmlCode: <span>&copy; Meridian Partners. All rights reserved.</span>
        }
        layout {
            sequence: 10
            slot: footerBottom
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: copyright
        }
    )

    region legal (
        name: Legal Links
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Privacy' as label,
                       '#' as link,
                       1 as sort_order
                  from dual
                union all
                select 'Terms' as label,
                       '#' as link,
                       2 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: footerBottom
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: legal
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-links
            templateOptions: [
                #DEFAULT#
                ws-Links--inline
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column LABEL (
            layout {
                sequence: 10
            }
        )

        column LINK (
            layout {
                sequence: 20
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

)
