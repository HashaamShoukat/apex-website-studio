page 24 (
    name: Meridian - Careers
    alias: MERIDIAN-CAREERS
    title: Careers - Meridian Partners
    appearance {
        pageTemplate: @modern-one-page
        templateOptions: [
            #DEFAULT#
            ws-Design--corporate
            ws-Accent--indigo
            ws-Font--tech
            ws-Header--centered
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    htmlHeader {
        htmlHeader:
            ```html
            <meta name="description" content="Open roles in engineering and advisory in Riyadh, Dubai and Rotterdam.">
            <meta property="og:type" content="website">
            <meta property="og:title" content="Careers - Meridian Partners">
            <meta property="og:description" content="Open roles in engineering and advisory in Riyadh, Dubai and Rotterdam.">
            <meta property="og:image" content="#APP_FILES#website-studio/img/company-hero.jpg">
            <meta name="twitter:card" content="summary_large_image">
            <link rel="preload" as="image" href="#APP_FILES#website-studio/img/company-team.jpg" fetchpriority="high">
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hero (
        name: Build a career that matters.
        title: Build a career that *matters*.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Build a career that *matters*.' as title,
                       'Careers' as subtitle,
                       'Open roles in Riyadh, Dubai and Rotterdam.' as text,
                       'website-studio/img/company-team.jpg' as image_file,
                       'Colleagues working on laptops' as image_alt,
                       1 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: hero
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--none
                ws-Width--full
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: hero
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-hero
            templateOptions: [
                #DEFAULT#
                ws-Hero--zoom
                ws-Hero--fullbleed
                ws-Hero--compact
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column TITLE (
            layout {
                sequence: 10
            }
        )

        column SUBTITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column IMAGE_FILE (
            layout {
                sequence: 40
            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 50
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 60
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region careers (
        name: Careers
        title: Build a *career* that matters
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Senior Structural Engineer' as title,
                       'Engineering' as team,
                       'Riyadh' as location,
                       'Full-time' as type,
                       'Lead structural design for transport projects.' as description,
                       'mailto:careers@example.com' as apply_link,
                       1 as sort_order
                  from dual
                union all
                select 'Infrastructure Economist' as title,
                       'Advisory' as team,
                       'Dubai' as location,
                       'Full-time' as type,
                       'Build the business cases behind major public projects.' as description,
                       'mailto:careers@example.com' as apply_link,
                       2 as sort_order
                  from dual
                union all
                select 'Graduate Engineer' as title,
                       'Engineering' as team,
                       'Rotterdam' as location,
                       'Graduate' as type,
                       'A two-year programme across our three practices.' as description,
                       'mailto:careers@example.com' as apply_link,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: careers
            customAttributes: data-menu="Careers"
        }
        headerAndFooter {
            headerText: <p class="ws-Eyebrow">Careers</p>
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-jobs
            templateOptions: [
                #DEFAULT#
                ws-Filter
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column TITLE (
            layout {
                sequence: 10
            }
        )

        column TEAM (
            layout {
                sequence: 20
            }
        )

        column LOCATION (
            layout {
                sequence: 30
            }
        )

        column TYPE (
            layout {
                sequence: 40
            }
        )

        column DESCRIPTION (
            layout {
                sequence: 50
            }
        )

        column APPLY_LINK (
            layout {
                sequence: 60
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 70
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region site-menu (
        name: Menu
        type: list
        source {
            list: @meridian-menu
        }
        layout {
            sequence: 10
            slot: menu
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: site-menu
        }
        componentAppearance {
            listTemplate: @website-menu
            templateOptions: [
                #DEFAULT#
                ws-Menu--cta
            ]
        }
    )

    region logo (
        name: Logo
        type: staticContent
        source {
            htmlCode: <a class="ws-Brand" href="f?p=&APP_ID.:MERIDIAN:&APP_SESSION."><span class="ws-Logo-mark" aria-hidden="true">M</span>Meridian</a>
        }
        layout {
            sequence: 10
            slot: logo
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: logo
        }
    )

    region footer-about (
        name: Footer - About
        type: staticContent
        source {
            htmlCode:
                ```
                <a class="ws-Brand" href="f?p=&APP_ID.:MERIDIAN:&APP_SESSION."><span class="ws-Logo-mark" aria-hidden="true">M</span>Meridian</a>
                <p>Engineering and advisory for infrastructure that lasts.</p>
                ```
        }
        layout {
            sequence: 10
            slot: footer
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: footer-about
        }
    )

    region social (
        name: Social Media
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'LinkedIn' as label,
                       'https://www.linkedin.com/' as link,
                       'fa-linkedin' as icon,
                       1 as sort_order
                  from dual
                union all
                select 'X' as label,
                       'https://x.com/' as link,
                       'fa-x-twitter' as icon,
                       2 as sort_order
                  from dual
                union all
                select 'YouTube' as label,
                       'https://www.youtube.com/' as link,
                       'fa-youtube-play' as icon,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 10
            parentRegion: @footer-about
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: social
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-links
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column LABEL (
            layout {
                sequence: 10
            }
        )

        column LINK (
            layout {
                sequence: 20
            }
        )

        column ICON (
            layout {
                sequence: 30
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 40
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region f-company (
        name: Footer - Company
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'About' as label,
                       apex_page.get_url(p_page => 'MERIDIAN-ABOUT') as link,
                       1 as sort_order
                  from dual
                union all
                select 'Insights' as label,
                       apex_page.get_url(p_page => 'MERIDIAN-INSIGHTS') as link,
                       2 as sort_order
                  from dual
                union all
                select 'Careers' as label,
                       apex_page.get_url(p_page => 'MERIDIAN-CAREERS') as link,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: footer
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: f-company
        }
        headerAndFooter {
            headerText: <h3>Company</h3>
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-links
            templateOptions: [
                #DEFAULT#
                ws-Links--list
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column LABEL (
            layout {
                sequence: 10
            }
        )

        column LINK (
            layout {
                sequence: 20
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region f-services (
        name: Footer - Services
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Our services' as label,
                       apex_page.get_url(p_page => 'MERIDIAN-SERVICES') as link,
                       1 as sort_order
                  from dual
                union all
                select 'Questions' as label,
                       apex_page.get_url(p_page => 'MERIDIAN-SERVICES') || '#faq' as link,
                       2 as sort_order
                  from dual
                union all
                select 'Client portal' as label,
                       'https://example.com/portal' as link,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 30
            slot: footer
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: f-services
        }
        headerAndFooter {
            headerText: <h3>Services</h3>
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-links
            templateOptions: [
                #DEFAULT#
                ws-Links--list
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column LABEL (
            layout {
                sequence: 10
            }
        )

        column LINK (
            layout {
                sequence: 20
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region copyright (
        name: Copyright
        type: staticContent
        source {
            htmlCode: <span>&copy; Meridian Partners. All rights reserved.</span>
        }
        layout {
            sequence: 10
            slot: footerBottom
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: copyright
        }
    )

    region legal (
        name: Legal Links
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Privacy' as label,
                       '#' as link,
                       1 as sort_order
                  from dual
                union all
                select 'Terms' as label,
                       '#' as link,
                       2 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: footerBottom
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: legal
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-links
            templateOptions: [
                #DEFAULT#
                ws-Links--inline
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column LABEL (
            layout {
                sequence: 10
            }
        )

        column LINK (
            layout {
                sequence: 20
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

)
