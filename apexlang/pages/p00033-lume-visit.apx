page 33 (
    name: Osteria Lume - Visit
    alias: LUME-VISIT
    title: Opening hours and directions - Osteria Lume
    appearance {
        pageTemplate: @modern-one-page
        templateOptions: [
            #DEFAULT#
            ws-Design--organic
            ws-Accent--wine
            ws-Font--serif
            ws-Header--transparent
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    htmlHeader {
        htmlHeader:
            ```html
            <meta name="description" content="Opening hours, address and directions for Osteria Lume.">
            <meta property="og:type" content="website">
            <meta property="og:title" content="Opening hours and directions - Osteria Lume">
            <meta property="og:description" content="Opening hours, address and directions for Osteria Lume.">
            <meta property="og:image" content="#APP_FILES#website-studio/img/food-hero-1.jpg">
            <meta name="twitter:card" content="summary_large_image">
            <link rel="preload" as="image" href="#APP_FILES#website-studio/img/food-hero-2.jpg" fetchpriority="high">
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hero (
        name: Find us.
        title: Find *us*.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Find *us*.' as title,
                       'Visit' as subtitle,
                       'Five minutes from the metro, open every evening except Monday.' as text,
                       'website-studio/img/food-hero-2.jpg' as image_file,
                       'The dining room in the evening' as image_alt,
                       1 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: hero
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--none
                ws-Width--full
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: hero
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-hero
            templateOptions: [
                #DEFAULT#
                ws-Hero--zoom
                ws-Hero--fullbleed
                ws-Hero--compact
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column TITLE (
            layout {
                sequence: 10
            }
        )

        column SUBTITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column IMAGE_FILE (
            layout {
                sequence: 40
            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 50
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 60
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region hours (
        name: Opening hours
        title: Opening *hours*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Monday' as day_name,
                       'Closed' as hours,
                       '1' as day_number,
                       null as note,
                       1 as sort_order
                  from dual
                union all
                select 'Tuesday' as day_name,
                       '18:00 - 23:00' as hours,
                       '2' as day_number,
                       null as note,
                       2 as sort_order
                  from dual
                union all
                select 'Wednesday' as day_name,
                       '18:00 - 23:00' as hours,
                       '3' as day_number,
                       null as note,
                       3 as sort_order
                  from dual
                union all
                select 'Thursday' as day_name,
                       '18:00 - 23:30' as hours,
                       '4' as day_number,
                       null as note,
                       4 as sort_order
                  from dual
                union all
                select 'Friday' as day_name,
                       '13:00 - 00:00' as hours,
                       '5' as day_number,
                       'Lunch from 13:00' as note,
                       5 as sort_order
                  from dual
                union all
                select 'Saturday' as day_name,
                       '13:00 - 00:00' as hours,
                       '6' as day_number,
                       null as note,
                       6 as sort_order
                  from dual
                union all
                select 'Sunday' as day_name,
                       '13:00 - 22:00' as hours,
                       '7' as day_number,
                       'Family lunch' as note,
                       7 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Width--narrow
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: hours
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-hours
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column DAY_NAME (
            layout {
                sequence: 10
            }
        )

        column HOURS (
            layout {
                sequence: 20
            }
        )

        column DAY_NUMBER (
            layout {
                sequence: 30
            }
        )

        column NOTE (
            layout {
                sequence: 40
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 50
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region visit (
        name: Visit
        title: Find *us*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'https://www.openstreetmap.org/export/embed.html?bbox=46.66%2C24.68%2C46.70%2C24.71&layer=mapnik' as map_url,
                       'Osteria Lume' as title,
                       '12 Olive Street, Old Town' as address,
                       'Five minutes from the metro. Street parking after 18:00.' as text,
                       'https://www.openstreetmap.org/' as link,
                       'Directions' as link_label,
                       1 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Tone--soft
            ]
        }
        advanced {
            htmlDomId: visit
            customAttributes: data-menu="Visit"
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-map
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column MAP_URL (
            layout {
                sequence: 10
            }
        )

        column TITLE (
            layout {
                sequence: 20
            }
        )

        column ADDRESS (
            layout {
                sequence: 30
            }
        )

        column TEXT (
            layout {
                sequence: 40
            }
        )

        column LINK (
            layout {
                sequence: 50
            }
        )

        column LINK_LABEL (
            layout {
                sequence: 60
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 70
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region site-menu (
        name: Menu
        type: list
        source {
            list: @lume-menu
        }
        layout {
            sequence: 10
            slot: menu
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: site-menu
        }
        componentAppearance {
            listTemplate: @website-menu
            templateOptions: [
                #DEFAULT#
                ws-Menu--cta
            ]
        }
    )

    region logo (
        name: Logo
        type: staticContent
        source {
            htmlCode: <a class="ws-Brand" href="f?p=&APP_ID.:LUME:&APP_SESSION."><span class="ws-Logo-mark" aria-hidden="true">L</span>Osteria Lume</a>
        }
        layout {
            sequence: 10
            slot: logo
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: logo
        }
    )

    region footer-about (
        name: Footer - About
        type: staticContent
        source {
            htmlCode:
                ```
                <a class="ws-Brand" href="f?p=&APP_ID.:LUME:&APP_SESSION."><span class="ws-Logo-mark" aria-hidden="true">L</span>Osteria Lume</a>
                <p>Italian kitchen and wine bar. Open every evening except Monday.</p>
                ```
        }
        layout {
            sequence: 10
            slot: footer
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: footer-about
        }
    )

    region social (
        name: Social Media
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Instagram' as label,
                       'https://www.instagram.com/' as link,
                       'fa-instagram' as icon,
                       1 as sort_order
                  from dual
                union all
                select 'TikTok' as label,
                       'https://www.tiktok.com/' as link,
                       'fa-tiktok' as icon,
                       2 as sort_order
                  from dual
                union all
                select 'WhatsApp' as label,
                       'https://wa.me/966500000000' as link,
                       'fa-whatsapp' as icon,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 10
            parentRegion: @footer-about
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: social
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-links
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column LABEL (
            layout {
                sequence: 10
            }
        )

        column LINK (
            layout {
                sequence: 20
            }
        )

        column ICON (
            layout {
                sequence: 30
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 40
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region f-visit (
        name: Footer - Visit
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Menu' as label,
                       apex_page.get_url(p_page => 'LUME-MENU') as link,
                       1 as sort_order
                  from dual
                union all
                select 'Opening hours' as label,
                       apex_page.get_url(p_page => 'LUME-VISIT') as link,
                       2 as sort_order
                  from dual
                union all
                select 'Find us' as label,
                       apex_page.get_url(p_page => 'LUME-VISIT') || '#visit' as link,
                       3 as sort_order
                  from dual
                union all
                select 'Book a table' as label,
                       apex_page.get_url(p_page => 'LUME-BOOK') as link,
                       4 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: footer
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: f-visit
        }
        headerAndFooter {
            headerText: <h3>Visit</h3>
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-links
            templateOptions: [
                #DEFAULT#
                ws-Links--list
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column LABEL (
            layout {
                sequence: 10
            }
        )

        column LINK (
            layout {
                sequence: 20
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region copyright (
        name: Copyright
        type: staticContent
        source {
            htmlCode: <span>&copy; Osteria Lume</span>
        }
        layout {
            sequence: 10
            slot: footerBottom
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: copyright
        }
    )

    region legal (
        name: Legal Links
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Privacy' as label,
                       '#' as link,
                       1 as sort_order
                  from dual
                union all
                select 'Terms' as label,
                       '#' as link,
                       2 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: footerBottom
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: legal
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-links
            templateOptions: [
                #DEFAULT#
                ws-Links--inline
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column LABEL (
            layout {
                sequence: 10
            }
        )

        column LINK (
            layout {
                sequence: 20
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

)
