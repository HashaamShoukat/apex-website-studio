page 44 (
    name: Harbor & Stone - Contact
    alias: HARBOR-CONTACT
    title: Book a valuation - Harbor & Stone
    appearance {
        pageTemplate: @modern-one-page
        templateOptions: [
            #DEFAULT#
            ws-Design--luxury
            ws-Accent--amber
            ws-Font--luxe
            ws-Header--transparent
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    htmlHeader {
        htmlHeader:
            ```html
            <meta name="description" content="Book a free valuation or visit our office on Tahlia Street, Riyadh.">
            <meta property="og:type" content="website">
            <meta property="og:title" content="Book a valuation - Harbor &amp; Stone">
            <meta property="og:description" content="Book a free valuation or visit our office on Tahlia Street, Riyadh.">
            <meta property="og:image" content="#APP_FILES#website-studio/img/home-hero-1.jpg">
            <meta name="twitter:card" content="summary_large_image">
            <link rel="preload" as="image" href="#APP_FILES#website-studio/img/home-1.jpg" fetchpriority="high">
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hero (
        name: Book a free valuation.
        title: Book a free *valuation*.
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Book a free *valuation*.' as title,
                       'Contact' as subtitle,
                       'An agent visits within 48 hours.' as text,
                       'website-studio/img/home-1.jpg' as image_file,
                       'A family house with a garden' as image_alt,
                       1 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: hero
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--none
                ws-Width--full
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: hero
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-hero
            templateOptions: [
                #DEFAULT#
                ws-Hero--zoom
                ws-Hero--fullbleed
                ws-Hero--compact
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column TITLE (
            layout {
                sequence: 10
            }
        )

        column SUBTITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column IMAGE_FILE (
            layout {
                sequence: 40
            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 50
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 60
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region contact (
        name: Contact
        title: Book a free *valuation*
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Head--hidden
            ]
            cssClasses: ws-Contact
        }
        advanced {
            htmlDomId: contact
            customAttributes: data-menu="Contact"
        }
        headerAndFooter {
            headerText: <p class="ws-Lead">An agent visits within 48 hours and gives you a written valuation.</p>
        }
    )

    region contact-details (
        name: Contact Details
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'fa-phone' as icon,
                       'Phone' as label,
                       '+966 11 000 2299' as value,
                       'tel:+966110002299' as link,
                       1 as sort_order
                  from dual
                union all
                select 'fa-envelope-o' as icon,
                       'Email' as label,
                       'homes@example.com' as value,
                       'mailto:homes@example.com' as link,
                       2 as sort_order
                  from dual
                union all
                select 'fa-map-marker' as icon,
                       'Office' as label,
                       'Tahlia Street 40, Riyadh' as value,
                       null as link,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 10
            parentRegion: @contact
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: contact-details
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-contact
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column ICON (
            layout {
                sequence: 10
            }
        )

        column LABEL (
            layout {
                sequence: 20
            }
        )

        column VALUE (
            layout {
                sequence: 30
            }
        )

        column LINK (
            layout {
                sequence: 40
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 50
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region visit (
        name: Visit
        title: Visit our *office*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'https://www.openstreetmap.org/export/embed.html?bbox=46.66%2C24.69%2C46.70%2C24.72&layer=mapnik' as map_url,
                       'Harbor & Stone' as title,
                       'Tahlia Street 40, Riyadh' as address,
                       'Saturday to Thursday, 9:00 to 21:00' as text,
                       'https://www.openstreetmap.org/' as link,
                       'Directions' as link_label,
                       1 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Tone--soft
            ]
        }
        advanced {
            htmlDomId: visit
            customAttributes: data-menu="Visit"
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-map
            templateOptions: [
                #DEFAULT#
                ws-Maps--full
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column MAP_URL (
            layout {
                sequence: 10
            }
        )

        column TITLE (
            layout {
                sequence: 20
            }
        )

        column ADDRESS (
            layout {
                sequence: 30
            }
        )

        column TEXT (
            layout {
                sequence: 40
            }
        )

        column LINK (
            layout {
                sequence: 50
            }
        )

        column LINK_LABEL (
            layout {
                sequence: 60
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 70
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region site-menu (
        name: Menu
        type: list
        source {
            list: @harbor-menu
        }
        layout {
            sequence: 10
            slot: menu
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: site-menu
        }
        componentAppearance {
            listTemplate: @website-menu
            templateOptions: [
                #DEFAULT#
                ws-Menu--cta
                ws-Menu--overlay
            ]
        }
    )

    region logo (
        name: Logo
        type: staticContent
        source {
            htmlCode: <a class="ws-Brand" href="f?p=&APP_ID.:HARBOR:&APP_SESSION."><span class="ws-Logo-mark" aria-hidden="true">H</span>Harbor &amp; Stone</a>
        }
        layout {
            sequence: 10
            slot: logo
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: logo
        }
    )

    region footer-about (
        name: Footer - About
        type: staticContent
        source {
            htmlCode:
                ```
                <a class="ws-Brand" href="f?p=&APP_ID.:HARBOR:&APP_SESSION."><span class="ws-Logo-mark" aria-hidden="true">H</span>Harbor &amp; Stone</a>
                <p>A family-run estate agency since 1989.</p>
                ```
        }
        layout {
            sequence: 10
            slot: footer
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: footer-about
        }
    )

    region social (
        name: Social Media
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Instagram' as label,
                       'https://www.instagram.com/' as link,
                       'fa-instagram' as icon,
                       1 as sort_order
                  from dual
                union all
                select 'LinkedIn' as label,
                       'https://www.linkedin.com/' as link,
                       'fa-linkedin' as icon,
                       2 as sort_order
                  from dual
                union all
                select 'YouTube' as label,
                       'https://www.youtube.com/' as link,
                       'fa-youtube-play' as icon,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 10
            parentRegion: @footer-about
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: social
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-links
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column LABEL (
            layout {
                sequence: 10
            }
        )

        column LINK (
            layout {
                sequence: 20
            }
        )

        column ICON (
            layout {
                sequence: 30
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 40
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region f-homes (
        name: Footer - Homes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'For sale and rent' as label,
                       apex_page.get_url(p_page => 'HARBOR-HOMES') as link,
                       1 as sort_order
                  from dual
                union all
                select 'Services' as label,
                       apex_page.get_url(p_page => 'HARBOR-SERVICES') as link,
                       2 as sort_order
                  from dual
                union all
                select 'Valuations' as label,
                       apex_page.get_url(p_page => 'HARBOR-CONTACT') as link,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: footer
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: f-homes
        }
        headerAndFooter {
            headerText: <h3>Homes</h3>
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-links
            templateOptions: [
                #DEFAULT#
                ws-Links--list
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column LABEL (
            layout {
                sequence: 10
            }
        )

        column LINK (
            layout {
                sequence: 20
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region copyright (
        name: Copyright
        type: staticContent
        source {
            htmlCode: <span>&copy; Harbor &amp; Stone Real Estate</span>
        }
        layout {
            sequence: 10
            slot: footerBottom
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: copyright
        }
    )

    region legal (
        name: Legal Links
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'Privacy' as label,
                       '#' as link,
                       1 as sort_order
                  from dual
                union all
                select 'Terms' as label,
                       '#' as link,
                       2 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: footerBottom
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: legal
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-links
            templateOptions: [
                #DEFAULT#
                ws-Links--inline
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column LABEL (
            layout {
                sequence: 10
            }
        )

        column LINK (
            layout {
                sequence: 20
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 30
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    pageItem P44_NAME (
        type: textField
        label {
            label: Name
            alignment: left
        }
        layout {
            sequence: 10
            region: @contact
            slot: regionBody
            columnSpan: 6
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
    )

    pageItem P44_EMAIL (
        type: textField
        label {
            label: Email
            alignment: left
        }
        settings {
            subtype: email
        }
        layout {
            sequence: 20
            region: @contact
            slot: regionBody
            startNewRow: false
            columnSpan: 6
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
    )

    pageItem P44_PHONE (
        type: textField
        label {
            label: Phone
            alignment: left
        }
        layout {
            sequence: 30
            region: @contact
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        sessionState {
            storage: request
        }
    )

    pageItem P44_MESSAGE (
        type: textarea
        label {
            label: Address of the property
            alignment: left
        }
        layout {
            sequence: 40
            region: @contact
            slot: regionBody
            columnSpan: 12
        }
        appearance {
            template: @/required-floating
            templateOptions: #DEFAULT#
        }
        validation {
            valueRequired: true
        }
        sessionState {
            storage: request
        }
    )

    pageItem P44_WEBSITE (
        type: textField
        label {
            label: Leave this field empty
            alignment: left
        }
        layout {
            sequence: 50
            region: @contact
            slot: regionBody
            columnSpan: 12
            columnCssClasses: ws-Honeypot
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
        advanced {
            customAttributes: tabindex="-1" autocomplete="off"
        }
        sessionState {
            storage: request
        }
    )

    button send (
        buttonName: SEND
        label: Request valuation
        layout {
            sequence: 60
            region: @contact
            slot: regionBody
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: submitPage
        }
    )

    process send-message (
        name: Send Message
        type: executeCode
        source {
            location: localDatabase
            language: plsql
            plsqlCode:
                ```
                -- P44_WEBSITE is a hidden honeypot field: people leave it empty, spam robots fill it in.
                if :P44_WEBSITE is null then
                    -- The starter only says thank you. To receive the message by email, use for example:
                    -- apex_mail.send(p_to   => 'hello@example.com',
                    --                p_from => 'noreply@example.com',
                    --                p_subj => 'Website message from ' || :P44_NAME,
                    --                p_body => :P44_MESSAGE || chr(10) || chr(10) || :P44_NAME || ', ' || :P44_EMAIL || ', ' || :P44_PHONE);
                    -- apex_mail.push_queue;
                    null;
                end if;
                ```
        }
        execution {
            sequence: 10
            point: processing
        }
        successMessage {
            successMessage: Thank you. An agent will call you today to arrange a visit.
        }
        serverSideCondition {
            whenButtonPressed: @send
        }
    )

    branch back-to-website (
        name: Back to the Website
        execution {
            sequence: 10
            point: afterProcessing
        }
        behavior {
            type: pageOrUrl
            target: {
                page: 44
            }
        }
    )

)
