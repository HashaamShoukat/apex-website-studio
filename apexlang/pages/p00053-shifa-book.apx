                       'عيادات الشفاء' as title,
                       'طريق الملك عبدالعزيز، حي الياسمين، الرياض' as address,
                       'بجوار مسجد الياسمين.' as text,
                       'https://www.openstreetmap.org/' as link,
                       'الاتجاهات' as link_label,
                       1 as sort_order
                  from dual
                order by sort_order
