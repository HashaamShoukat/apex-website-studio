    region f-clinic (
        name: Footer - العيادة
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'الخدمات' as label,
                       apex_page.get_url(p_page => 'SHIFA-SERVICES') as link,
                       1 as sort_order
                  from dual
                union all
                select 'الأطباء' as label,
                       apex_page.get_url(p_page => 'SHIFA-ABOUT') || '#doctors' as link,
                       2 as sort_order
                  from dual
                union all
                select 'أوقات العمل' as label,
                       apex_page.get_url(p_page => 'SHIFA-BOOK') || '#hours' as link,
                       3 as sort_order
                  from dual
                order by sort_order
