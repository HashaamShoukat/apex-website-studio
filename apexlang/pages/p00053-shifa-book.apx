page 53 (
    name: عيادات الشفاء - Book
    alias: SHIFA-BOOK
    title: احجز موعدا - عيادات الشفاء
    appearance {
        pageTemplate: @modern-one-page
        templateOptions: [
            #DEFAULT#
            ws-Accent--emerald
            ws-Font--arabic
            ws-Corners--round
            ws-Fx--chat
            ws-Fx--theme
        ]
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    htmlHeader {
        htmlHeader:
            ```html
            <script>document.documentElement.setAttribute("dir","rtl");document.documentElement.setAttribute("lang","ar");document.addEventListener("DOMContentLoaded",function(){document.body.setAttribute("dir","rtl");});</script>
            <meta name="description" content="احجز موعدك في عيادات الشفاء، واطلع على أوقات العمل والموقع.">
            <meta property="og:type" content="website">
            <meta property="og:title" content="احجز موعدا - عيادات الشفاء">
            <meta property="og:description" content="احجز موعدك في عيادات الشفاء، واطلع على أوقات العمل والموقع.">
            <meta property="og:image" content="#APP_FILES#website-studio/img/clinic-hero.jpg">
            <meta name="twitter:card" content="summary_large_image">
            <link rel="preload" as="image" href="#APP_FILES#website-studio/img/clinic-hero.jpg" fetchpriority="high">
            ```
    }
    security {
        authentication: public
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region hero (
        name: احجز موعدك
        title: احجز *موعدك*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'احجز *موعدك*' as title,
                       'الحجز' as subtitle,
                       'اترك بياناتك وسنتصل بك لتأكيد الموعد.' as text,
                       'website-studio/img/clinic-hero.jpg' as image_file,
                       'طبيب بمعطف أبيض' as image_alt,
                       1 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 20
            slot: hero
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Pad--none
                ws-Width--full
                ws-Head--hidden
            ]
        }
        advanced {
            htmlDomId: hero
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-hero
            templateOptions: [
                #DEFAULT#
                ws-Hero--zoom
                ws-Hero--fullbleed
                ws-Hero--compact
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column TITLE (
            layout {
                sequence: 10
            }
        )

        column SUBTITLE (
            layout {
                sequence: 20
            }
        )

        column TEXT (
            layout {
                sequence: 30
            }
        )

        column IMAGE_FILE (
            layout {
                sequence: 40
            }
        )

        column IMAGE_ALT (
            layout {
                sequence: 50
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 60
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region contact (
        name: احجز
        title: احجز *موعدك*
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Head--hidden
            ]
            cssClasses: ws-Contact
        }
        advanced {
            htmlDomId: contact
            customAttributes: data-menu="احجز"
        }
        headerAndFooter {
            headerText: <p class="ws-Lead">اترك بياناتك وسنتصل بك لتأكيد الموعد.</p>
        }
    )

    region contact-details (
        name: Contact Details
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'fa-phone' as icon,
                       'الهاتف' as label,
                       '٩٢٠٠٠٠٠٠٠' as value,
                       'tel:920000000' as link,
                       1 as sort_order
                  from dual
                union all
                select 'fa-whatsapp' as icon,
                       'واتساب' as label,
                       '+966 50 000 0000' as value,
                       'https://wa.me/966500000000' as link,
                       2 as sort_order
                  from dual
                union all
                select 'fa-map-marker' as icon,
                       'العنوان' as label,
                       'حي الياسمين، الرياض' as value,
                       null as link,
                       3 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 10
            parentRegion: @contact
            slot: subRegions
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: contact-details
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-contact
            templateOptions: [
                #DEFAULT#
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column ICON (
            layout {
                sequence: 10
            }
        )

        column LABEL (
            layout {
                sequence: 20
            }
        )

        column VALUE (
            layout {
                sequence: 30
            }
        )

        column LINK (
            layout {
                sequence: 40
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 50
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region hours (
        name: أوقات العمل
        title: أوقات *العمل*
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```
                select 'الأحد' as day_name,
                       '٨:٠٠ ص - ١١:٠٠ م' as hours,
                       null as note,
                       '7' as day_number,
                       1 as sort_order
                  from dual
                union all
                select 'الاثنين' as day_name,
                       '٨:٠٠ ص - ١١:٠٠ م' as hours,
                       null as note,
                       '1' as day_number,
                       2 as sort_order
                  from dual
                union all
                select 'الثلاثاء' as day_name,
                       '٨:٠٠ ص - ١١:٠٠ م' as hours,
                       null as note,
                       '2' as day_number,
                       3 as sort_order
                  from dual
                union all
                select 'الأربعاء' as day_name,
                       '٨:٠٠ ص - ١١:٠٠ م' as hours,
                       null as note,
                       '3' as day_number,
                       4 as sort_order
                  from dual
                union all
                select 'الخميس' as day_name,
                       '٨:٠٠ ص - ١١:٠٠ م' as hours,
                       'حتى منتصف الليل للطوارئ' as note,
                       '4' as day_number,
                       5 as sort_order
                  from dual
                union all
                select 'الجمعة' as day_name,
                       'مغلق' as hours,
                       null as note,
                       '5' as day_number,
                       6 as sort_order
                  from dual
                union all
                select 'السبت' as day_name,
                       '٤:٠٠ م - ١١:٠٠ م' as hours,
                       null as note,
                       '6' as day_number,
                       7 as sort_order
                  from dual
                order by sort_order
                ```
        }
        layout {
            sequence: 40
            slot: body
        }
        appearance {
            template: @modern-section
            templateOptions: [
                ws-Sec--menu
                ws-Tone--soft
                ws-Head--center
            ]
        }
        advanced {
            htmlDomId: hours
            customAttributes: data-menu="أوقات العمل"
        }
        reportLayout {
            numberOfRowsType: staticValue
            numberOfRows: 100
        }
        componentAppearance {
            templateType: theme
            template: @ws-hours
            templateOptions: [
                #DEFAULT#
                ws-Hours--cards
            ]
        }
        messages {
            whenNoDataFound: Nothing to show yet.
        }

        column DAY_NAME (
            layout {
                sequence: 10
            }
        )

        column HOURS (
            layout {
                sequence: 20
            }
        )

        column NOTE (
            layout {
                sequence: 30
            }
        )

        column DAY_NUMBER (
            layout {
                sequence: 40
            }
        )

        column SORT_ORDER (
            layout {
                sequence: 50
            }
            sorting {
                defaultSequence: 1
            }
        )
    )

    region map (
        name: موقعنا
