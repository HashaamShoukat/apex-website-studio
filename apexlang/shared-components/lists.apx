list restaurant-menu (
    name: Osteria Lume - Menu
    source {
        type: sqlQuery
        sqlQuery:
            ```
            with menu_entries as (
                select 1 as id, null as parent_id, 'Menu' as label, '#menu' as target, null as link_target, 10 as seq from dual
                union all
                select 2 as id, 1 as parent_id, 'Starters' as label, '#menu' as target, null as link_target, 10 as seq from dual
                union all
                select 3 as id, 1 as parent_id, 'Mains' as label, '#menu' as target, null as link_target, 20 as seq from dual
                union all
                select 4 as id, 1 as parent_id, 'Desserts' as label, '#menu' as target, null as link_target, 30 as seq from dual
                union all
                select 5 as id, null as parent_id, 'Our story' as label, '#story' as target, null as link_target, 20 as seq from dual
                union all
                select 6 as id, null as parent_id, 'Gallery' as label, '#gallery' as target, null as link_target, 30 as seq from dual
                union all
                select 7 as id, null as parent_id, 'Evenings' as label, '#evenings' as target, null as link_target, 40 as seq from dual
                union all
                select 8 as id, null as parent_id, 'Visit' as label, '#visit' as target, null as link_target, 50 as seq from dual
                union all
                select 9 as id, null as parent_id, 'Order online' as label, 'https://example.com/order' as target, '_blank' as link_target, 60 as seq from dual
                union all
                select 10 as id, null as parent_id, 'Book a table' as label, '#contact' as target, null as link_target, 70 as seq from dual
            )
            select level,
                   label,
                   target,
                   null as is_current,
                   null as image,
                   null as image_attribute,
                   null as image_alt,
                   null as attribute1,
                   link_target as attribute2
              from menu_entries
             start with parent_id is null
            connect by prior id = parent_id
             order siblings by seq
            ```
    }
)

