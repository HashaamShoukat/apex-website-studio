classicReportTemplate ws-banner (
    name: Website - Banner
    templateClass: custom1
    type: namedColumn
    reportTemplate {
        top: <div class="ws-R ws-Banners #COMPONENT_CSS_CLASSES#" id="report_#DOM_ID#" data-region-id="#DOM_ID#">
        bottom: </div>
    }
    rowTemplate1 {
        template:
            ```html
            <div class="ws-Banner">
              <div class="ws-Banner-img ws-Media" data-img="#IMAGE_URL#" data-file="#IMAGE_FILE#" data-pos="#IMAGE_POSITION#" data-alt="#IMAGE_ALT#" role="img" aria-label="#TITLE#"></div>
              <div class="ws-Banner-b"><p class="ws-Eyebrow" data-opt="text">#EYEBROW#</p><h3 class="ws-Banner-t">#TITLE#</h3><p class="ws-Banner-x" data-opt="text">#TEXT#</p></div>
              <div class="ws-Actions"><a class="ws-Btn" href="#BUTTON_LINK#">#BUTTON_LABEL#</a><a class="ws-Btn ws-Btn--ghost" href="#BUTTON2_LINK#">#BUTTON2_LABEL#</a></div>
            </div>
            ```
    }
    pagination {
        template: <span class="t-Report-paginationText">#TEXT#</span>
        nextPage: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--next">#PAGINATION_NEXT#</a>
        previousPage: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--prev">#PAGINATION_PREVIOUS#</a>
        nextSet: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--next">#PAGINATION_NEXT_SET#</a>
        previousSet: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--prev">#PAGINATION_PREVIOUS_SET#</a>
    }
    comments {
        comments: Website - Banner (Website Studio). A call to action: a coloured band with a headline and one or two buttons. With Image Background the row's picture fills the band. Columns (all optional): EYEBROW, TITLE, TEXT, IMAGE_URL, IMAGE_FILE, IMAGE_ALT, IMAGE_POSITION, BUTTON_LABEL, BUTTON_LINK, BUTTON2_LABEL, BUTTON2_LINK.
    }

    templateOption banners-dark (
        name: Dark
        group: @report/wsr-banner-style
        sequence: 10
        appearance {
            cssClasses: ws-Banners--dark
        }
    )

    templateOption banners-image (
        name: Image Background
        group: @report/wsr-banner-style
        sequence: 20
        appearance {
            cssClasses: ws-Banners--image
        }
    )

    templateOption banners-outline (
        name: Outline
        group: @report/wsr-banner-style
        sequence: 30
        appearance {
            cssClasses: ws-Banners--outline
        }
    )

    templateOption banners-center (
        name: Centered
        group: @report/wsr-banner-layout
        sequence: 10
        appearance {
            cssClasses: ws-Banners--center
        }
    )
)
