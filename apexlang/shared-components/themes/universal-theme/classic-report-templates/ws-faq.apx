classicReportTemplate ws-faq (
    name: Website - FAQ
    templateClass: custom1
    type: namedColumn
    reportTemplate {
        top: <div class="ws-R ws-Faqs #COMPONENT_CSS_CLASSES#" id="report_#DOM_ID#" data-region-id="#DOM_ID#">
        bottom: </div>
    }
    rowTemplate1 {
        template: <details class="ws-Faq"><summary>#QUESTION#<span class="ws-Plus" aria-hidden="true"></span></summary><div class="ws-Faq-a">#ANSWER#</div></details>
    }
    pagination {
        template: <span class="t-Report-paginationText">#TEXT#</span>
        nextPage: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--next">#PAGINATION_NEXT#</a>
        previousPage: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--prev">#PAGINATION_PREVIOUS#</a>
        nextSet: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--next">#PAGINATION_NEXT_SET#</a>
        previousSet: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--prev">#PAGINATION_PREVIOUS_SET#</a>
    }
    comments {
        comments: Website - FAQ (Website Studio). Questions that open to show the answer. Search engines get them as structured data (FAQPage). Columns (all optional): QUESTION, ANSWER.
    }

    templateOption faqs-columns (
        name: Two Columns
        group: @report/wsr-faq-layout
        sequence: 10
        appearance {
            cssClasses: ws-Faqs--columns
        }
    )

    templateOption faqs-search (
        name: Search Box
        sequence: 10
        appearance {
            cssClasses: ws-Faqs--search
        }
        help {
            helpText: A search field above the questions; only the questions with the words typed stay visible.
        }
    )
)
