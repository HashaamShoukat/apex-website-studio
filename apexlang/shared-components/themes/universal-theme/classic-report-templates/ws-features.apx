classicReportTemplate ws-features (
    name: Website - Services
    templateClass: custom1
    type: namedColumn
    reportTemplate {
        top: <div class="ws-R ws-Features #COMPONENT_CSS_CLASSES#" id="report_#DOM_ID#" data-region-id="#DOM_ID#">
        bottom: </div>
    }
    rowTemplate1 {
        template:
            ```html
            <article class="ws-Card ws-Feature">
              <span class="ws-Icon fa #ICON#" data-icon="fa-star-o" aria-hidden="true"></span>
              <h3>#TITLE#</h3>
              <p data-opt="text">#TEXT#</p>
              <a class="ws-More" href="#LINK#">#LINK_LABEL#</a>
            </article>
            ```
    }
    pagination {
        template: <span class="t-Report-paginationText">#TEXT#</span>
        nextPage: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--next">#PAGINATION_NEXT#</a>
        previousPage: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--prev">#PAGINATION_PREVIOUS#</a>
        nextSet: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--next">#PAGINATION_NEXT_SET#</a>
        previousSet: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--prev">#PAGINATION_PREVIOUS_SET#</a>
    }
    comments {
        comments: Website - Services (Website Studio). Services, features or benefits. ICON is a Font APEX class such as fa-lightbulb-o. Columns (all optional): ICON, TITLE, TEXT, LINK, LINK_LABEL.
    }

    templateOption features-rows (
        name: Rows
        group: @report/wsr-features-layout
        sequence: 10
        appearance {
            cssClasses: ws-Features--rows
        }
    )

    templateOption features-bento (
        name: Bento
        group: @report/wsr-features-layout
        sequence: 20
        appearance {
            cssClasses: ws-Features--bento
        }
    )

    templateOption features-icons (
        name: Icons Only
        group: @report/wsr-features-layout
        sequence: 30
        appearance {
            cssClasses: ws-Features--icons
        }
    )

    templateOption cols-2 (
        name: 2
        group: @report/wsr-columns
        sequence: 10
        appearance {
            cssClasses: ws-Cols--2
        }
    )

    templateOption cols-4 (
        name: 4
        group: @report/wsr-columns
        sequence: 20
        appearance {
            cssClasses: ws-Cols--4
        }
    )
)
