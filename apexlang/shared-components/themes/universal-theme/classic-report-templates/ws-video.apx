classicReportTemplate ws-video (
    name: Website - Video
    templateClass: custom1
    type: namedColumn
    reportTemplate {
        top: <div class="ws-R ws-Videos #COMPONENT_CSS_CLASSES#" id="report_#DOM_ID#" data-region-id="#DOM_ID#">
        bottom: </div>
    }
    rowTemplate1 {
        template:
            ```html
            <figure class="ws-Video" data-video="#VIDEO_URL#">
              <button type="button" class="ws-Video-play" aria-label="#TITLE#"><div class="ws-Video-img ws-Media" data-img="#IMAGE_URL#" data-file="#IMAGE_FILE#" data-pos="#IMAGE_POSITION#" data-alt="#IMAGE_ALT#" role="img" aria-label="#TITLE#"></div><span class="ws-Video-icon" aria-hidden="true"></span></button>
              <figcaption><b data-opt="text">#TITLE#</b><span class="ws-Muted" data-opt="text">#TEXT#</span></figcaption>
            </figure>
            ```
    }
    pagination {
        template: <span class="t-Report-paginationText">#TEXT#</span>
        nextPage: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--next">#PAGINATION_NEXT#</a>
        previousPage: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--prev">#PAGINATION_PREVIOUS#</a>
        nextSet: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--next">#PAGINATION_NEXT_SET#</a>
        previousSet: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--prev">#PAGINATION_PREVIOUS_SET#</a>
    }
    comments {
        comments: Website - Video (Website Studio). Videos from YouTube, Vimeo or an .mp4 file. Nothing loads until the visitor presses play; the image is the cover. Columns (all optional): VIDEO_URL, TITLE, TEXT, IMAGE_URL, IMAGE_FILE, IMAGE_ALT, IMAGE_POSITION.
    }

    templateOption videos-cards (
        name: Cards
        group: @report/wsr-video-layout
        sequence: 10
        appearance {
            cssClasses: ws-Videos--cards
        }
    )
)
