classicReportTemplate ws-zigzag (
    name: Website - Image and Text
    templateClass: custom1
    type: namedColumn
    reportTemplate {
        top: <div class="ws-R ws-Zigzag #COMPONENT_CSS_CLASSES#" id="report_#DOM_ID#" data-region-id="#DOM_ID#">
        bottom: </div>
    }
    rowTemplate1 {
        template:
            ```html
            <div class="ws-Zig">
              <div class="ws-Zig-img ws-Media" data-img="#IMAGE_URL#" data-file="#IMAGE_FILE#" data-pos="#IMAGE_POSITION#" data-alt="#IMAGE_ALT#" role="img" aria-label="#TITLE#"></div>
              <div class="ws-Zig-b"><p class="ws-Eyebrow" data-opt="text">#EYEBROW#</p><h3 class="ws-Zig-t">#TITLE#</h3><p class="ws-Muted" data-opt="text">#TEXT#</p><a class="ws-More" href="#LINK#">#LINK_LABEL#</a></div>
            </div>
            ```
    }
    pagination {
        template: <span class="t-Report-paginationText">#TEXT#</span>
        nextPage: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--next">#PAGINATION_NEXT#</a>
        previousPage: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--prev">#PAGINATION_PREVIOUS#</a>
        nextSet: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--next">#PAGINATION_NEXT_SET#</a>
        previousSet: <a href="#LINK#" class="t-Button t-Button--small t-Button--noUI t-Report-paginationLink t-Report-paginationLink--prev">#PAGINATION_PREVIOUS_SET#</a>
    }
    comments {
        comments: Website - Image and Text (Website Studio). Rows of a picture next to text, alternating sides (zig-zag). Columns (all optional): EYEBROW, TITLE, TEXT, IMAGE_URL, IMAGE_FILE, IMAGE_ALT, IMAGE_POSITION, LINK, LINK_LABEL.
    }

    templateOption zigzag-text (
        name: Text First
        group: @report/wsr-zigzag-start
        sequence: 10
        appearance {
            cssClasses: ws-Zigzag--text
        }
    )
)
