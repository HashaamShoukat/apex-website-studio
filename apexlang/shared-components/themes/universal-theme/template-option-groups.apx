templateOptionGroup ws-design (
    templateType: page
    name: Design
    sequence: 5
    settings {
        nullText: Clean
    }
    help {
        helpText: The overall look of the website. Accent Color, Color Scheme, Typeface and Corners still change it.
    }
)

templateOptionGroup ws-accent (
    templateType: page
    name: Accent Color
    sequence: 10
    settings {
        nullText: Theme Color
    }
    help {
        helpText: Buttons, highlights and icons. Theme Color uses your theme style's primary colour (some designs bring their own colour instead).
    }
)

templateOptionGroup ws-scheme (
    templateType: page
    name: Color Scheme
    sequence: 20
    settings {
        nullText: Light
    }
    help {
        helpText: Midnight, Tech Grid, Aurora and Blueprint are always dark. Sections set to Dark or Accent keep their own colours.
    }
)

templateOptionGroup ws-font (
    templateType: page
    name: Typeface
    sequence: 30
    settings {
        nullText: System
    }
    help {
        helpText: Headline and text fonts. Every choice except System loads its fonts from Google Fonts. The Arabic typefaces suit right-to-left websites.
    }
)

templateOptionGroup ws-header (
    templateType: page
    name: Header
    sequence: 40
    settings {
        nullText: Classic
    }
    help {
        helpText: Transparent lays the header over the first section (use it with a Slider or Full Bleed hero); it turns solid when the visitor scrolls.
    }
)

templateOptionGroup ws-corners (
    templateType: page
    name: Corners
    sequence: 50
    settings {
        nullText: Rounded
    }
)

templateOptionGroup ws-space (
    templateType: page
    name: Section Spacing
    sequence: 60
    settings {
        nullText: Comfortable
    }
)

templateOptionGroup ws-footer (
    templateType: page
    name: Footer
    sequence: 70
    settings {
        nullText: Dark
    }
)

templateOptionGroup ws-ph (
    templateType: page
    name: Placeholder Images
    sequence: 80
    settings {
        nullText: Soft Gradient
    }
    help {
        helpText: What a row without an image shows (IMAGE_URL and IMAGE_FILE empty). People always show their initials.
    }
)

templateOptionGroup ws-revstyle (
    templateType: page
    name: Reveal Style
    sequence: 90
    settings {
        nullText: Rise
    }
    help {
        helpText: How sections come into view with Reveal on Scroll.
    }
)

templateOptionGroup ws-tone (
    templateType: region
    name: Background
    sequence: 10
    settings {
        nullText: Page
    }
    help {
        helpText: Soft is a slightly tinted band, Dark and Accent invert the colours, Gradient runs between the two accent colours.
    }
)

templateOptionGroup ws-pad (
    templateType: region
    name: Spacing
    sequence: 20
    settings {
        nullText: Normal
    }
    help {
        helpText: None removes the top and bottom space, for a hero or a full-width band.
    }
)

templateOptionGroup ws-head (
    templateType: region
    name: Heading
    sequence: 30
    settings {
        nullText: Left
    }
    help {
        helpText: The region title is the section heading. Put <p class="ws-Eyebrow">...</p> and <p class="ws-Lead">...</p> at the start of the region's Header text for a small label above and an intro below it.
    }
)

templateOptionGroup ws-width (
    templateType: region
    name: Width
    sequence: 40
    settings {
        nullText: Normal
    }
)

templateOptionGroup ws-edge (
    templateType: region
    name: Top Edge
    sequence: 50
    settings {
        nullText: Straight
    }
    help {
        helpText: The shape of the section's top edge, drawn over the section before it. Use it on a section with a Background.
    }
)

templateOptionGroup wsr-hero-layout (
    templateType: report
    name: Layout
    sequence: 160
    settings {
        nullText: Slider
    }
    help {
        helpText: Slider and Full Bleed put the text over the image; Split and Centered put it next to or above it.
    }
)

templateOptionGroup wsr-hero-height (
    templateType: report
